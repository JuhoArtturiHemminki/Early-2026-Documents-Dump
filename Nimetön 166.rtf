\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
\
class TeslaProductionOptimizer_V3_0_FINAL \{\
private:\
    const float VEHICLE_M   = 1850.0f;\
    const float TIRE_R      = 0.330f;\
    const float G_ACCEL     = 9.81f;\
    const float Kp          = 0.85f; \
    const float Ki          = 0.15f;\
    const float I_LIMIT     = 5.0f;\
    const float EPSILON     = 0.0001f;\
    float error_integral    = 0.0f;\
\
public:\
    struct ActuationOutput \{\
        float motor_torque_nm;\
        float brake_force_n;\
        bool abs_active;\
    \};\
\
    ActuationOutput execute_enhanced_cycle(\
        float req_decel, \
        float raw_v, \
        float t_cell, \
        float current_soc, \
        float pitch_rad, \
        float wheel_slip\
    ) \{\
        if (raw_v < 0.1f || req_decel <= 0.0f) \{\
            error_integral = 0.0f;\
        \}\
\
        float gravity_force = VEHICLE_M * G_ACCEL * std::sin(pitch_rad);\
        float aero_force = 0.5f * 1.225f * std::pow(raw_v, 2) * 0.23f * 2.22f;\
        float natural_decel = (aero_force + gravity_force) / VEHICLE_M;\
\
        float thermal_map = 1.0f / (1.0f + std::exp(-0.25f * (t_cell - 12.0f)));\
        float kw_limit = 165.0f * thermal_map * std::clamp((98.0f - current_soc) / 10.0f, 0.0f, 1.0f);\
\
        float target_net_decel = std::max(0.0f, req_decel - natural_decel);\
        \
        error_integral += target_net_decel * 0.001f;\
        error_integral = std::clamp(error_integral, -I_LIMIT, I_LIMIT);\
        \
        float smooth_target = (target_net_decel * Kp) + (error_integral * Ki);\
\
        float safety_factor = 1.0f;\
        bool abs_trigger = false;\
        if (wheel_slip > 0.15f) \{ \
            safety_factor = 0.0f;  \
            abs_trigger = true;\
            error_integral *= 0.5f; \
        \}\
\
        float angular_v = std::max(1.0f, (raw_v / TIRE_R) + EPSILON);\
        float max_torque_nm = (kw_limit * 1000.0f) / angular_v;\
        \
        float final_regen_nm = std::min(smooth_target * VEHICLE_M * TIRE_R, max_torque_nm) * safety_factor;\
        float friction_needed = std::max(0.0f, (target_net_decel * VEHICLE_M) - (final_regen_nm / TIRE_R));\
\
        return \{ final_regen_nm, friction_needed, abs_trigger \};\
    \}\
\};\
}