        // This handles any remaining 1-255 bytes at the end of the chunk.\
        let mut tail_offset = full_blocks * block_size;\
        while tail_offset < size \{\
            let rem = size - tail_offset;\
            if rem >= 64 \{\
                let c = _mm512_xor_si512(_mm512_loadu_si512(chunk_ptr.add(tail_offset) as *const i8), mask_val);\
                _mm512_storeu_si512(chunk_ptr.add(tail_offset) as *mut i8, c);\
                tail_offset += 64;\
            \} else \{\
                // FIXED: Overflow-safe mask generation (rem is 0..63)\
                let k_mask = if rem == 0 \{ 0u64 \} else \{ (1u64 << rem) - 1 \};\
                \
                let c = _mm512_maskz_loadu_epi8(k_mask, chunk_ptr.add(tail_offset) as *const i8);\
                let xored = _mm512_xor_si512(c, mask_val);\
                _mm512_mask_storeu_epi8(chunk_ptr.add(tail_offset) as *mut i8, k_mask, xored);\
                break;\
            \}\
        \}\
        \
        // Critical: Ensure non-temporal writes are visible to other threads.\
        _mm_sfence();\
    \}\
\}\
