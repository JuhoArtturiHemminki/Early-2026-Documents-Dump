        // Using aligned loads (_mm512_load_si512) for peak performance.\
        for _ in 0..full_blocks \{\
            let c0 = _mm512_xor_si512(_mm512_load_si512(data_ptr.add(0) as *const i8), mask_val);\
            let c1 = _mm512_xor_si512(_mm512_load_si512(data_ptr.add(1) as *const i8), mask_val);\
            let c2 = _mm512_xor_si512(_mm512_load_si512(data_ptr.add(2) as *const i8), mask_val);\
            let c3 = _mm512_xor_si512(_mm512_load_si512(data_ptr.add(3) as *const i8), mask_val);\
\
            // Stream writes bypass the cache to save memory bandwidth.\
            _mm512_stream_si512(data_ptr.add(0) as *mut i8, c0);\
            _mm512_stream_si512(data_ptr.add(1) as *mut i8, c1);\
            _mm512_stream_si512(data_ptr.add(2) as *mut i8, c2);\
            _mm512_stream_si512(data_ptr.add(3) as *mut i8, c3);\
            \
            data_ptr = data_ptr.add(4);\
