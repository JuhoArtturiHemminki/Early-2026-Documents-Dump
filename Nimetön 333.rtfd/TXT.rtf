\f2\fs26 \cf0 `timescale 1ps / 1ps\
\
module gcp_v2_engine (\
    input  wire         clk_pcie,\
    input  wire         rst_n,\
    input  wire [511:0] s_axis_data,\
    input  wire [511:0] k_anchor,\
    input  wire [5:0]   topo_delta,\
    output reg  [511:0] m_axis_data,\
    output reg  [63:0]  w_mask,\
    output reg          r_lock\
);\
\
    reg  [511:0] r_state;\
    wire [511:0] w_xor;\
    wire [511:0] w_rot;\
    reg  [3:0]   v_pop [63:0];\
    integer i;\
\
    assign w_xor = s_axis_data ^ k_anchor;\
    assign w_rot = (w_xor << topo_delta) | (w_xor >> (512 - topo_delta));\
\
    always @(posedge clk_pcie or negedge rst_n) begin\
        if (!rst_n) begin\
            r_state     <= 512'b0;\
            m_axis_data <= 512'b0;\
            w_mask      <= 64'b0;\
            r_lock      <= 1'b0;\
        end else begin\
            for (i = 0; i < 64; i = i + 1) begin\
                v_pop[i] = w_rot[i*8+0] + w_rot[i*8+1] + w_rot[i*8+2] + w_rot[i*8+3] + \
                           w_rot[i*8+4] + w_rot[i*8+5] + w_rot[i*8+6] + w_rot[i*8+7];\
\
                if (v_pop[i] > 4'd4) begin\
                    w_mask[i] <= 1'b0;\
                    r_state[i*8 +: 8] <= 8'h00; \
                end else begin\
                    w_mask[i] <= 1'b1;\
                    r_state[i*8 +: 8] <= w_rot[i*8 +: 8];\
                end\
            end\
\
            if (r_state == w_rot) begin\
                r_lock      <= 1'b1;\
                m_axis_data <= r_state;\
            end else begin\
                r_lock      <= 1'b0;\
                m_axis_data <= \{64\{8'hFF\}\};\
            end\
        end\
    end\
endmodule\
\pard\pardeftab720\partightenfactor0

