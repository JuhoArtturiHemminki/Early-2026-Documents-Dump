\f2\fs26 \cf0 import os\
import sys\
import time\
\
def run_resonation(data_in):\
    h2c_path = "/dev/xdma0_h2c_0"\
    c2h_path = "/dev/xdma0_c2h_0"\
    \
    if not os.path.exists(h2c_path):\
        print("XDMA-laitetta ei loydy.")\
        sys.exit(1)\
\
    try:\
        f_in = os.open(h2c_path, os.O_WRONLY)\
        f_out = os.open(c2h_path, os.O_RDONLY)\
        \
        os.write(f_in, data_in)\
        result = os.read(f_out, 64)\
        \
        os.close(f_in)\
        os.close(f_out)\
        return result\
    except Exception as e:\
        return str(e)\
\
if __name__ == "__main__":\
    test_payload = os.urandom(64)\
    print(f"Input:  \{test_payload.hex()\}")\
    \
    res_output = run_resonation(test_payload)\
    \
    print(f"Output: \{res_output.hex()\}")\
\pard\pardeftab720\partightenfactor0

