    \}\
\
    inline bool IsCoreIntact() const \{\
        static const uint32_t INIT_CHK = GetMapIntegrity();\
        return (m_stack_guard == ECU_Config::STACK_MAGIC) && \
               (ECU_Config::SW_CERT_ID == 0x554C54494D415445ULL) &&\
               (GetMapIntegrity() == INIT_CHK);\
    \}\
