    inline uint32_t GetMapIntegrity() const \{\
        uint32_t chk = 0;\
        for(int i=0; i<5; ++i) \{\
            chk ^= (uint32_t)ECU_Config::ECO_MAP[i] ^ (uint32_t)ECU_Config::RACE_MAP[i];\
