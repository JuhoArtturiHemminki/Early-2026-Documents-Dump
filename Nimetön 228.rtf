        torque_limit_factor = static_cast<int32_t>((static_cast<int64_t>(torque_limit_factor) * baro_factor) >> ECU_Config::FP_SHIFT);\
        out.altitude_derate_pct = (baro_factor * 100) >> ECU_Config::FP_SHIFT;\
