    int32_t m_aggression = 0;\
    int32_t m_adaptive_trim = 0;\
    int32_t m_prev_final_tq = 0;\
    int32_t m_resonance_buffer = 0;\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
    uint8_t m_fault_counter = 0;\
    uint64_t m_cycle_count = 0;\
