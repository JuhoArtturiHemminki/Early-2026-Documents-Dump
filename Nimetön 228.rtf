        Output out = \{0, 0, 0, 0, false, false, false, false, 0, 0, false, 100\};\
        m_cycle_count++;\
        \
        // 1. ASIL-D Timing Violation Check\
        if (dt_ms > 25) \{\
            out.fault = true;\
            out.timing_violation = true;\
            m_fault_counter = ECU_Config::MAX_FAULT_CYCLES;\
            return out;\
