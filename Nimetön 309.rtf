\f0\fs24 \cf0 /* \
 * PROJECT: \uc0\u936 -MATRIX (V.5.1.0-ULTIMATE-SYMMETRY)\
 * FEATURE: SIMD Convergent Rounding & Memory Alignment.\
 */\
\
#[repr(align(16))]\
pub struct AlignedData([i32; 4]);\
\
impl FixedQ16 \{\
    /// Convergent Rounding (Round Half to Even) SIMD-toteutus.\
    /// Poistaa pienen tilastollisen biaksen t\'e4sm\'e4lleen .5 kohdalla.\
    #[inline(always)]\
    pub fn mul_convergent_simd(lhs: i32x4, rhs: i32x4) -> i32x4 \{\
        let product = i64x4::from_cast(lhs) * i64x4::from_cast(rhs);\
        \
        let half = i64x4::splat(1 << 15);\
        let mask_half = i64x4::splat((1 << 16) - 1);\
        let zero = i64x4::splat(0);\
\
        // Tarkistetaan onko murto-osa t\'e4sm\'e4lleen 0.5 (1 << 15)\
        // (product & mask_half) == half\
        let is_exactly_half = (product & mask_half).simd_eq(half);\
        \
        // Perinteinen symmetrinen offset\
        let is_positive = product.simd_gt(zero);\
        let is_negative = product.simd_lt(zero);\
        let standard_offset = is_positive.select(half, is_negative.select(-half, zero));\
\
        // Jos ollaan t\'e4sm\'e4lleen .5 kohdalla, py\'f6ristet\'e4\'e4n parilliseen:\
        // Jos (tulos_ennen_py\'f6ristyst\'e4) on pariton, lis\'e4t\'e4\'e4n offset. Jos parillinen, ei lis\'e4t\'e4.\
        // T\'e4ss\'e4 yksinkertaistettu SIMD-logiikka:\
        let res_truncated = product >> 16;\
        let is_result_odd = (res_truncated & i64x4::splat(1)).simd_ne(zero);\
        \
        // P\'e4\'e4t\'f6s: K\'e4ytet\'e4\'e4nk\'f6 standardi-offsetia vai nollaa (parillisuuss\'e4\'e4nt\'f6)\
        let final_offset = is_exactly_half.select(\
            is_result_odd.select(standard_offset, zero), \
            standard_offset\
        );\
\
        let res_64 = (product + final_offset) >> 16;\
\
        // ASIL-D Saturaatio\
        let saturated = res_64.simd_min(i64x4::splat(i32::MAX as i64))\
                             .simd_max(i64x4::splat(i32::MIN as i64));\
        \
        i32x4::from_cast(saturated)\
    \}\
\}\
}