def update_ssod_v10_core(phase_currents, voltage_v, target_torque, ground_speed, imu_accel_z, tire_temp, car_mass, confidence):\
    t_feedback = (phase_currents * voltage_v) * 0.98\
    torque_jitter = abs(t_feedback - target_torque) * 0.01\
\
    fz = (car_mass * 9.81) + (imu_accel_z * car_mass)\
    sigma_t = 0.000085 * (tire_temp - 20.0)\
    r_dyn = R_NOMINAL - (fz / K_TYRE) + (sigma_t * R_NOMINAL)\
\
    w_ref = ground_speed / r_dyn\
\
    if torque_jitter < 0.12 and confidence > 0.95:\
        target_w = w_ref * 1.025\
    else:\
        target_w = w_ref\
\
    if abs(torque_jitter) > 0.5:\
        trigger_guardian_fallback()\
        \
    return target_w\
\
}