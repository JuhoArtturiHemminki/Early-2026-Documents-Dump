    /// --- 4. EVOLUTIONARY LEARNING (V2-V21.7) ---\
    pub fn learn(&self, subject: &str, info: &str) \{\
        let key = subject.to_lowercase();\
        let fact = Fact \{\
            content: info.to_string(),\
            confidence: 0.85,\
            source_reliability: 0.90,\
            risk_level: 0.1,\
            timestamp: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs(),\
        \};\
\
        // Update Bloom Gate\
        \{\
            let mut filter = self.bloom_filter.write().unwrap();\
            filter.set(&key);\
        \}\
\
        // Update Memory & Persistent Storage (Zstd)\
        \{\
            let mut cache = self.lru_cache.write().unwrap();\
            cache.put(key.clone(), fact.clone());\
        \}\
\
        let serialized = serde_json::to_vec(&fact).unwrap();\
        let compressed = encode_all(&serialized[..], 3).unwrap(); // Zstd Balanced Compression\
        \
        let db = self.db_conn.write().unwrap();\
        let _ = db.execute(\
            "INSERT OR REPLACE INTO neural_vault (subject, data) VALUES (?1, ?2)",\
            params![key, compressed],\
        );\
    \}\
\
    /// --- 5. ADAPTIVE MAINTENANCE (V21.7) ---\
    /// Performs non-blocking, space-efficient maintenance using Incremental Vacuum.\
    pub fn perform_incremental_maintenance(&self, pages: i32) -> Result<()> \{\
        println!("\\x1b[35m[MAINTENANCE]: Running Incremental Vacuum (\{\} pages)...\\x1b[0m", pages);\
        let db = self.db_conn.write().unwrap();\
        // Frees unused space in small chunks to avoid system freezes\
        db.execute(&format!("PRAGMA incremental_vacuum(\{\})", pages), [])?;\
        // Forces WAL checkpoint to merge logs into main database\
        db.execute("PRAGMA wal_checkpoint(TRUNCATE)", [])?;\
        Ok(())\
    \}\
\}\
