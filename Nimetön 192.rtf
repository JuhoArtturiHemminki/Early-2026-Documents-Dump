\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
#include <atomic>\
#include <cstdint>\
#include <vector>\
\
#define VGT_PWM_REGISTER      (*(volatile uint32_t*)0x40001000)\
#define FUEL_RAIL_DAC_REG     (*(volatile uint32_t*)0x40001004)\
#define ADC_THROTTLE_CH       0\
#define ADC_BOOST_CH          1\
#define ADC_OIL_TEMP_CH       2\
\
class SSOD_Master_ASIL_D \{\
private:\
    float vehicle_m = 1850.0f;\
    float dynamic_Cd = 0.24f;\
    const float TIRE_R = 0.330f;\
    const float dt = 0.01f;\
\
    float learning_momentum = 0.001f;\
    const float BASE_ALPHA = 0.001f;\
    const float AGGRESSIVE_ALPHA = 0.015f;\
\
    float last_v = 0.0f;\
    float last_rpm = 0.0f;\
    float last_throttle = 0.0f;\
    float torque_reduction_timer = 0.0f;\
    \
    float performance_timeout_timer = 0.0f;\
    const float AUTO_DISENGAGE_TIME = 60.0f;\
    bool internal_perf_inhibit = false;\
\
    const float MIN_OIL_TEMP_PERFORMANCE = 75.0f;\
    const float MAX_OIL_TEMP_CRITICAL    = 130.0f;\
    float current_oil_temp               = 20.0f;\
    bool is_processing = false;\
\
    enum FaultMask : uint32_t \{\
        OK = 0,\
        SMOKE_LIMIT = 1 << 2,\
        SHIFT_PROT = 1 << 3,\
        PERFORMANCE_ACTIVE = 1 << 7,\
        AUTO_TIMEOUT_DISENGAGED = 1 << 8,\
        COLD_PERF_BLOCK = 1 << 9,\
        OVERHEAT_PROTECTION = 1 << 10,\
        SENSOR_PLAUSIBILITY_ERR = 1 << 11\
    \};\
\
    void validate_inputs(float& pitch, float& boost, float v, float rpm, float throttle, uint32_t& faults) \{\
        float accel_g = (v - last_v) / (dt * 9.81f);\
        if (std::abs(pitch - accel_g) > 0.5f) \{\
            pitch = accel_g;\
            faults |= SENSOR_PLAUSIBILITY_ERR;\
        \}\
        if (throttle > 0.8f && rpm > 2200.0f && boost < 0.2f) \{\
            boost = (rpm / 3000.0f) * 1.5f;\
            faults |= SENSOR_PLAUSIBILITY_ERR;\
        \}\
    \}\
\
    void update_physics_dda(float v_ms, float torque_nm, bool perf_mode, float pitch_rad) \{\
        if (v_ms < 1.0f) return;\
        float actual_accel = (v_ms - last_v) / dt;\
        float driving_force = (torque_nm * 9.0f) / TIRE_R;\
        float gravity_f = vehicle_m * 9.81f * pitch_rad;\
        float aero_f = 0.5f * 1.225f * (v_ms * v_ms) * (perf_mode ? (dynamic_Cd * 2.22f) : 0.35f);\
        float net_force = driving_force - gravity_f - aero_f;\
\
        if (std::abs(actual_accel) > 0.1f) \{\
            float calculated_m = net_force / actual_accel;\
            float error_ratio = std::abs(calculated_m - vehicle_m) / (vehicle_m + 1.0f);\
            learning_momentum = (error_ratio > 0.10f) ? ((learning_momentum * 0.9f) + (AGGRESSIVE_ALPHA * 0.1f)) : ((learning_momentum * 0.95f) + (BASE_ALPHA * 0.05f));\
            vehicle_m = (vehicle_m * (1.0f - learning_momentum)) + (std::clamp(calculated_m, 1500.0f, 65000.0f) * learning_momentum);\
            if (perf_mode && v_ms > 22.0f) \{\
                dynamic_Cd = (dynamic_Cd * 0.9999f) + (0.24f * 0.0001f); \
            \}\
        \}\
        last_v = v_ms;\
    \}\
\
public:\
    struct ECUOutput \{\
        uint32_t rail_dac;\
        uint32_t vgt_pwm;\
        float torque_nm;\
        uint32_t faults;\
    \};\
\
    ECUOutput process_tick(float throttle, float v_ms, float rpm, float boost, float oil_t, float pitch_rad, bool raw_perf_switch) \{\
        ECUOutput out = \{0, 0, 0.0f, OK\};\
        validate_inputs(pitch_rad, boost, v_ms, rpm, throttle, out.faults);\
\
        bool cold_block = (oil_t < MIN_OIL_TEMP_PERFORMANCE);\
        if (raw_perf_switch && cold_block) out.faults |= COLD_PERF_BLOCK;\
\
        bool active_perf_mode = raw_perf_switch && !internal_perf_inhibit && !cold_block;\
\
        if (raw_perf_switch && !cold_block) \{\
            if (throttle > 0.40f) \{ performance_timeout_timer = AUTO_DISENGAGE_TIME; internal_perf_inhibit = false; \}\
            else \{ performance_timeout_timer -= dt; \}\
            if (performance_timeout_timer <= 0.0f) \{ internal_perf_inhibit = true; out.faults |= AUTO_TIMEOUT_DISENGAGED; \}\
        \} else \{ performance_timeout_timer = AUTO_DISENGAGE_TIME; internal_perf_inhibit = false; \}\
\
        float health = 1.0f;\
        if (oil_t > MAX_OIL_TEMP_CRITICAL - 10.0f) \{ \
            health = std::max(0.3f, 1.0f - (oil_t - 120.0f) * 0.07f); \
            out.faults |= OVERHEAT_PROTECTION; \
        \}\
\
        float req_torque = throttle * (active_perf_mode ? 600.0f : 550.0f) * health;\
        float smoke_limit = (1.0f + boost) * (active_perf_mode ? 450.0f : 420.0f);\
\
        if ((last_rpm - rpm) > 350.0f) torque_reduction_timer = 0.15f;\
        last_rpm = rpm;\
\
        if (req_torque > smoke_limit) \{ req_torque = smoke_limit; out.faults |= SMOKE_LIMIT; \}\
        if (torque_reduction_timer > 0.0f) \{ req_torque *= 0.4f; torque_reduction_timer -= dt; out.faults |= SHIFT_PROT; \}\
\
        out.torque_nm = req_torque;\
        if (active_perf_mode) out.faults |= PERFORMANCE_ACTIVE;\
\
        float vgt_pos = active_perf_mode ? (1.0f - (throttle * 0.9f)) : (0.95f - (throttle * 0.8f));\
        out.vgt_pwm = (uint32_t)(std::clamp(vgt_pos, 0.1f, 0.95f) * 1000.0f);\
\
        float target_rail = 400.0f + (req_torque * (active_perf_mode ? 3.0f : 2.8f));\
        out.rail_dac = (uint32_t)((std::min(target_rail, (active_perf_mode ? 2200.0f : 2000.0f) * health) / 2200.0f) * 4095.0f);\
\
        update_physics_dda(v_ms, req_torque, active_perf_mode, pitch_rad);\
        return out;\
    \}\
\
    void HighPriority_IRQ_Handler() \{\
        if (is_processing) return;\
        is_processing = true;\
        bool p_sw = (HAL_GPIO_Read(5) == GPIO_PIN_SET);\
        float thr = (float)HAL_ADC_Read(ADC_THROTTLE_CH) / 4095.0f;\
        float bst = (float)HAL_ADC_Read(ADC_BOOST_CH) * 0.0012f;\
        float oil = ((float)HAL_ADC_Read(ADC_OIL_TEMP_CH) * 0.1f) - 50.0f;\
        ECUOutput res = process_tick(thr, HAL_GetVehicleSpeed(), HAL_GetEngineRPM(), bst, oil, HAL_IMU_GetPitch(), p_sw);\
        VGT_PWM_REGISTER = res.vgt_pwm;\
        FUEL_RAIL_DAC_REG = res.rail_dac;\
        is_processing = false;\
    \}\
\};\
\
\
}