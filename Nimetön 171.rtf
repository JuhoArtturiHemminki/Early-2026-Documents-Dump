\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
\
class TeslaProductionOptimizer_V5_0_PROD \{\
private:\
    const float VEHICLE_M       = 1850.0f;\
    const float TIRE_R          = 0.330f;\
    const float G_ACCEL         = 9.81f;\
    const float CD_AREA         = 0.23f * 2.22f;\
    \
    const float Kp              = 0.82f;\
    const float Ki              = 0.15f; \
    const float I_LIMIT         = 2.5f;\
    const float EPSILON         = 0.0001f;\
    \
    float error_integral        = 0.0f;\
    float prev_safety_factor    = 1.0f;\
\
public:\
    struct ActuationOutput \{\
        float motor_torque_nm;\
        float brake_force_n;\
        bool abs_active;\
        float regen_efficiency;\
    \};\
\
    ActuationOutput execute_enhanced_cycle(\
        float req_decel, \
        float raw_v, \
        float t_cell, \
        float current_soc, \
        float pitch_rad, \
        float wheel_slip\
    ) \{\
        float air_temp_k = (t_cell > -273.15f) ? (t_cell + 273.15f) : 288.15f;\
        float rho = 1.225f * (288.15f / air_temp_k); \
        float gravity_force = VEHICLE_M * G_ACCEL * std::sin(pitch_rad);\
        float aero_force = 0.5f * rho * std::pow(raw_v, 2) * CD_AREA;\
        float natural_decel = (aero_force + gravity_force) / VEHICLE_M;\
\
        float thermal_map = 1.0f / (1.0f + std::exp(-0.25f * (t_cell - 12.0f)));\
        float soc_limit = std::clamp((98.0f - current_soc) / 12.0f, 0.0f, 1.0f);\
        float kw_limit = 175.0f * thermal_map * soc_limit;\
\
        float target_net_decel = std::max(0.0f, req_decel - natural_decel);\
        \
        float angular_v = std::max(1.0f, (raw_v / TIRE_R));\
        float max_torque_nm = (kw_limit * 1000.0f) / (angular_v + EPSILON);\
        \
        float smooth_target = (target_net_decel * Kp) + (error_integral * Ki);\
        float potential_torque = smooth_target * VEHICLE_M * TIRE_R;\
\
        if (raw_v < 0.1f) \{\
            error_integral = 0.0f;\
        \} else if (potential_torque < max_torque_nm) \{ \
            error_integral += target_net_decel * 0.01f;\
            error_integral = std::clamp(error_integral, -I_LIMIT, I_LIMIT);\
        \}\
\
        float target_safety = 1.0f;\
        bool abs_trigger = false;\
        if (wheel_slip > 0.11f) \{\
            abs_trigger = true;\
            target_safety = std::clamp(1.0f - ((wheel_slip - 0.11f) * 12.0f), 0.0f, 1.0f);\
            error_integral *= 0.75f;\
        \}\
        \
        float safety_factor = (prev_safety_factor * 0.6f) + (target_safety * 0.4f);\
        prev_safety_factor = safety_factor;\
\
        float final_regen_nm = std::min(potential_torque, max_torque_nm) * safety_factor;\
        float friction_needed = std::max(0.0f, (target_net_decel * VEHICLE_M) - (final_regen_nm / TIRE_R));\
        float efficiency = (final_regen_nm / (potential_torque + EPSILON)) * 100.0f;\
\
        return \{ \
            final_regen_nm, \
            friction_needed, \
            abs_trigger,\
            std::clamp(efficiency, 0.0f, 100.0f)\
        \};\
    \}\
\};\
}