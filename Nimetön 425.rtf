\f2\fs26 \cf0 use std::fs::\{OpenOptions, File\};\
use std::io::\{self, Write, Read, Seek, SeekFrom\};\
use std::time::Instant;\
\
/// OMNI-PACK v2.3: Proprietary Run-Length Encoding (RLE)\
/// Compresses data by finding consecutive identical bytes.\
/// Format: [Count: 1 byte][Byte: 1 byte]\
fn omni_pack_v2(data: &[u8]) -> Vec<u8> \{\
    let mut compressed = Vec::new();\
    let mut i = 0;\
    while i < data.len() \{\
        let mut count = 1;\
        while i + 1 < data.len() && data[i] == data[i + 1] && count < 255 \{\
            count += 1;\
            i += 1;\
        \}\
        compressed.push(count as u8);\
        compressed.push(data[i]);\
        i += 1;\
    \}\
    compressed\
\}\
\
pub struct OmniCoreV2 \{\
    file: File,\
    history: Vec<f32>, // Stores recent means for statistical baseline\
    window_size: usize, // The "Golden Ratio" window for re-learning\
\}\
\
impl OmniCoreV2 \{\
    /// Initializing the core with a path and a balanced window size (15).\
    pub fn new(path: &str) -> io::Result<Self> \{\
        let file = OpenOptions::new()\
            .read(true)\
            .write(true)\
            .create(true)\
            .open(path)?;\
        Ok(Self \{ \
            file, \
            history: Vec::new(), \
            window_size: 15 \
        \})\
    \}\
\
    /// STRATEGIC STORAGE: Analyzes, Compresses, and Stores data.\
    pub fn store(&mut self, id: u32, raw_data: &[u8]) -> io::Result<u64> \{\
        // 1. STATISTICAL ANALYSIS (The "Brain")\
        let current_mean = raw_data.iter().map(|&x| x as f32).sum::<f32>() / raw_data.len() as f32;\
\
        if self.history.len() >= 5 \{\
            let n = self.history.len() as f32;\
            let avg: f32 = self.history.iter().sum::<f32>() / n;\
            let variance: f32 = self.history.iter().map(|x| (x - avg).powi(2)).sum::<f32>() / n;\
            let std_dev = variance.sqrt();\
\
            // 3-Sigma Rule: Trigger alert if deviation > 2.5x Standard Deviation\
            let threshold = 2.5 * std_dev;\
            let diff = (current_mean - avg).abs();\
\
            if diff > threshold && std_dev > 0.05 \{\
                println!("\\x1b[35m[OMNI-WATCH]: Anomaly detected (Diff: \{:.2\}). Monitoring... \\x1b[0m", diff);\
            \}\
        \}\
\
        // 2. DYNAMIC RE-LEARNING (Update moving window)\
        self.history.push(current_mean);\
        if self.history.len() > self.window_size \{\
            self.history.remove(0);\
        \}\
\
        // 3. COMPRESSION & IO\
        let compressed = omni_pack_v2(raw_data);\
        let start_pos = self.file.seek(SeekFrom::End(0))?;\
        \
        // Binary Layout: [ID: 4b][SIZE: 4b][DATA: Variable]\
        self.file.write_all(&id.to_le_bytes())?;\
        self.file.write_all(&(compressed.len() as u32).to_le_bytes())?;\
        self.file.write_all(&compressed)?;\
        \
        Ok(start_pos)\
    \}\
\
    /// O(1) FAST FETCH: Direct jump to the offset.\
    pub fn fast_fetch(&mut self, offset: u64) -> io::Result<Vec<u8>> \{\
        self.file.seek(SeekFrom::Start(offset + 4))?; // Skip ID\
        let mut size_buf = [0u8; 4];\
        self.file.read_exact(&mut size_buf)?;\
        let size = u32::from_le_bytes(size_buf) as usize;\
        \
        let mut data = vec![0u8; size];\
        self.file.read_exact(&mut data)?;\
        Ok(data)\
    \}\
\}\
\
fn main() -> io::Result<()> \{\
    let start_time = Instant::now();\
    let mut core = OmniCoreV2::new("omni_nexus.bin")?;\
\
    println!("\\x1b[1m\\x1b[36m--- OMNI-CORE V2.3: BALANCED ADAPTIVE ONLINE ---\\x1b[0m");\
\
