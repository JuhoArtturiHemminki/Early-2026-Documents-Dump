            if current_phi < self.PHI_THRESHOLD:\
                logging.info(f"Synchronized at Phi: \{current_phi\}")\
                break\
        \
        # 4. KERS: Energian talteenotto p\'e4\'e4akselilta\
        self.state = "KERS"\
