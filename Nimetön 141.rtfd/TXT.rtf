        sync_msg = can.Message(arbitration_id=self.INVERTER_B_ID, data=[0x2B, 0x71, 0x60, 0x00, 0x90, 0x01, 0x00, 0x00])\
        self.bus.send(sync_msg)\
\
        # 2. PREDICTIVE HYDRAULICS: Aktivoi venttiilit ennen Phi-osumaa\
        time.sleep(0.2) # Odotetaan s\'e4hk\'f6ist\'e4 her\'e4\'e4mist\'e4\
