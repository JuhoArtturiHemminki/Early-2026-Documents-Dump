        if (temp > ECU_Config::TEMP_OPTIMAL_START) \{\
            int32_t stress = (temp - ECU_Config::TEMP_OPTIMAL_START) >> 1;\
            int32_t safety = ECU_Config::SafeClamp(ECU_Config::FP_SCALE - stress, 0, ECU_Config::FP_SCALE);\
            final_req = static_cast<int32_t>((static_cast<int64_t>(final_req) * safety) >> ECU_Config::FP_SHIFT);\
            out.protection_active = (safety < ECU_Config::FP_SCALE);\
        \}\
