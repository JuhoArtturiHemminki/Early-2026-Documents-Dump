/**\
 * @brief Recursive Kalman Filter for noise-free signal processing.\
 */\
class KalmanFilter \{\
private:\
    int32_t x, p, q, r;\
public:\
    constexpr KalmanFilter(int32_t init_q, int32_t init_r) \
        : x(0), p(ECU_Config::FP_SCALE), q(init_q), r(init_r) \{\}\
\
    int32_t update(int32_t measurement) \{\
        p = p + q;\
        // Integer-only gain calculation (Kalman Gain K)\
        int32_t k = (static_cast<int64_t>(p) << ECU_Config::FP_SHIFT) / (p + r);\
        x = x + ((static_cast<int64_t>(k) * (measurement - x)) >> ECU_Config::FP_SHIFT);\
        p = ((static_cast<int64_t>(ECU_Config::FP_SCALE - k) * p) >> ECU_Config::FP_SHIFT);\
        return x;\
    \}\
\};\
