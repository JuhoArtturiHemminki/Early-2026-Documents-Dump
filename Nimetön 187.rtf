        int32_t t_lim = ECU_Config::FP_SCALE;\
\
        // Cold Start Protection Logic\
        if (temp < ECU_Config::TEMP_COLD_THRESHOLD) \{\
            out.cold_limit_active = true;\
            fuel_mult = (ECU_Config::FP_SCALE * 90) >> 7; // ~0.90\
            t_lim = (ECU_Config::FP_SCALE * 70) >> 7;     // ~0.70\
            rail_offset = -(100 * ECU_Config::FP_SCALE);  // Pressure reduction\
        \} \
        else \{\
            // Normal Operating Mode - SSOD Unlocked\
            if (t_f > 400) \{ // High demand\
                fuel_mult = ECU_Config::ToFixed(1.18); // +18% Power gain\
                rail_offset = 120 * ECU_Config::FP_SCALE;\
                t_adv = 45; // SSOD Efficiency Timing Advance (Lower EGT)\
            \}\
            // Low-end Torque Shaping (Gearbox/Rod protection)\
            if (r_f < 1500) \{\
                t_lim = ECU_Config::ToFixed(0.90);\
            \}\
