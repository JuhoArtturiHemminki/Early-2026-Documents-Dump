    template<typename T> static constexpr T SafeClamp(T val, T min_v, T max_v) \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
    template<typename T> static constexpr T SafeAbs(T v) \{ return (v < 0) ? -v : v; \}\
    static constexpr int32_t Lerp(int32_t v1, int32_t v2, int32_t t_fp) \{\
        return v1 + static_cast<int32_t>((static_cast<int64_t>(v2 - v1) * t_fp) >> FP_SHIFT);\
    \}\
\
    static uint32_t CalculateCRC32_Partial(uint32_t seed, int start_idx, int end_idx) \{\
        uint32_t crc = seed;\
        auto crc_step = [](uint32_t c, uint32_t data) \{\
            c ^= data;\
            for (int j = 0; j < 32; j++) \{\
                c = (c & 0x80000000) ? ((c << 1) ^ 0x04C11DB7) : (c << 1);\
            \}\
            return c;\
        \};\
        for(int i = start_idx; i <= end_idx; ++i) \{\
            crc = crc_step(crc, (uint32_t)ECO_MAP[i]);\
            crc = crc_step(crc, (uint32_t)RACE_MAP[i]);\
        \}\
        return crc;\
    \}\
\}\
