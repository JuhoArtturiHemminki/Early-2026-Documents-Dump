class ECU_V16_Hybrid \{\
public:\
    struct Output \{\
        uint32_t rail_dac, injector_us, scr_us;\
        int32_t timing_advance_us;\
        uint16_t aggression_pct;\
        bool guardian_active, fault, bypass_active, launch_active, eco_mode, scr_active;\
        ECU_Config::FaultLevel fault_lvl;\
        uint32_t wdt_token;\
        const char *diag_code;\
    \};\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
private:\
    KalmanFilter thr_filt\{15, 512\};\
    std::atomic<int32_t> m_adaptive_trim\{0\};\
    int32_t m_last_thr = 0, m_resonance_buffer = 0, m_prev_rpm = 0, m_eco_timer = 0;\
    uint64_t m_cycle_count = 0;\
    bool m_thermal_cut_active = false;\
    inline void Fast_Security_Step(Output& out, int32_t tq) \{\
        uint64_t sig = ECU_Optimized::Sign_Atomic(static_cast<uint32_t>(tq), out.wdt_token, 0x1F3F2E1D);\
        out.wdt_token ^= static_cast<uint32_t>(sig >> 16);\
    \}\
public:\
    Output step(int32_t apps1, int32_t apps2, int32_t rpm, int32_t temp, bool scr_system_ok) \{\
        Output out = \{0, 0, 0, 0, 0, false, false, false, false, false, false, ECU_Config::FaultLevel::NONE, 0, "000"\};\
        m_cycle_count++;\
        if (m_stack_guard != ECU_Config::STACK_MAGIC) \{ out.fault = true; out.fault_lvl = ECU_Config::FaultLevel::HARD; return out; \}\
        \
        int32_t raw_thr = ECU_Config::SafeClamp((apps1 + apps2) >> 1, 0, 1024);\
        int32_t rpm_delta = rpm - m_prev_rpm;\
        m_prev_rpm = rpm;\
\
        if (ECU_Config::SafeAbs(raw_thr - m_last_thr) < 5 && raw_thr < 400 && scr_system_ok) m_eco_timer++;\
        else m_eco_timer = 0;\
\
        out.eco_mode = (m_eco_timer > 100); \
        out.launch_active = (raw_thr > 980 && rpm < 3500 && rpm_delta > 50);\
        \
        int32_t d_gain = out.launch_active ? 1024 : 180;\
        m_resonance_buffer += (raw_thr - m_resonance_buffer) * d_gain / 1024;\
        \
        int32_t t_f = out.launch_active ? raw_thr : thr_filt.update(m_resonance_buffer);\
        int32_t final_tq = (static_cast<int64_t>(t_f) * 640) >> 10;\
        if (rpm_delta < -300) final_tq += 15 * ECU_Config::FP_SCALE;\
\
        if (temp > ECU_Config::THERMAL_CRITICAL && !out.launch_active) m_thermal_cut_active = true;\
        if (m_thermal_cut_active) final_tq >>= 1;\
\
        int32_t rail = ECU_Config::SafeClamp((450 * ECU_Config::FP_SCALE) + (final_tq * 4) + m_adaptive_trim.load(), 0, ECU_Config::MAX_SAFE_RAIL);\
        uint32_t base_inj = out.eco_mode ? ECU_Config::ECO_INJECTOR_MIN : ECU_Config::BASE_INJECTOR_US;\
\
        out.rail_dac = (out.fault_lvl == ECU_Config::FaultLevel::HARD) ? 0 : (static_cast<uint64_t>(rail) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL;\
        out.injector_us = (out.fault_lvl == ECU_Config::FaultLevel::HARD) ? 0 : ECU_Config::SafeClamp(static_cast<uint32_t>(base_inj + (rail / 2048)), base_inj, ECU_Config::MAX_INJECTOR_US);\
        \
        // SCR/AdBlue ohjaus: Aktivoituu vain ECO-moodissa puhdistamaan NOx-p\'e4\'e4st\'f6t\
        if (out.eco_mode && scr_system_ok && temp > 60 * ECU_Config::FP_SCALE) \{\
            out.scr_active = true;\
            out.scr_us = (out.injector_us * ECU_Config::SCR_RATIO_FP) >> 10;\
        \}\
\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ (static_cast<uint32_t>(m_cycle_count) * 0x1F3F);\
        m_last_thr = raw_thr;\
        Fast_Security_Step(out, final_tq);\
        return out;\
    \}\
\};\
