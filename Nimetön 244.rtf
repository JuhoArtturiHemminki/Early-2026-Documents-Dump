namespace ECU_Optimized \{\
    struct CryptoState \{ uint32_t v0, v1, v2, v3; \};\
    static inline void Permute_Universal(CryptoState& s) \{\
        s.v0 += s.v1; s.v1 = ECU_Config::RotL(s.v1, 5);  s.v1 ^= s.v0;\
        s.v0 = ECU_Config::RotL(s.v0, 16);\
        s.v2 += s.v3; s.v3 = ECU_Config::RotL(s.v3, 8);  s.v3 ^= s.v2;\
        s.v0 += s.v3; s.v3 = ECU_Config::RotL(s.v3, 13); s.v3 ^= s.v0;\
        s.v2 += s.v1; s.v1 = ECU_Config::RotL(s.v1, 7);  s.v1 ^= s.v2;\
        s.v2 = ECU_Config::RotL(s.v2, 16);\
    \}\
    static inline uint64_t Sign_Atomic(uint32_t m1, uint32_t m2, uint32_t k) \{\
        CryptoState s = \{ m1 ^ k, m2 ^ k, 0x554C5449, 0x4D415445 \};\
        for(int i=0; i<4; ++i) Permute_Universal(s);\
        return (static_cast<uint64_t>(s.v0 ^ s.v1) << 32) | (s.v2 ^ s.v3);\
    \}\
\}\
