\f2\fs26 \cf0 // HUB-EYE EDGE SIGNAL PROCESSOR (ESP-V1)\
// Tavoite: Laskea pitoindeksi ennen v\'e4yl\'e4siirtoa\
\
float calculate_friction_index(float* acoustic_buffer, float temp_surface) \{\
    // Suoritetaan FFT-analyysi (Fast Fourier Transform)\
    float delta_freq = perform_FFT(acoustic_buffer);\
    \
    // Tunnistetaan pinnan tyyppi (Spectral Fingerprinting)\
    float friction_mu = 1.0; // Oletus: Kuiva asfaltti\
    \
    if (delta_freq > 4000.0 && delta_freq < 6000.0) \{\
        friction_mu = 0.3; // Vesiliirron riski havaittu (Aqua-planing)\
    \} else if (delta_freq < 500.0) \{\
        friction_mu = 0.15; // J\'e4\'e4 tai eritt\'e4in liukas pinta (Icy conditions)\
    \}\
    \
    // L\'e4mp\'f6tilakorjaus (Arhenius-tyyppinen sovitus)\
    float sigma_temp_correction = (temp_surface - 20.0) * 0.002;\
    return friction_mu - sigma_temp_correction;\
\}\
