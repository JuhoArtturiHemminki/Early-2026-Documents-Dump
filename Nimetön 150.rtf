\f2\fs26 \cf0 // SSOD-V9 MAIN STRATEGY KERNEL\
// Laskee optimaalisen py\'f6rimisnopeuden (W_TARGET)\
\
struct PhysicsState \{\
    float Fz_load;        // Pystysuora kuorma (N)\
    float temp_internal;  // Renkaan sis\'e4l\'e4mp\'f6 (C)\
    float ground_speed;   // Todellinen maanopeus (m/s)\
    float current_mu;     // Edgen laskema kitkakerroin\
\};\
\
float get_optimized_torque(PhysicsState ps) \{\
    const float R_NOMINAL = 0.315;\
    const float K_TYRE = 225000.0; // Renkaan pystyj\'e4ykkyys\
    \
    // Lasketaan DELTA_R (renkaan painuma kuorman alla)\
    float delta_r_load = ps.Fz_load / K_TYRE;\
    \
    // Lasketaan SIGMA_THERM (l\'e4mp\'f6laajeneminen)\
    float sigma_therm = 0.000085 * ps.temp_internal * R_NOMINAL;\
    \
    // LOPULLINEN DYNAAMINEN S\'c4DE (R_DYN)\
    float R_DYN = R_NOMINAL - delta_r_load + sigma_therm;\
    \
    // Lasketaan tavoitepy\'f6rimisnopeus (W_TARGET)\
    float w_target = ps.ground_speed / R_DYN;\
    \
    // LAUNCH CONTROL: Salli mikroluisto kiihtyvyyden maksimoimiseksi\
    if (ps.current_mu > 0.8) \{\
        w_target = w_target * 1.02; // 2% optimaalinen luisto (slip)\
    \}\
    \
    return w_target;\
\}\
