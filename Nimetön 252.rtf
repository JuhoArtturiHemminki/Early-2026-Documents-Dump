class ECU_Core_Engine \{\
public:\
    struct Output \{\
        uint32_t rail_dac, injector_us, scr_us, dpf_post_us;\
        int32_t timing_advance_us;\
        bool guardian_active, fault, bypass_active, launch_active, stoich_mode, scr_active;\
        bool dpf_regen_active, misfire_detected;\
        ECU_Config::FaultLevel fault_lvl;\
        uint32_t wdt_token;\
        uint16_t dtc_code;\
        const char *diag_msg;\
    \};\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
\
private:\
    KalmanFilter thr_filt\{15, 512\};\
    std::atomic<int32_t> m_adaptive_trim\{0\};\
    int32_t m_last_thr = 0, m_resonance_buffer = 0, m_prev_rpm = 0, m_mode_timer = 0;\
    int32_t m_exhaust_temp_model = 20 * ECU_Config::FP_SCALE;\
    int32_t m_turbo_rpm_model = 0;\
    uint32_t m_dpf_soot_level = 0;\
    int32_t m_l2_torque_limit = 1000 * ECU_Config::FP_SCALE;\
    uint64_t m_cycle_count = 0;\
\
    inline bool IsReasonable(int32_t thr, int32_t rpm, bool brake) \{\
        if (thr > 900 && rpm < 500) return false;\
        if (brake && thr > 500) return false;\
        return true;\
    \}\
\
    inline void Fast_Security_Step(Output& out, int32_t tq) \{\
        uint64_t sig = ECU_Optimized::Sign_Atomic(static_cast<uint32_t>(tq), out.wdt_token, ECU_Config::CRYPTO_SALT);\
        out.wdt_token ^= static_cast<uint32_t>(sig >> 16);\
    \}\
\
public:\
    Output step(int32_t a1, int32_t a2, int32_t rpm, int32_t temp, uint32_t bat_mv, bool brake, bool scr_ok) \{\
        Output out = \{0, 0, 0, 0, 0, false, false, false, false, false, false, false, false, ECU_Config::FaultLevel::NONE, 0, ECU_Config::DTC_NONE, "SYSTEM OK"\};\
        m_cycle_count++;\
\
        if (m_stack_guard != ECU_Config::STACK_MAGIC || ECU_Config::SW_CERT_ID != 0x554C54494D415445ULL) \{\
            out.fault = true; out.fault_lvl = ECU_Config::FaultLevel::HARD; \
            out.dtc_code = ECU_Config::DTC_ECU_INTERNAL; out.diag_msg = "CRITICAL MEMORY CORRUPTION - STOP ENGINE";\
            return out;\
        \}\
\
        int32_t raw_thr = ECU_Config::SafeClamp((a1 + a2) >> 1, 0, 1024);\
        if (!IsReasonable(raw_thr, rpm, brake)) \{\
            out.fault = true; out.fault_lvl = ECU_Config::FaultLevel::SOFT; \
            out.dtc_code = ECU_Config::DTC_THROTTLE_CORR; out.diag_msg = "THROTTLE SENSOR CORRELATION ERROR";\
            return out;\
        \}\
\
        m_exhaust_temp_model += (raw_thr / 10) - (m_exhaust_temp_model / 200);\
        m_turbo_rpm_model = (raw_thr * 180);\
        \
        if (m_exhaust_temp_model > ECU_Config::EXHAUST_VALVE_LIMIT) \{\
            out.dtc_code = ECU_Config::DTC_EXHAUST_TEMP; out.diag_msg = "EXHAUST TEMPERATURE CRITICAL";\
        \} else if (m_turbo_rpm_model > ECU_Config::TURBO_RPM_MAX) \{\
            out.dtc_code = ECU_Config::DTC_TURBO_OVER; out.diag_msg = "TURBO OVERSPEED DETECTED";\
        \}\
\
        bool prot_active = (out.dtc_code != ECU_Config::DTC_NONE);\
        int32_t rpm_delta = rpm - m_prev_rpm;\
        out.misfire_detected = (rpm_delta < -150);\
        m_prev_rpm = rpm;\
\
        m_dpf_soot_level++;\
        if (m_dpf_soot_level > 50000 && rpm > 2000) out.dpf_regen_active = true;\
\
        if (ECU_Config::SafeAbs(raw_thr - m_last_thr) < 10 && raw_thr < 500) m_mode_timer++;\
        else m_mode_timer = 0;\
        out.stoich_mode = (m_mode_timer > 50);\
        out.launch_active = (raw_thr > 980 && rpm < 3500 && rpm_delta > 50);\
\
        int32_t d_gain = out.launch_active ? 1024 : 180;\
        m_resonance_buffer += (raw_thr - m_resonance_buffer) * d_gain / 1024;\
        int32_t target_tq = (static_cast<int64_t>(out.launch_active ? raw_thr : thr_filt.update(m_resonance_buffer)) * ECU_Config::TQ_TO_RAIL_COEFF) >> 10;\
\
        if (rpm_delta < -300) target_tq += 15 * ECU_Config::FP_SCALE;\
        if (prot_active && !out.launch_active) \{\
            target_tq >>= 1;\
            out.guardian_active = true;\
        \}\
        target_tq = ECU_Config::SafeClamp(target_tq, 0, m_l2_torque_limit);\
\
        uint32_t v_corr = ECU_Config::GetVoltageOffset(bat_mv);\
        int32_t rail = ECU_Config::SafeClamp((450 * ECU_Config::FP_SCALE) + (target_tq * 4) + m_adaptive_trim.load(), 0, ECU_Config::MAX_SAFE_RAIL);\
        uint32_t base_inj = out.stoich_mode ? ECU_Config::STOICH_LIMIT_US : ECU_Config::BASE_INJECTOR_US;\
\
        out.rail_dac = (static_cast<uint64_t>(rail) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL;\
        out.injector_us = base_inj + (rail / 2048) + v_corr;\
\
        if (out.dpf_regen_active) \{\
            out.dpf_post_us = ECU_Config::DPF_REGEN_US;\
            m_dpf_soot_level -= 2;\
            if (m_dpf_soot_level == 0) out.dpf_regen_active = false;\
        \}\
\
        if (out.stoich_mode && scr_ok && temp > 70 * ECU_Config::FP_SCALE) \{\
            out.scr_active = true;\
            out.scr_us = (out.injector_us * ECU_Config::SCR_STD_RATIO) >> 10;\
        \}\
\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ (static_cast<uint32_t>(m_cycle_count) * 0x1F3F);\
        m_last_thr = raw_thr;\
        Fast_Security_Step(out, target_tq);\
        return out;\
    \}\
\};\
