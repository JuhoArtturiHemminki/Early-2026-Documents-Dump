namespace ECU_Comm \{\
    struct CAN_Frame \{ uint32_t id; uint8_t d; uint8_t len; \};\
    class TX_FIFO_Manager \{\
    private:\
        CAN_Frame m_buffer[ECU_Config::CAN_FIFO_SIZE];\
        std::atomic<uint8_t> m_head\{0\}, m_tail\{0\}, m_count\{0\};\
    public:\
        bool Push(const CAN_Frame& f, bool prio) \{\
            uint8_t current_count = m_count.load(std::memory_order_relaxed);\
            if (current_count == ECU_Config::CAN_FIFO_SIZE) \{\
                if (!prio) return false;\
                uint8_t old_tail = m_tail.load(std::memory_order_relaxed);\
                m_tail.store((old_tail + 1) % ECU_Config::CAN_FIFO_SIZE, std::memory_order_relaxed);\
                m_count.fetch_sub(1, std::memory_order_acq_rel);\
            \}\
            uint8_t head = m_head.load(std::memory_order_relaxed);\
            m_buffer[head] = f;\
            m_head.store((head + 1) % ECU_Config::CAN_FIFO_SIZE, std::memory_order_release);\
            m_count.fetch_add(1, std::memory_order_acq_rel);\
            return true;\
        \}\
        bool Pop(CAN_Frame& f) \{\
            if (m_count.load(std::memory_order_acquire) == 0) return false;\
            uint8_t tail = m_tail.load(std::memory_order_relaxed);\
            f = m_buffer[tail];\
            m_tail.store((tail + 1) % ECU_Config::CAN_FIFO_SIZE, std::memory_order_release);\
            m_count.fetch_sub(1, std::memory_order_acq_rel);\
            return true;\
        \}\
    \};\
    class Universal_CAN_Driver \{\
    private:\
        static TX_FIFO_Manager m_fifo;\
    public:\
        static inline void Pack_And_Queue(const ECU_Core_Engine::Output& out) \{\
            CAN_Frame f1 = \{ ECU_Config::CAN_ID_STATUS, \{0,0,0,0,0,0,0,0\}, 8 \};\
            f1.d = static_cast<uint8_t>(out.rail_dac >> 8); \
            f1.d = static_cast<uint8_t>(out.rail_dac & 0xFF);\
            f1.d = static_cast<uint8_t>(out.wdt_token >> 24); \
            f1.d = static_cast<uint8_t>(out.wdt_token >> 16);\
            f1.d = static_cast<uint8_t>(out.wdt_token >> 8); \
            f1.d = static_cast<uint8_t>(out.wdt_token & 0xFF);\
            f1.d = static_cast<uint8_t>(out.fault_lvl); \
            f1.d = out.launch_active ? ECU_Config::SIG_LAUNCH : ECU_Config::SIG_NORMAL;\
            m_fifo.Push(f1, out.launch_active);\
\
            if (out.dtc_code != ECU_Config::DTC_NONE) \{\
                CAN_Frame f2 = \{ ECU_Config::CAN_ID_DIAG, \{0,0,0,0,0,0,0,0\}, 8 \};\
                f2.d = 0x03;\
                f2.d = static_cast<uint8_t>(out.dtc_code >> 8);\
                f2.d = static_cast<uint8_t>(out.dtc_code & 0xFF);\
                f2.d = out.guardian_active ? 0xFF : 0x00; \
                m_fifo.Push(f2, true);\
            \}\
        \}\
        static void Process_Hardware_TX() \{\
            CAN_Frame frame;\
            while(m_fifo.Pop(frame)) \{ /* Hardware Abstraction Layer Call */ \}\
        \}\
    \};\
    TX_FIFO_Manager Universal_CAN_Driver::m_fifo;\
\}\
