        // T\'e4m\'e4 testi varmistaa, ett\'e4 tyyppien kytkent\'e4 toimii.\
        let res = core.step(Rpm(2000.0), 1.0, 0.01, Celsius(20.0), HPa(1013.25));\
        assert!(res.0.is_finite());\
    \}\
\}\
