            let mut enc2 = Encoder::with_prepared_dictionary(Vec::new(), &dict).unwrap();\
            enc2.write_all(b2).unwrap();\
            let c2_len = enc2.finish().unwrap().len() as f32;\
            let mut combined = b1.to_vec();\
            combined.extend_from_slice(b2);\
            let mut enc_c = Encoder::with_prepared_dictionary(Vec::new(), &dict).unwrap();\
            enc_c.write_all(&combined).unwrap();\
