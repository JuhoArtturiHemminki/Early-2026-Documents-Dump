\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
#include <atomic>\
#include <cstdint>\
\
#define VGT_PWM_REGISTER      (*(volatile uint32_t*)0x40001000)\
#define FUEL_RAIL_DAC_REG     (*(volatile uint32_t*)0x40001004)\
\
class SSOD_DualMode_ECU \{\
private:\
    float vehicle_m = 1850.0f;\
    float dynamic_Cd = 0.24f;\
    const float TIRE_R = 0.330f;\
    const float dt = 0.01f;\
\
    float last_v = 0.0f;\
    float last_rpm = 0.0f;\
    float torque_reduction_timer = 0.0f;\
    bool is_processing = false;\
\
    enum FaultMask : uint32_t \{\
        OK = 0,\
        SMOKE_LIMIT = 1 << 2,\
        SHIFT_PROT = 1 << 3,\
        PERFORMANCE_ACTIVE = 1 << 7\
    \};\
\
    void update_physics(float v_ms, float torque_nm, bool perf_mode) \{\
        if (v_ms < 1.0f) return;\
        float actual_accel = (v_ms - last_v) / dt;\
        last_v = v_ms;\
\
        float driving_force = (torque_nm * 9.0f) / TIRE_R;\
        float aero_f = 0.5f * 1.225f * (v_ms * v_ms) * (perf_mode ? (dynamic_Cd * 2.22f) : 0.35f);\
        float net_force = driving_force - aero_f;\
\
        if (actual_accel > 0.1f) \{\
            float calculated_m = net_force / actual_accel;\
            vehicle_m = (vehicle_m * 0.999f) + (calculated_m * 0.001f);\
            \
            if (perf_mode && v_ms > 22.0f) \{\
                dynamic_Cd = (dynamic_Cd * 0.9999f) + (0.24f * 0.0001f); \
            \}\
        \}\
    \}\
\
public:\
    struct ECUOutput \{\
        uint32_t rail_dac;\
        uint32_t vgt_pwm;\
        float torque_nm;\
        uint32_t faults;\
    \};\
\
    ECUOutput process_tick(float throttle, float v_ms, float rpm, float boost, bool perf_mode) \{\
        ECUOutput out = \{0, 0, 0.0f, OK\};\
        if (perf_mode) out.faults |= PERFORMANCE_ACTIVE;\
\
        const float max_rail = perf_mode ? 2200.0f : 2000.0f;\
        const float torque_base = perf_mode ? 600.0f : 550.0f;\
        const float smoke_coeff = perf_mode ? 450.0f : 420.0f;\
\
        if ((last_rpm - rpm) > 350.0f) torque_reduction_timer = 0.15f;\
        last_rpm = rpm;\
\
        float req_torque = throttle * torque_base;\
        float smoke_limit = (1.0f + boost) * smoke_coeff;\
\
        if (req_torque > smoke_limit) \{\
            req_torque = smoke_limit;\
            out.faults |= SMOKE_LIMIT;\
        \}\
\
        if (torque_reduction_timer > 0.0f) \{\
            req_torque *= 0.4f;\
            torque_reduction_timer -= dt;\
            out.faults |= SHIFT_PROT;\
        \}\
\
        out.torque_nm = req_torque;\
\
        float vgt_pos = perf_mode ? (1.0f - (throttle * 0.9f)) : (0.95f - (throttle * 0.8f));\
        out.vgt_pwm = (uint32_t)(std::clamp(vgt_pos, 0.1f, 0.95f) * 1000.0f);\
\
        float target_rail = 400.0f + (req_torque * (perf_mode ? 3.0f : 2.8f));\
        out.rail_dac = (uint32_t)((std::min(target_rail, max_rail) / 2200.0f) * 4095.0f);\
\
        update_physics(v_ms, req_torque, perf_mode);\
        return out;\
    \}\
\
    void HighPriority_IRQ_Handler() \{\
        if (is_processing) return;\
        is_processing = true;\
\
        bool perf_switch = (HAL_GPIO_Read(5) == GPIO_PIN_SET); \
        \
        float thr = (float)HAL_ADC_Read(0) / 4095.0f;\
        float bst = (float)HAL_ADC_Read(1) * 0.0012f;\
        \
        ECUOutput res = process_tick(thr, HAL_GetVehicleSpeed(), HAL_GetEngineRPM(), bst, perf_switch);\
\
        *(volatile uint32_t*)0x40001000 = res.vgt_pwm;\
        *(volatile uint32_t*)0x40001004 = res.rail_dac;\
\
        is_processing = false;\
    \}\
\};\
}