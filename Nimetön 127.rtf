                <div id="status-tag" style="background:#ff3e3e; color:#000; padding:4px 12px; border-radius:20px; font-size:10px; font-weight:bold; letter-spacing:1px;">ACTIVE_DRIVE_A</div>\
            </div>\
            \
            <canvas id="ssodCanvas" width="960" height="380" style="background:radial-gradient(circle, #1a1a1a 0%, #0d0d0d 100%); border-radius:10px; margin-bottom:20px;"></canvas>\
            \
            <div style="display:grid; grid-template-columns: 1fr 1.5fr 1fr; gap:20px;">\
                <!-- NOPEUS JA VAIHDE -->\
                <div style="background:#1a1a1a; padding:15px; border-radius:10px; border:1px solid #222; text-align:center;">\
                    <div style="font-size:10px; color:#666; margin-bottom:5px; text-transform:uppercase;">Velocity</div>\
                    <div id="kmh" style="font-size:32px; font-weight:200; color:#fff;">0 <span style="font-size:14px; color:#444;">km/h</span></div>\
                    <div id="gear" style="margin-top:5px; font-weight:bold; color:#ff3e3e;">GEAR 1</div>\
                </div>\
\
                <!-- ANALYYTTINEN KESKIPANEELI -->\
                <div style="background:#1a1a1a; padding:15px; border-radius:10px; border:1px solid #222; display:flex; justify-content:space-around; align-items:center;">\
                    <div style="text-align:center;">\
                        <div style="font-size:10px; color:#666; margin-bottom:5px;">TURBO BOOST</div>\
                        <div id="boost-bar" style="width:100px; height:6px; background:#333; border-radius:3px; overflow:hidden;">\
                            <div id="boost-fill" style="width:0%; height:100%; background:#00d1ff; transition:width 0.1s;"></div>\
                        </div>\
                        <div id="boost-val" style="font-size:14px; margin-top:5px; color:#00d1ff; font-weight:bold;">0.00 bar</div>\
                    </div>\
                    <div style="text-align:center;">\
                        <div style="font-size:10px; color:#666; margin-bottom:5px;">SAVINGS</div>\
                        <div id="save-val" style="font-size:24px; color:#00ff88; font-weight:bold;">0.00 \'80</div>\
                        <div style="font-size:10px; color:#444;">KERS OPTIMIZED</div>\
                    </div>\
                </div>\
\
                <!-- PHI-SYNC DATA -->\
                <div style="background:#1a1a1a; padding:15px; border-radius:10px; border:1px solid #222; text-align:center;">\
                    <div style="font-size:10px; color:#666; margin-bottom:5px;">PHI-INDEX SYNC</div>\
                    <div id="phi" style="font-size:24px; color:#bd00ff; font-family:monospace;">0.0000</div>\
                    <div id="sync-label" style="font-size:10px; color:#444; margin-top:5px;">WAITING...</div>\
                </div>\
