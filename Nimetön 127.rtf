    document.body.appendChild(stage);\
\
    const canvas = document.getElementById('ssodCanvas');\
    const ctx = canvas.getContext('2d');\
    \
    // UI\
    const kmhEl = document.getElementById('kmh');\
    const gearEl = document.getElementById('gear');\
    const boostFill = document.getElementById('boost-fill');\
    const boostVal = document.getElementById('boost-val');\
    const saveVal = document.getElementById('save-val');\
    const phiEl = document.getElementById('phi');\
    const statusTag = document.getElementById('status-tag');\
    const syncLabel = document.getElementById('sync-label');\
\
    let kmh = 0;\
    let frame = 0;\
    let savedEur = 0;\
    let posA = 300, posB = 220; // Y-koordinaatit\
    let rpmA = 0, rpmB = 0;\
    let rotA = 0, rotB = 0;\
\
    function draw() \{\
        requestAnimationFrame(draw);\
        frame++;\
        ctx.clearRect(0, 0, canvas.width, canvas.height);\
\
        // --- FYSIIKKA & KIIHDYTYS ---\
        if (kmh < 110) \{\
            kmh += 0.06;\
            savedEur += 0.0008;\
        \} else \{\
            kmh = 0;\
            savedEur = 0;\
        \}\
\
        let gear = Math.floor(kmh / 16) + 1;\
        let groundRPM = kmh * 18.5;\
        let shiftCycle = (kmh % 20);\
        let isSyncing = shiftCycle > 12 && shiftCycle < 16;\
        let isHandover = shiftCycle >= 16;\
\
        // --- AKSELIEN LIIKE (Interpolointi / Sulavuus) ---\
        if (isHandover) \{\
            posA = posA * 0.94 + 220 * 0.06; // Nostaa A\
            posB = posB * 0.92 + 300 * 0.08; // Laskee B\
            rpmB = groundRPM;\
            rpmA = Math.max(0, rpmA - 2.5); // KERS jarrutus nollaan\
            statusTag.innerText = "SIGMA_HANDOVER";\
            statusTag.style.background = "#00d1ff";\
        \} else \{\
            posA = posA * 0.92 + 300 * 0.08; // Laskee A\
            posB = posB * 0.94 + 220 * 0.06; // Nostaa B\
            rpmA = groundRPM;\
            if (isSyncing) \{\
                rpmB = Math.min(groundRPM, rpmB + 3.5); // e-Sync kiihdytys ilmassa\
                statusTag.innerText = "E-SYNCING";\
                statusTag.style.background = "#bd00ff";\
                syncLabel.innerText = "MATCHING SPEED...";\
            \} else \{\
                rpmB = Math.max(0, rpmB - 2.5); // KERS jarrutus nollaan\
                statusTag.innerText = "DRIVE_A_ACTIVE";\
                statusTag.style.background = "#ff3e3e";\
                syncLabel.innerText = "STANDBY (0 RPM)";\
            \}\
        \}\
\
        // --- UI P\'c4IVITYKSET ---\
        kmhEl.innerHTML = `$\{Math.floor(kmh)\} <span style="font-size:14px; color:#444;">km/h</span>`;\
        gearEl.innerText = `GEAR $\{gear\}`;\
        let bVal = Math.min(2.8, (kmh/40) + (isHandover?0.5:0));\
        boostFill.style.width = (bVal/3 * 100) + "%";\
        boostVal.innerText = bVal.toFixed(2) + " bar";\
        saveVal.innerText = savedEur.toFixed(2) + " \'80";\
        phiEl.innerText = isSyncing ? Math.abs(groundRPM - rpmB).toFixed(4) : (rpmB < 1 ? "0.0000" : "---");\
\
        // --- PIIRT\'c4MINEN ---\
        // Tie (Sulava liike)\
        ctx.fillStyle = "#222";\
        for(let i=0; i<40; i++) \{\
            let x = (i * 40 - (frame * (kmh*0.3)) % 40);\
            ctx.fillRect(x, 335, 20, 2);\
        \}\
\
        // Rekan runko (Muotoiltu)\
        ctx.fillStyle = "#1a1a1a";\
        ctx.beginPath();\
        ctx.roundRect(250, 210, 500, 60, 5); // Alusta\
        ctx.roundRect(620, 110, 140, 150, 10); // Ohjaamo\
        ctx.fill();\
        ctx.strokeStyle = "#333";\
        ctx.lineWidth = 2;\
        ctx.stroke();\
\
        const drawWheel = (x, y, color, rpm, label, active) => \{\
            let speedFactor = rpm * 0.006;\
            if (label === "A") rotA += speedFactor; else if (label === "B") rotB += speedFactor;\
            let currentRot = (label === "A") ? rotA : (label === "B") ? rotB : frame * (kmh * 0.1);\
\
            ctx.save();\
            ctx.translate(x, y);\
            \
            // Varjo maahan\
            if (y > 280) \{\
                ctx.fillStyle = "rgba(0,0,0,0.3)";\
                ctx.beginPath();\
                ctx.ellipse(0, 40, 35, 10, 0, 0, Math.PI*2);\
                ctx.fill();\
            \}\
\
            ctx.rotate(currentRot * Math.PI / 180);\
            \
            // Rengas\
            ctx.beginPath();\
            ctx.arc(0, 0, 32, 0, Math.PI * 2);\
            ctx.fillStyle = "#0a0a0a";\
            ctx.fill();\
            ctx.strokeStyle = active ? color : "#333";\
            ctx.lineWidth = 4;\
            ctx.stroke();\
\
            // Vanne (Moderni)\
            ctx.strokeStyle = "#222";\
            ctx.lineWidth = 1;\
            for(let i=0; i<6; i++) \{\
                ctx.rotate(Math.PI/3);\
                ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(0,30); ctx.stroke();\
            \}\
            \
            ctx.restore();\
            \
            // Tekstit renkaan p\'e4\'e4lle\
            ctx.fillStyle = active ? color : "#444";\
            ctx.font = "bold 10px Inter";\
            ctx.textAlign = "center";\
            ctx.fillText(label, x, y - 45);\
            ctx.font = "9px Inter";\
            ctx.fillText(Math.floor(rpm) + " RPM", x, y + 55);\
        \};\
\
        // Py\'f6rien sijoittelu\
        drawWheel(670, 300, "#666", groundRPM, "STEER", true);\
        drawWheel(510, posB, "#00ff88", rpmB, "B", isHandover || isSyncing);\
        drawWheel(380, posA, "#ff3e3e", rpmA, "A", !isHandover);\
        drawWheel(270, 300, "#666", groundRPM, "TAG", true);\
    \}\
    draw();\
\})();\
