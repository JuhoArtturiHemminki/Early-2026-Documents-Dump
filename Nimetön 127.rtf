        // Runko\
        ctx.fillStyle = "#151515";\
        ctx.beginPath();\
        ctx.roundRect(200, 190, 550, 55, 5); \
        ctx.roundRect(600, 90, 150, 150, 12); \
        ctx.fill();\
        ctx.strokeStyle = "#252525"; ctx.stroke();\
\
        const drawWheel = (x, y, color, rpm, label, active) => \{\
            let speedFactor = rpm * 0.007;\
            if (label === "A") rotA += speedFactor; else if (label === "B") rotB += speedFactor;\
            let rot = (label === "A") ? rotA : (label === "B") ? rotB : frame * (kmh * 0.12);\
\
            ctx.save();\
            ctx.translate(x, y);\
            \
            // Varjo\
