            kmh = 0; savedEur = 0;\
        \}\
\
        let groundRPM = kmh * 16.2;\
        let shiftCycle = (kmh % 22);\
        let isSyncing = shiftCycle > 14 && shiftCycle < 18;\
        let isHandover = shiftCycle >= 18;\
\
        // VAKAA AHDINPAINE (SSOD:n ydin)\
        // Paine nousee alussa, mutta vaihdon (handover) aikana se EI laske.\
        let currentTurbo = Math.min(turboTarget, (kmh/20) + 1.2); \
        \
        // --- AKSELIEN INTERPOLOINTI ---\
        if (isHandover) \{\
            posA = posA * 0.95 + 200 * 0.05; \
            posB = posB * 0.92 + 280 * 0.08;\
            rpmB = groundRPM;\
            rpmA = Math.max(0, rpmA - 2.0); // KERS jarrutus\
            statusTag.innerText = "SIGMA_HANDOVER_ACTIVE";\
            statusTag.style.background = "#0088ff";\
        \} else \{\
            posA = posA * 0.92 + 280 * 0.08; \
            posB = posB * 0.95 + 200 * 0.05;\
            rpmA = groundRPM;\
            if (isSyncing) \{\
                rpmB = Math.min(groundRPM, rpmB + 3.8); // e-Sync\
                statusTag.innerText = "E-SYNC_SYNCHRONIZING";\
                statusTag.style.background = "#bd00ff";\
            \} else \{\
                rpmB = Math.max(0, rpmB - 2.0); // KERS jarrutus\
                statusTag.innerText = "DRIVE_A_STEADY_PULL";\
                statusTag.style.background = "#00ff88";\
            \}\
        \}\
\
        // UI P\'c4IVITYS\
        kmhEl.innerHTML = `$\{Math.floor(kmh)\} <span style="font-size:16px; color:#444;">km/h</span>`;\
        boostFill.style.width = (currentTurbo / 3 * 100) + "%";\
        boostVal.innerText = currentTurbo.toFixed(2) + " BAR";\
        saveVal.innerHTML = `$\{savedEur.toFixed(2)\} <span style="font-size:16px; color:#00ff88;">\'80</span>`;\
\
        // --- VISUALISOINTI ---\
        // Tie\
        ctx.fillStyle = "#1a1a1a";\
        for(let i=0; i<40; i++) \{\
            let x = (i * 40 - (frame * (kmh*0.35)) % 40);\
            ctx.fillRect(x, 315, 25, 2);\
        \}\
