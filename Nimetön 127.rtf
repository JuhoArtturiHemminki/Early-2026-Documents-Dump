    const boostFill = document.getElementById('boost-fill');\
    const boostVal = document.getElementById('boost-val');\
    const saveVal = document.getElementById('save-val');\
    const statusTag = document.getElementById('status-tag');\
\
    let kmh = 0, frame = 0, savedEur = 0;\
    let posA = 280, posB = 200; \
    let rpmA = 0, rpmB = 0;\
    let rotA = 0, rotB = 0;\
    let turboTarget = 2.45; // Vakaa tavoitepaine\
\
    function draw() \{\
        requestAnimationFrame(draw);\
        frame++;\
        ctx.clearRect(0, 0, canvas.width, canvas.height);\
\
        // --- LIIKE- JA KIIHDYTYSFYSIIKKA ---\
        if (kmh < 115) \{\
            kmh += 0.05;\
            savedEur += 0.0012; // S\'e4\'e4st\'f6 kiihtyy tasaisen paineen ansiosta\
