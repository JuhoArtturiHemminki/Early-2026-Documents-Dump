\f0\fs24 \cf0 (function() \{\
    const stage = document.createElement('div');\
    stage.style = "position:fixed;top:0;left:0;width:100vw;height:100vh;background:#0d0d0d;z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:'Inter', sans-serif;overflow:hidden;color:#e0e0e0;";\
    stage.innerHTML = `\
        <div style="width:1000px; padding:20px; background:#151515; border-radius:15px; box-shadow:0 20px 50px rgba(0,0,0,0.5); border:1px solid #222;">\
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid #333; padding-bottom:15px;">\
