\
            ctx.rotate(rot * Math.PI / 180);\
            ctx.beginPath(); ctx.arc(0, 0, 34, 0, Math.PI * 2);\
            ctx.fillStyle = "#080808"; ctx.fill();\
            ctx.strokeStyle = active ? color : "#222"; ctx.lineWidth = 5; ctx.stroke();\
            \
            // Vanteet\
            ctx.strokeStyle = "#151515";\
            for(let i=0; i<5; i++) \{\
                ctx.rotate(Math.PI*2/5); ctx.beginPath(); ctx.moveTo(0,0); ctx.lineTo(0,30); ctx.stroke();\
            \}\
            ctx.restore();\
            \
            ctx.fillStyle = active ? color : "#444";\
            ctx.font = "900 11px Inter"; ctx.textAlign = "center";\
            ctx.fillText(label, x, y - 48);\
            ctx.font = "400 10px monospace";\
            ctx.fillText(Math.floor(rpm) + " RPM", x, y + 55);\
        \};\
