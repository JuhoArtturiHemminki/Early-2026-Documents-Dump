                let serialized = serde_json::to_vec(&fact).unwrap();\
                let compressed = encode_all(&serialized[..], 3).unwrap();\
                tx.execute("INSERT OR REPLACE INTO neural_vault (subject, data) VALUES (?1, ?2)", params![key, compressed])?;\
