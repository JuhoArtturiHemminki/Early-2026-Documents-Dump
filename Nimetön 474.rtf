    #[target_feature(enable = "avx2")]\
    unsafe fn verify_parity_avx2(&self, data: &[u64; 8]) -> bool \{\
        use std::arch::x86_64::*;\
        let v1 = _mm256_loadu_si256(data[0..].as_ptr() as *const __m256i);\
        let v2 = _mm256_loadu_si256(data[4..].as_ptr() as *const __m256i);\
        let res_v = _mm256_xor_si256(v1, v2);\
        \
        let low = _mm256_castsi256_si128(res_v);\
        let high = _mm256_extracti128_si256(res_v, 1);\
        let final_128 = _mm_xor_si128(low, high);\
        \
        let mut temp = [0u64; 2];\
        _mm_storeu_si128(temp.as_mut_ptr() as *mut __m128i, final_128);\
        (temp[0] ^ temp[1]) == 0\
    \}\
\
    fn verify_parity_scalar(&self, data: &[u64; 8]) -> bool \{\
        (data[0..4].iter().fold(0, |a, &x| a ^ x) ^ \
         data[4..8].iter().fold(0, |a, &x| a ^ x)) == 0\
    \}\
\
    pub fn check_drift(&self, d_n: f64, d_prev: f64, threshold: f64) -> bool \{\
        (d_n - d_prev).abs() * PHI > threshold\
    \}\
\}\
}