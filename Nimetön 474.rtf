\
const P1: u64 = 157;\
const P2: u64 = 311;\
const PHI: f64 = 1.618033988749895;\
\
#[repr(align(32))]\
pub struct VAxion512 \{\
    anchor_ka: [u8; 64],\
    lut_error_pos: [u16; 1024],\
\}\
\
impl VAxion512 \{\
    pub fn new(anchor: [u8; 64]) -> Self \{\
        let mut lut = [0u16; 1024];\
        for i in 0..1024 \{\
            lut[i] = ((i as f64 * PHI).fract() * 512.0) as u16;\
        \}\
        VAxion512 \{\
            anchor_ka: anchor,\
            lut_error_pos: lut,\
        \}\
    \}\
\
    pub fn state_recovery(&self, m_in: [u64; 8], f_clk: u64) -> [u64; 8] \{\
        #[cfg(target_arch = "x86_64")]\
        \{\
            if is_x86_feature_detected!("avx2") \{\
                return unsafe \{ self.state_recovery_avx2(m_in, f_clk) \};\
            \}\
        \}\
        self.state_recovery_scalar(m_in, f_clk)\
    \}\
\
    #[target_feature(enable = "avx2")]\
    unsafe fn state_recovery_avx2(&self, m_in: [u64; 8], f_clk: u64) -> [u64; 8] \{\
        use std::arch::x86_64::*;\
        let delta_p = (f_clk * P1) % P2;\
        let shift_val = (delta_p % 64) as i64;\
        let mut out = [0u64; 8];\
\
        if shift_val == 0 \{\
            for i in (0..8).step_by(4) \{\
                let m_vec = _mm256_loadu_si256(m_in[i..].as_ptr() as *const __m256i);\
                let k_vec = _mm256_load_si256(self.anchor_ka[i * 8..].as_ptr() as *const __m256i);\
                let res = _mm256_xor_si256(m_vec, k_vec);\
                _mm256_storeu_si256(out[i..].as_mut_ptr() as *mut __m256i, res);\
            \}\
            return out;\
        \}\
\
        let shift = _mm_cvtsi64_si128(shift_val);\
        let shift_inv = _mm_cvtsi64_si128(64 - shift_val);\
\
        for i in (0..8).step_by(4) \{\
            let m_vec = _mm256_loadu_si256(m_in[i..].as_ptr() as *const __m256i);\
            let k_vec = _mm256_load_si256(self.anchor_ka[i * 8..].as_ptr() as *const __m256i);\
            \
            let rotated = _mm256_or_si256(\
                _mm256_srl_epi64(m_vec, shift),\
                _mm256_sll_epi64(m_vec, shift_inv)\
            );\
            \
            let res = _mm256_xor_si256(rotated, k_vec);\
            _mm256_storeu_si256(out[i..].as_mut_ptr() as *mut __m256i, res);\
        \}\
        out\
    \}\
\
    fn state_recovery_scalar(&self, m_in: [u64; 8], f_clk: u64) -> [u64; 8] \{\
        let delta_p = (f_clk * P1) % P2;\
        let mut s_sync = [0u64; 8];\
        for i in 0..8 \{\
            let k_a_part = u64::from_le_bytes(self.anchor_ka[i*8..(i+1)*8].try_into().unwrap());\
            s_sync[i] = (m_in[i].rotate_right(delta_p as u32)) ^ k_a_part;\
        \}\
        s_sync\
    \}\
\
    pub fn ghost_fold_correction(&self, s_rec: &mut [u64; 8], g_obs: u64, g_exp: u64) -> bool \{\
