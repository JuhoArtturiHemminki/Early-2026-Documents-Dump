    pub fn new(size: usize) -> Self \{\
        let align = if cfg!(target_arch = "x86_64") \{ 2<<20 \} else \{ 64 \};\
        let layout = alloc::Layout::from_size_align(size, align).unwrap();\
        let ptr = unsafe \{\
            let p = alloc::alloc(layout);\
            if p.is_null() \{ alloc::handle_alloc_error(layout); \}\
            #[cfg(target_os = "linux")] \{\
