        let fact: Fact = db.query_row("SELECT data FROM neural_vault WHERE subject = ?1", params![key], |row| \{\
            let comp: Vec<u8> = row.get(0)?;\
            Ok(serde_json::from_slice(&decode_all(&comp[..]).unwrap()).unwrap())\
