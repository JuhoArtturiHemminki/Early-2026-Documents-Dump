\f3\fs26 \cf0 import time\
import math\
\
class SSOD_Master_ECU_v8:\
    """ \
    SIGMA-SYNC ORBITAL DRIVE (SSOD) - MASTER ECU LOGIC v8.0 \
    Inertian hallinta, KERS-jarrutus 0 RPM:\'e4\'e4n ja mekaaninen turvallisuus.\
    """\
    def __init__(self):\
        # --- TEKNISET VAKIOT ---\
        self.R_nominal = 0.51            # Renkaan s\'e4de (m)\
        self.J_axle = 12.5               # Akseliston hitausmomentti (kg*m^2)\
        self.clutch_overlap_ms = 150     # Momentin ristiinajoaika (ms)\
        self.phi_threshold = 0.02        # Synkronointitarkkuus (2%)\
        \
        # --- J\'c4RJESTELM\'c4N TILA ---\
        self.axle_active = "A"           # Maassa (DRIVE)\
        self.axle_standby = "B"          # Ilmassa (STANDBY)\
        self.v_gps = 0.0                 # Nopeus CAN-v\'e4yl\'e4st\'e4 (km/h)\
        self.k_abs = 1.0                 # Tienpinnan kitkakerroin\
\
    def calculate_phi(self, standby_rpm, current_r):\
        """ Phi = ABS( (V_gps * K_abs) - (Omega_axleB * R_dynamic) ) """\
        v_mps = (self.v_gps / 3.6) * self.k_abs\
        omega_standby = (standby_rpm * 2 * math.pi) / 60\
        return abs(v_mps - (omega_standby * current_r))\
\
    def execute_sigma_shift(self, speed, gear, load_kg, psi):\
        self.v_gps = speed\
        current_r = self.R_nominal * (1 - (0.00001 * load_kg / psi))\
        \
        print(f"\\n[ECU] Vaihtosekvenssi aloitettu: Vaihde \{gear\}")\
\
        # 1. e-SYNC: Kiihdytet\'e4\'e4n akselisto 0 RPM -> Tie-nopeus\
        target_v_mps = self.v_gps / 3.6\
        target_rpm = (target_v_mps / current_r) * 60 / (2 * math.pi)\
        print(f"[e-Sync] Kiihdytet\'e4\'e4n \{self.axle_standby\} nopeuteen \{int(target_rpm)\} RPM")\
        self._set_motor_pwm(self.axle_standby, target_rpm)\
\
        # 2. Synkronointi-silmukka (Odottaa Phi-indeksin t\'e4sm\'e4yst\'e4)\
        while self.calculate_phi(target_rpm, current_r) > self.phi_threshold:\
            time.sleep(0.001) \
\
        # 3. TURVA- JA MOMENTINSIIRTO (The Sigma Move)\
        if self._check_mechanical_interlock():\
            self._set_hydraulics(self.axle_standby, "ALAS")\
            \
            # Momentin ristiinajo (Handover) 150ms\
            steps = 20\
            dt = (self.clutch_overlap_ms / steps) / 1000\
            for i in range(steps + 1):\
                pwr_off, pwr_on = 1.0 - (i/steps), i/steps\
                self._set_clutch_pwm(self.axle_active, pwr_off)\
                self._set_clutch_pwm(self.axle_standby, pwr_on)\
                time.sleep(dt)\
\
            # 4. KERS RECOVERY: Nostetaan akseli ja jarrutetaan 0 RPM:\'e4\'e4n\
            self._set_hydraulics(self.axle_active, "YL\'d6S")\
            print(f"[KERS] Jarrutetaan \{self.axle_active\} 0 RPM:\'e4\'e4n. Ker\'e4t\'e4\'e4n energiaa.")\
            self._engage_generator_mode(self.axle_active, target_rpm=0)\
\
            # 5. Roolien vaihto\
            self.axle_active, self.axle_standby = self.axle_standby, self.axle_active\
            print(f"[SUCCESS] Vaihto valmis. Momentti s\'e4ilytetty.")\
