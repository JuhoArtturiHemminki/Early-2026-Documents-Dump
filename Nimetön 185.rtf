\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
#include <atomic>\
#include <cstdint>\
\
class SSOD_Diesel_ECU_Master \{\
private:\
    std::atomic<float> VEHICLE_M\{1850.0f\};\
    std::atomic<float> dynamic_Cd\{0.24f\};\
    const float TIRE_R          = 0.330f;\
    const float RHO_SEA_LEVEL   = 1.225f;\
    const float dt              = 0.01f;\
\
    const float MAX_RAIL_BAR    = 2200.0f;\
    const float SMOKE_LIMIT_AFR = 17.5f;\
    float current_boost_bar     = 0.0f;\
    \
    enum HW4_Fault_Mask : uint32_t \{\
        NONE = 0,\
        SENSOR_SATURATION = 1 << 1,\
        THERMAL_ALERT = 1 << 2,\
        SMOKE_LIMIT_ACTIVE = 1 << 3\
    \};\
\
public:\
    struct ECUOutput \{\
        float fuel_rail_pressure_bar;\
        float vgt_vane_pos;\
        float requested_torque_nm;\
        float boost_pressure_bar_out;\
        uint32_t fault_mask;\
    \};\
\
    void update_physics_model(float actual_accel, float v, float engine_torque_nm, float pitch_rad) \{\
        if (v < 2.0f) return;\
        \
        float driving_force = engine_torque_nm * (9.0f / TIRE_R);\
        float gravity_f = VEHICLE_M.load() * 9.81f * std::sin(pitch_rad);\
        float aero_f = 0.5f * RHO_SEA_LEVEL * std::pow(v, 2) * (dynamic_Cd.load() * 2.22f);\
        float predicted_accel = (driving_force - gravity_f - aero_f) / VEHICLE_M.load();\
        \
        float error = actual_accel - predicted_accel;\
        VEHICLE_M.store(std::clamp(VEHICLE_M.load() + (error * 0.005f), 1500.0f, 2800.0f));\
    \}\
\
    ECUOutput execute_cycle(float throttle_pos, float v, float rpm, float pitch_rad, \
                            float air_temp_c, float actual_boost_in) \{\
        \
        ECUOutput out = \{0\};\
        uint32_t current_faults = NONE;\
        current_boost_bar = actual_boost_in; \
\
        float available_air_mass = 1.0f + current_boost_bar;\
        float max_safe_torque = available_air_mass * 450.0f;\
        float requested_torque = throttle_pos * 600.0f; \
\
        if (requested_torque > max_safe_torque) \{\
            requested_torque = max_safe_torque;\
            current_faults |= SMOKE_LIMIT_ACTIVE;\
        \}\
\
        out.requested_torque_nm = requested_torque;\
        out.vgt_vane_pos = std::clamp(1.0f - (throttle_pos * 0.9f), 0.1f, 0.95f);\
        out.fuel_rail_pressure_bar = std::clamp(400.0f + (out.requested_torque_nm * 3.0f), 400.0f, MAX_RAIL_BAR);\
\
        update_physics_model(v, v, out.requested_torque_nm, pitch_rad);\
        \
        out.boost_pressure_bar_out = current_boost_bar;\
        out.fault_mask = current_faults;\
\
        return out;\
    \}\
\};\
}