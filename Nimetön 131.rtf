\f3\fs26 \cf0 import can\
import time\
import math\
import logging\
\
# LOKITUS JA KONFIGURAATIO\
logging.basicConfig(level=logging.INFO, filename="ssod_final.log")\
\
class SSOD_Master_ECU:\
    def __init__(self):\
        # Fyysiset vakiot\
        self.R_NOMINAL = 0.512\
        self.PHI_THRESHOLD = 0.02\
        self.K_ABS = 1.0                # Oletuskitka (asvaltti)\
        self.CAN_ID_SPEED = 0x18FEF100  # J1939 Nopeusviesti\
        self.CAN_ID_MOTOR_B = 0x601      # Sigma-akseli (e-Sync)\
        self.CAN_ID_MOTOR_A = 0x600      # P\'e4\'e4akseli (KERS)\
        \
        try:\
            # Alustetaan CAN-v\'e4yl\'e4 500kbps nopeudella\
            self.bus = can.interface.Bus(channel='can0', bustype='socketcan', bitrate=500000)\
            logging.info("SSOD Master ECU Online. Kaavat integroitu.")\
        except Exception as e:\
            logging.error(f"CAN-virhe: \{e\}"); exit(1)\
\
        self.v_gps = 0.0\
        self.current_state = "STANDBY"\
\
    def read_telemetry(self):\
        """ Lukee ajoneuvon nopeustiedon v\'e4yl\'e4st\'e4 """\
        msg = self.bus.recv(0.01)\
        if msg and msg.arbitration_id == self.CAN_ID_SPEED:\
            raw_speed = (msg.data[7] << 8) | msg.data[6]\
            self.v_gps = raw_speed / 256.0 # km/h\
\
    def calculate_phi(self, motor_rpm, r_dynamic):\
        """ \
        Phi = ABS( (V_gps * K_abs) - (Omega_axleB * R_dynamic) )\
        Huom: Muunnetaan yksik\'f6t m/s.\
        """\
        v_mps = (self.v_gps / 3.6)\
        omega_axleB = (motor_rpm * 2 * math.pi) / 60\
        # Toteutetaan integroitu kaava\
        phi = abs( (v_mps * self.K_ABS) - (omega_axleB * r_dynamic) )\
        return phi\
\
    def execute_sigma_shift(self, load_kg, psi):\
        """ Suorittaa dynaamisen akselivaihdon """\
        logging.info("K\'e4ynnistet\'e4\'e4n Sigma-vaihto.")\
        self.current_state = "SYNCING"\
        \
        # Lasketaan dynaaminen s\'e4de: R_dynamic = R_nominal * (1 - (Load_coeff * Pressure_psi))\
        r_dynamic = self.R_NOMINAL * (1 - (0.00001 * load_kg / psi))\
        \
        # 1. e-SYNC: Kiihdytys\
        target_rpm = ( (self.v_gps / 3.6) / r_dynamic) * 60 / (2 * math.pi)\
        \
        while True:\
            # L\'e4hetet\'e4\'e4n invertterille kiihdytysk\'e4sky\
            sync_cmd = can.Message(arbitration_id=self.CAN_ID_MOTOR_B, data=[0x01, 0x90, 0, 0, 0, 0, 0, 0])\
            self.bus.send(sync_cmd)\
            \
            # Tarkistetaan synkronointi\
            if self.calculate_phi(target_rpm, r_dynamic) < self.PHI_THRESHOLD:\
                break\
            time.sleep(0.01)\
\
        # 2. HANDOVER: Lasketaan Sigma-akselisto ja nostetaan vanha\
        self.trigger_hydraulics("DOWN")\
        \
        # 3. KERS: Jarrutetaan vanha akseli nollaan energian ker\'e4\'e4miseksi\
        self.current_state = "KERS"\
        regen_cmd = can.Message(arbitration_id=self.CAN_ID_MOTOR_A, data=[0xFF, 0x10, 0, 0, 0, 0, 0, 0])\
        self.bus.send(regen_cmd)\
        \
        time.sleep(1.5) \
        self.current_state = "STANDBY"\
        logging.info("Vaihto valmis. Energia tallennettu.")\
\
    def trigger_hydraulics(self, action):\
        """ Ohjaa hydrauliventtiileit\'e4 GPIO-releiden kautta """\
        pass\
\
if __name__ == "__main__":\
    ecu = SSOD_Master_ECU()\
    while True:\
        ecu.read_telemetry()\
        if ecu.v_gps > 45 and ecu.current_state == "STANDBY":\
            # Esimerkkiarvot kuormalle ja paineelle\
            ecu.execute_sigma_shift(load_kg=8000, psi=120)\
        time.sleep(0.1)\
