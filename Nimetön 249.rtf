namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    \
    // Physical & Component Safety Limits\
    static constexpr int32_t MAX_SAFE_RAIL      = 2600 * FP_SCALE;\
    static constexpr int32_t THERMAL_CRITICAL   = 110 * FP_SCALE;\
    static constexpr int32_t EXHAUST_VALVE_LIMIT = 850 * FP_SCALE;\
    static constexpr int32_t TURBO_RPM_MAX      = 180000;\
    \
    // Calibration Constants\
    static constexpr uint32_t DAC_MAX           = 4095U;\
    static constexpr uint32_t BASE_INJECTOR_US  = 250U;\
    static constexpr uint32_t STOICH_LIMIT_US   = 180U;\
    static constexpr uint32_t DPF_REGEN_US      = 150U;\
    static constexpr uint32_t MAX_INJECTOR_US   = 4500U;\
    static constexpr uint32_t SCR_STD_RATIO     = 64;\
    \
    // System Integrity\
    static constexpr uint32_t STACK_MAGIC       = 0xDEADBEEF;\
    static constexpr uint64_t SW_CERT_ID        = 0x554C54494D415445ULL;\
    static constexpr uint32_t WDT_KICK_MAGIC    = 0xA5A5A5A5;\
    static constexpr int32_t APPS_MAX_AGING     = 80;\
    static constexpr int32_t KALMAN_MIN_P       = 50;\
    static constexpr uint8_t CAN_FIFO_SIZE      = 16;\
\
    enum class FaultLevel : uint8_t \{ NONE = 0, SOFT = 1, HARD = 2 \};\
\
    template<typename T> static constexpr T SafeClamp(T val, T min_v, T max_v) \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
    template<typename T> static constexpr T SafeAbs(T v) \{ return (v < 0) ? -v : v; \}\
    static inline uint32_t RotL(uint32_t x, int n) \{ return (x << n) | (x >> (32 - n)); \}\
    \
    static inline uint32_t GetVoltageOffset(uint32_t mv) \{\
        if (mv < 10000) return 120; // 10V\
        if (mv < 12000) return 80;  // 12V\
        if (mv < 14000) return 45;  // 14V (Nominal)\
        return 30;\
    \}\
\}\
