namespace ECU_Comm \{\
    struct CAN_Frame \{ uint32_t id; uint8_t d[8]; uint8_t len; \};\
    class TX_FIFO_Manager \{\
    private:\
        CAN_Frame m_buffer[ECU_Config::CAN_FIFO_SIZE];\
        uint8_t m_head = 0, m_tail = 0, m_count = 0;\
    public:\
        void Push(const CAN_Frame& f, bool prio) \{\
            if (prio && m_count == ECU_Config::CAN_FIFO_SIZE) m_tail = (m_tail + 1) % ECU_Config::CAN_FIFO_SIZE;\
            else if (m_count == ECU_Config::CAN_FIFO_SIZE) return;\
            m_buffer[m_head] = f;\
            m_head = (m_head + 1) % ECU_Config::CAN_FIFO_SIZE;\
            if (m_count < ECU_Config::CAN_FIFO_SIZE) m_count++;\
        \}\
        bool Pop(CAN_Frame& f) \{\
            if (m_count == 0) return false;\
            f = m_buffer[m_tail];\
            m_tail = (m_tail + 1) % ECU_Config::CAN_FIFO_SIZE;\
            m_count--;\
            return true;\
        \}\
    \};\
    class Universal_CAN_Driver \{\
    private:\
        static TX_FIFO_Manager m_fifo;\
    public:\
        static inline void Pack_And_Queue(const ECU_V17_Mercedes_Spec::Output& out) \{\
            CAN_Frame f = \{ 0x200, \{0,0,0,0,0,0,0,0\}, 8 \};\
            f.d[0] = static_cast<uint8_t>(out.rail_dac >> 8); f.d[1] = static_cast<uint8_t>(out.rail_dac & 0xFF);\
            f.d[2] = static_cast<uint8_t>(out.wdt_token >> 24); f.d[3] = static_cast<uint8_t>(out.wdt_token >> 16);\
            f.d[4] = static_cast<uint8_t>(out.wdt_token >> 8); f.d[5] = static_cast<uint8_t>(out.wdt_token & 0xFF);\
            f.d[6] = static_cast<uint8_t>(out.fault_lvl); f.d[7] = out.launch_active ? 0xBC : 0xAA;\
            m_fifo.Push(f, out.launch_active);\
            Process_Hardware_TX();\
        \}\
        static void Process_Hardware_TX() \{\
            CAN_Frame frame;\
            while(m_fifo.Pop(frame)) \{ /* Call Target HW CAN API */ \}\
        \}\
    \};\
    TX_FIFO_Manager Universal_CAN_Driver::m_fifo;\
\}\
