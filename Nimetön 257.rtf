\
namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    \
    static constexpr int32_t MAX_SAFE_RAIL      = 2800 * FP_SCALE;\
    static constexpr int32_t EXHAUST_LIMIT      = 820 * FP_SCALE;\
    static constexpr int32_t TURBO_RPM_MAX_BASE = 195000;\
    \
    static constexpr uint32_t PILOT_INJ_US      = 120U;\
    static constexpr uint32_t POST_INJ_US       = 80U;\
    static constexpr uint32_t DAC_MAX           = 4095U;\
    static constexpr uint32_t STACK_MAGIC       = 0xDEADBEEF;\
    static constexpr uint64_t SW_CERT_ID        = 0x554C54494D415445ULL;\
    static constexpr uint32_t WDT_KICK_MAGIC    = 0xA5A5A5A5;\
    \
    static constexpr uint8_t  BLACKBOX_SIZE     = 100;\
    static constexpr uint8_t  CYLINDER_COUNT    = 4;\
    static constexpr int32_t  TQ_TO_RAIL_COEFF  = 640;\
\
    template<typename T> static constexpr T SafeClamp(T val, T min_v, T max_v) noexcept \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
\}\
\
class ECU_Core_Engine \{\
public:\
    struct Output \{\
        uint32_t rail_dac, main_inj_us[ECU_Config::CYLINDER_COUNT];\
        uint32_t pilot_inj_us, post_inj_us;\
        bool bypass_active, guardian_active, anti_jerk_active;\
        uint16_t dtc_code; const char *diag_msg;\
        uint32_t wdt_token;\
    \};\
\
private:\
    uint64_t m_cycle_count = 0;\
    int32_t m_exhaust_model = 20 * ECU_Config::FP_SCALE;\
    int32_t m_smooth_thr = 0, m_prev_target_tq = 0, m_prev_rpm = 0;\
    int32_t m_zqc_offset[ECU_Config::CYLINDER_COUNT] = \{0, 2, -1, 1\};\
    int32_t m_anti_jerk_buffer = 0;\
    \
    struct LogEntry \{ uint32_t cycle; int32_t rpm; uint16_t dtc; \} m_blackbox[ECU_Config::BLACKBOX_SIZE];\
    uint8_t m_bb_idx = 0;\
    bool m_bb_locked = false;\
\
    inline int32_t ApplyAntiJerk(int32_t current_tq, int32_t rpm_delta) noexcept \{\
        int32_t correction = (rpm_delta * 12) >> 4; \
        m_anti_jerk_buffer = (m_anti_jerk_buffer * 7 + correction) >> 3;\
        return current_tq - m_anti_jerk_buffer;\
    \}\
\
    inline int32_t ApplyDashpot(int32_t target, int32_t prev) noexcept \{\
        if (target < prev - 50) return prev - 15;\
        return target;\
    \}\
\
public:\
    Output step(int32_t a1, int32_t a2, int32_t rpm, int32_t temp, uint32_t bat_mv, int32_t ambient_hpa) noexcept \{\
        Output out = \{0, \{0\}, 0, 0, false, false, false, false, 0, "SYSTEM OK", 0\};\
        m_cycle_count++;\
\
        if (*(volatile uint32_t*)&ECU_Config::STACK_MAGIC != 0xDEADBEEF) \{\
            out.bypass_active = true; out.rail_dac = 750;\
            for(int i=0; i<ECU_Config::CYLINDER_COUNT; ++i) out.main_inj_us[i] = 380;\
            out.dtc_code = 0x0606; out.diag_msg = "CRITICAL MEMORY FAILURE - EMERGENCY BYPASS";\
            return out;\
        \}\
\
        int32_t alt_factor = ECU_Config::SafeClamp(ambient_hpa, 600, 1013);\
        int32_t dynamic_turbo_max = (ECU_Config::TURBO_RPM_MAX_BASE * alt_factor) / 1013;\
\
        int32_t raw_thr = (a1 + a2) >> 1;\
        m_smooth_thr += (ECU_Config::SafeClamp(raw_thr, 0, 1024) - m_smooth_thr) >> 3;\
        \
        int32_t rpm_delta = rpm - m_prev_rpm;\
        int32_t target_tq = (static_cast<int64_t>(m_smooth_thr) * ECU_Config::TQ_TO_RAIL_COEFF) >> 10;\
        \
        target_tq = ApplyDashpot(target_tq, m_prev_target_tq);\
        target_tq = ApplyAntiJerk(target_tq, rpm_delta);\
        \
        m_exhaust_model += (target_tq / 40) - (m_exhaust_model / 180);\
        if (temp < 60 * ECU_Config::FP_SCALE) target_tq = (target_tq * 700) >> 10;\
\
        uint32_t v_corr = (bat_mv < 13000) ? 60 : 20;\
        out.pilot_inj_us = ECU_Config::PILOT_INJ_US;\
        \
        for(int i=0; i < ECU_Config::CYLINDER_COUNT; ++i) \{\
            out.main_inj_us[i] = ECU_Config::SafeClamp<int32_t>(target_tq + v_corr + m_zqc_offset[i], 0, 4500);\
        \}\
\
        int32_t rail_press = (target_tq * 3) + 450 * ECU_Config::FP_SCALE;\
        out.rail_dac = ECU_Config::SafeClamp<uint32_t>((static_cast<uint64_t>(rail_press) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL, 0, 4095);\
\
        if (m_exhaust_model > ECU_Config::EXHAUST_LIMIT || (target_tq * 180) > dynamic_turbo_max) \{\
            out.guardian_active = true;\
            for(int i=0; i<ECU_Config::CYLINDER_COUNT; ++i) out.main_inj_us[i] >>= 1;\
            out.dtc_code = 0x0217; out.diag_msg = "OVERHEATING OR TURBO LIMIT - POWER REDUCED";\
            m_bb_locked = true;\
        \}\
\
        if (!m_bb_locked) \{\
            m_blackbox[m_bb_idx % ECU_Config::BLACKBOX_SIZE] = \{ static_cast<uint32_t>(m_cycle_count), rpm, out.dtc_code \};\
            m_bb_idx++;\
        \}\
\
        m_prev_rpm = rpm; m_prev_target_tq = target_tq;\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ static_cast<uint32_t>(m_cycle_count);\
        return out;\
    \}\
\};\
\
static_assert(sizeof(ECU_Core_Engine) <= 2048, "SRAM Limit Exceeded");\
}