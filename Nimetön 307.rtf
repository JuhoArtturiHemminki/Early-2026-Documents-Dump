\
/// T\'e4ydellinen 10/10: Estet\'e4\'e4n nollalla jako ilman k\'e4\'e4nt\'e4j\'e4n generomia tarkistuksia.\
/// K\'e4ytet\'e4\'e4n eksplisiittist\'e4 haaroitusta, joka on optimoitu prosessorin 'branch predictionille'.\
#[inline(always)]\
fn safe_divide_f32(numerator: f32, denominator: f32, fallback: f32) -> f32 \{\
    // DO-178C vaatii, ett\'e4 nollalla jako on mahdoton.\
    // Tarkistetaan epsilon-alueen sijaan absoluuttinen nolla ja NaN.\
    if denominator > 1e-9 || denominator < -1e-9 \{\
        numerator / denominator\
    \} else \{\
        fallback\
    \}\
\}\
\
impl CoreMatrix \{\
    /// Laskee tilan muutoksen ilman yht\'e4k\'e4\'e4n mahdollista panic-pistett\'e4.\
    /// Kaikki operaatiot on suojattu k\'e4\'e4nt\'e4j\'e4n implisiittisilt\'e4 tarkistuksilta.\
    pub fn step(&mut self, rpm: Rpm, load: Load, dt: Seconds, temp: Celsius, baro: HPa) -> Ms \{\
        // Suoritetaan calculate ja k\'e4sitell\'e4\'e4n virhe ilman dynaamista palautetta (Limp Home).\
        // T\'e4m\'e4 rakenne takaa vakion pino-syvyyden (Constant Stack Depth).\
        match self.calculate(rpm, load, dt, temp, baro) \{\
            Ok(val) => val,\
            Err(_) => \{\
                self.integral_sum = 0.0; // Nollaus vikatilanteessa (Anti-Windup Recovery)\
                Ms(K_LIMP_HOME_VAL)\
            \}\
        \}\
    \}\
\
    fn calculate(&mut self, rpm: Rpm, load: Load, dt: Seconds, temp: Celsius, baro: HPa) \
        -> Result<Ms, SystemError> \
    \{\
        // 1. INPUT VALIDIOINTI (Eksplisiittinen MC/DC-kattavuus)\
        if baro.0 < 200.0 || baro.0 > 1200.0 \{ return Err(SystemError::SensorFailure); \}\
        if !rpm.0.is_finite() \{ return Err(SystemError::SensorFailure); \}\
\
        let d_t_raw = dt.ensure_safe_step();\
        let pressure_pa = baro.to_pa();\
        let temp_k: Kelvin = temp.into();\
\
        // 2. DIMENSIONAALINEN FYSIIKKA (Nolla-suojattu)\
        let safe_temp_k = if temp_k.0 < 10.0 \{ 10.0 \} else \{ temp_k.0 \};\
        let rho = KgM3(pressure_pa.0 / (R_SPECIFIC_AIR * safe_temp_k));\
        \
        let env_corr_raw = rho.0 / STD_AIR_DENSITY;\
        let env_corr = saturate_f32(env_corr_raw, 0.1, 3.0);\
\
        // 3. TRANSIENTTIEN MALLINNUS (FMA-determinismi)\
        let p_state = rpm.0.mul_add(K_STATE_RPM_SENSITIVITY, load.0 * K_VE_BASE_SCALE) * env_corr;\
        let raw_delta = p_state - self.prev_input;\
        \
        // Estet\'e4\'e4n kaskadi-virheet NaN-arvoilla\
        self.filtered_delta = if raw_delta.is_finite() \{\
            raw_delta.mul_add(K_FILTER_ALPHA, K_FILTER_BETA * self.filtered_delta)\
        \} else \{\
            0.0\
        \};\
\
        // 4. VIRTAUS JA SYTYTYS (K\'e4ytt\'e4en safe_divide)\
        let safe_rpm = if rpm.0.abs() < 1.0 \{ 1.0 \} else \{ rpm.0.abs() \};\
        let flow_raw = (load.0.abs() * K_FLOW_CONST * env_corr);\
        let flow = safe_divide_f32(flow_raw, safe_rpm * 0.001, 0.0);\
        \
        let ign_vector = rpm.0.mul_add(K_IGN_RPM_SCALER, K_IGN_BASE_ADVANCE - (flow * K_IGN_FLOW_RETARD));\
\
        // 5. ATOMINEN ANTI-WINDUP (Eksplisiittinen kontrollivirta)\
        let v_inst_raw = (flow * ign_vector) * safe_divide_f32(self.filtered_delta, d_t_raw, 0.0);\
        let v_inst = saturate_f32(v_inst_raw, -500.0, 500.0);\
        \
        self.integral_sum = apply_anti_windup_mc_dc(self.integral_sum, v_inst, d_t_raw);\
        \
        // P\'c4IVITYS\
        self.state_est = (p_state - self.state_est).mul_add(K_LEARNING_GAIN, self.state_est);\
        self.prev_input = p_state;\
\
        // Deterministinen IEEE-754 tarkistus ilman ulkoisia kirjastoja\
        if self.integral_sum == self.integral_sum \{\
            Ok(Ms(self.integral_sum))\
        \} else \{\
            Err(SystemError::MathInstability)\
        \}\
    \}\
\}\
