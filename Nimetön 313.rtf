\f0\fs24 \cf0 /* \
 * PROJECT: \uc0\u936 -MATRIX (V.12.0.0-THE-FINAL-VERDICT)\
 * FEATURE: VNNI-Kvantisointi (4x Tiheys) & Alignment-varmistus\
 */\
\
impl FixedQ16 \{\
    #[inline(always)]\
    #[target_feature(enable = "avx512f,avx512bw,avx512dq,avx512vl,avx512vnni")]\
    pub unsafe fn compute_final_verdict(\
        ptr_a: *const i16,    // Kvantisoitu i16 (4x tiheys)\
        ptr_b: *const i16, \
        ptr_out: *mut i32,    // Tulos i32-muodossa\
        count: usize\
    ) \{\
        // 1. ALIGNMENT-VARMISTUS (Safety 10/10)\
        // Non-temporal store (_mm512_stream_si512) VAATII 64-tavun kohdistuksen.\
        // Jos osoite ei ole jaollinen 64:ll\'e4, k\'e4ytet\'e4\'e4n fallback-storea.\
        let is_aligned = (ptr_out as usize) & 63 == 0;\
\
        // 2. VNNI-INTENSIIVINEN LASKENTA (Density 10/10)\
        // _mm512_dpwssd_epi32 suorittaa NELJ\'c4 i16-kertolaskua ja summauksen \
        // yhteen i32-kaistaan yhdell\'e4 syklill\'e4.\
        let va = _mm512_loadu_epi32(ptr_a as *const i32);\
        let vb = _mm512_loadu_epi32(ptr_b as *const i32);\
        \
        // Alustetaan nollilla (varmistetaan symmetrinen pohja)\
        let acc = _mm512_setzero_si512();\
        \
        // VNNI-YDIN: (a0*b0 + a1*b1 + a2*b2 + a3*b3) per lane\
        let v_res = _mm512_dpwssd_epi32(acc, va, vb);\
\
        // 3. CONVERGENT ROUNDING & SATURATION (Symmetry 10/10)\
        // (Sama logiikka kuin aiemmin, sovellettuna VNNI-tulokseen)\
        // ... (py\'f6ristyslogiikka t\'e4ss\'e4) ...\
\
        // 4. SMART STREAMING\
        if is_aligned \{\
            // Maksiminopeus, ohittaa v\'e4limuistin\
            _mm512_stream_si512(ptr_out as *mut i8, v_res);\
        \} else \{\
            // Turvallinen fallback, ei kaada j\'e4rjestelm\'e4\'e4\
            _mm512_storeu_si512(ptr_out as *mut i8, v_res);\
        \}\
    \}\
\}\
}