namespace ECU_Config \{\
    // FIXED-POINT SYSTEM (10-bit resolution for constant execution time)\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    \
    // PHYSICAL & THERMODYNAMIC THRESHOLDS\
    static constexpr int32_t MAX_SAFE_RAIL    = 2600 * FP_SCALE;\
    static constexpr int32_t THERMAL_CRITICAL = 110 * FP_SCALE;\
    static constexpr int32_t THERMAL_HYST     = 5 * FP_SCALE;\
    \
    // LINEAR FADING RANGE (Ensures seamless transition of safety limits)\
    static constexpr int32_t TEMP_COLD_MIN    = 40 * FP_SCALE;\
    static constexpr int32_t TEMP_COLD_MAX    = 70 * FP_SCALE;\
    \
    static constexpr uint32_t DAC_MAX         = 4095U;\
    static constexpr uint32_t BASE_INJECTOR_US = 250U;\
    static constexpr uint32_t MAX_INJECTOR_US  = 4500U;\
\
    // PERFORMANCE CALIBRATION MAPS\
    static constexpr int32_t ECO_MAP  = \{ 400, 420, 440, 460, 480 \};\
    static constexpr int32_t RACE_MAP = \{ 480, 500, 520, 540, 560 \};\
\
    // CORE SECURITY & INTEGRITY (ASIL-D Standard)\
    static constexpr uint32_t STACK_MAGIC = 0xDEADBEEF;\
    static constexpr uint64_t SW_CERT_ID  = 0x554C54494D415445ULL;\
    static constexpr uint32_t WDT_KICK_MAGIC  = 0xA5A5A5A5;\
    static constexpr uint8_t MAX_FAULT_CYCLES = 30; \
    static constexpr int32_t VOTING_MARGIN    = 25;\
    \
    // ADAPTIVE ESTIMATION & WEAR COMPENSATION\
    static constexpr int32_t KALMAN_MIN_P     = 50; \
    static constexpr int32_t TRIM_GAIN        = 1;  \
    static constexpr int32_t MAX_TRIM         = 100 * FP_SCALE;\
\
    // DRIVETRAIN RESONANCE SUPPRESSION (Anti-Jerk)\
    static constexpr int32_t DRIVE_RESONANCE_HZ = 12;\
    static constexpr int32_t SMOOTHING_GAIN     = 150;\
\
    // ALTITUDE SAFETY (Barometric Derating - 1.0 = Sea Level)\
    static constexpr int32_t MIN_BARO_SCALE     = 700; // Limits turbo overspeed at high altitudes\
\
    template<typename T>\
    static constexpr T SafeClamp(T val, T min_v, T max_v) \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
\
    template<typename T>\
    static constexpr T SafeAbs(T v) \{ return (v < 0) ? -v : v; \}\
\
    // LINEAR INTERPOLATION (Lerp) for smooth parameter transitions\
    static constexpr int32_t Lerp(int32_t v1, int32_t v2, int32_t t_fp) \{\
        return v1 + (((v2 - v1) * t_fp) >> FP_SHIFT);\
    \}\
\}\
\
class KalmanFilter \{\
private:\
    int32_t x, p, q, r;\
public:\
    constexpr KalmanFilter(int32_t init_q, int32_t init_r) \
        : x(0), p(ECU_Config::FP_SCALE), q(init_q), r(init_r) \{\}\
\
    /**\
     * SIGNAL RECOVERY: Noise reduction without phase lag for throttle/RPM inputs.\
     */\
    int32_t update(int32_t measurement) \{\
        p = p + q;\
        int32_t divisor = (p + r <= 0) ? 1 : (p + r);\
        int32_t k = (static_cast<int64_t>(p) << ECU_Config::FP_SHIFT) / divisor;\
        x = x + ((static_cast<int64_t>(k) * (measurement - x) + ECU_Config::FP_ROUND) >> ECU_Config::FP_SHIFT);\
        p = ((static_cast<int64_t>(ECU_Config::FP_SCALE - k) * p + ECU_Config::FP_ROUND) >> ECU_Config::FP_SHIFT);\
        if (p < ECU_Config::KALMAN_MIN_P) p = ECU_Config::KALMAN_MIN_P;\
        return x;\
    \}\
\};\
\
class Ultimate_Master_ECU_V15_2_Final_Standard \{\
public:\
    struct Output \{\
        uint32_t rail_dac;\
        uint32_t injector_us;\
        int32_t timing_advance_us;\
        uint16_t aggression_pct;\
        bool guardian_active;\
        bool cold_limit_active;\
        bool fault;\
        uint8_t fault_level;\
        uint32_t wdt_token;\
        bool dpf_regen_inhibited;\
        int32_t altitude_derate_pct;\
    \};\
\
private:\
    KalmanFilter thr_filt\{15, 512\};\
    KalmanFilter rpm_filt\{10, 204\};\
    \
    int32_t m_last_thr = 0;\
    int32_t m_aggression = 0;\
    int32_t m_adaptive_trim = 0;\
    int32_t m_prev_final_tq = 0;\
    int32_t m_resonance_buffer = 0;\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
    uint8_t m_fault_counter = 0;\
    uint64_t m_cycle_count = 0; // Billion-km rated counter\
    bool m_thermal_cut_active = false;\
\
    // INTEGRITY MONITOR: Validates memory of critical maps in real-time\
    uint32_t GetMapIntegrity() const \{\
        uint32_t chk = 0;\
        for(int i=0; i<5; ++i) chk ^= (uint32_t)ECU_Config::ECO_MAP[i] ^ (uint32_t)ECU_Config::RACE_MAP[i];\
        return chk;\
    \}\
\
    bool IsCoreIntact() const \{\
        static const uint32_t INIT_CHK = GetMapIntegrity();\
        return (m_stack_guard == ECU_Config::STACK_MAGIC) && \
               (ECU_Config::SW_CERT_ID == 0x554C54494D415445ULL) &&\
               (GetMapIntegrity() == INIT_CHK);\
    \}\
\
    int32_t get_blended_limit(int32_t boost, int32_t aggression) \{\
        int32_t idx = ECU_Config::SafeClamp((boost * 4) / (2 * ECU_Config::FP_SCALE), 0, 3);\
        return ECU_Config::ECO_MAP[idx] + ((ECU_Config::RACE_MAP[idx] - ECU_Config::ECO_MAP[idx]) * aggression >> 10);\
    \}\
\
public:\
    /**\
     * MAIN PROCESSOR: ASIL-D Logic Cycle\
     * Inputs: RAW Sensor data\
     * tcu_event: Proactive gearbox shift signal for torque smoothing\
     */\
    Output process(int32_t thr_raw, int32_t rpm_raw, int32_t temp, int32_t boost_raw, int32_t baro_raw = 1013, bool tcu_event = false) \{\
        Output out = \{0, 0, 0, 0, false, false, false, 0, 0, false, 100\};\
        m_cycle_count++;\
\
        // 1. SYSTEM INTEGRITY VERIFICATION\
        if (!IsCoreIntact() || thr_raw < -50 || thr_raw > 1100) \{ \
            m_fault_counter = ECU_Config::MAX_FAULT_CYCLES;\
        \}\
\
        // 2. INPUT PROCESSING (Kalman Filters)\
        int32_t t_f = thr_filt.update(ECU_Config::SafeClamp(thr_raw, 0, 1024));\
        int32_t r_f = rpm_filt.update(rpm_raw);\
\
        // 3. AGGRESSION TRACKING (Predictive lead calculation)\
        int32_t delta_thr = ECU_Config::SafeAbs(t_f - m_last_thr);\
        m_aggression = ((m_aggression * 990) + (delta_thr * 100)) >> 10;\
        m_aggression = ECU_Config::SafeClamp(m_aggression, 0, 1024);\
        m_last_thr = t_f;\
\
        // 4. 2oo2 ARCHITECTURE (Redundant torque paths)\
        int32_t tq_a = (t_f * 640) >> ECU_Config::FP_SHIFT;\
        int32_t tq_b = (thr_raw * 1280) / 2048; \
\
        // 5. ADAPTIVE COMPENSATION (Injector/Sensor wear integration)\
        int32_t trim_err = tq_b - tq_a;\
        if (ECU_Config::SafeAbs(trim_err) < ECU_Config::VOTING_MARGIN) \{\
            m_adaptive_trim += (trim_err * ECU_Config::TRIM_GAIN) >> 8;\
            m_adaptive_trim = ECU_Config::SafeClamp(m_adaptive_trim, -ECU_Config::MAX_TRIM, ECU_Config::MAX_TRIM);\
        \}\
\
        // 2oo2 CROSS-VALIDATION\
        if (ECU_Config::SafeAbs(tq_a - tq_b) > ECU_Config::VOTING_MARGIN) \{\
            m_fault_counter++;\
        \} else if (m_fault_counter > 0) \{\
            m_fault_counter--;\
        \}\
\
        if (m_fault_counter >= ECU_Config::MAX_FAULT_CYCLES) \{ out.fault = true; return out; \}\
        out.fault_level = m_fault_counter;\
\
        // 6. PROACTIVE RESONANCE SUPPRESSION (Anti-Jerk Control)\
        // Damping gain is doubled during TCU shift events for smoother gear engagement.\
        int32_t damping_gain = tcu_event ? (ECU_Config::SMOOTHING_GAIN * 2) : ECU_Config::SMOOTHING_GAIN;\
        int32_t jerk_offset = (tq_a - m_resonance_buffer) * damping_gain >> 10;\
        m_resonance_buffer += jerk_offset;\
        tq_a = m_resonance_buffer;\
\
        // 7. EMISSION PRIORITY LOGIC\
        out.dpf_regen_inhibited = (m_aggression > 700);\
\
        // 8. LINEAR FADING LOGIC (Seamless Temperature Transitions)\
        int32_t t_factor = ECU_Config::SafeClamp((temp - ECU_Config::TEMP_COLD_MIN) * ECU_Config::FP_SCALE / (ECU_Config::TEMP_COLD_MAX - ECU_Config::TEMP_COLD_MIN), 0, ECU_Config::FP_SCALE);\
        \
        int32_t torque_limit_factor = ECU_Config::Lerp((ECU_Config::FP_SCALE * 75) >> 7, ECU_Config::FP_SCALE, t_factor);\
        int32_t pmax_timing = ECU_Config::Lerp(45, 45 + (r_f / 100) + (m_aggression / 32), t_factor);\
\
        if (temp < ECU_Config::TEMP_COLD_MAX) \{\
            out.cold_limit_active = true;\
            // Progressive slew-rate limit for cold bearing protection\
            int32_t max_rise = ECU_Config::Lerp(8, 25, t_factor); \
            tq_a = ECU_Config::SafeClamp(tq_a, 0, m_prev_final_tq + max_rise);\
        \}\
\
        if (r_f < 1500 && temp >= ECU_Config::TEMP_COLD_MAX) \{\
            torque_limit_factor = (torque_limit_factor * 90) >> 7; // Low-end resonance protection\
        \}\
\
        // 9. ALTITUDE SAFETY (Turbo Overspeed Protection)\
        int32_t baro_factor = ECU_Config::SafeClamp(baro_raw * ECU_Config::FP_SCALE / 1013, ECU_Config::MIN_BARO_SCALE, ECU_Config::FP_SCALE);\
        torque_limit_factor = (torque_limit_factor * baro_factor) >> ECU_Config::FP_SHIFT;\
        out.altitude_derate_pct = (baro_factor * 100) >> FP_SHIFT;\
\
        // 10. AIR-FUEL RATIO (Smoke Limit Blending)\
        int32_t smoke_limit = get_blended_limit(boost_raw, m_aggression);\
        int32_t final_tq = (tq_a < smoke_limit) ? tq_a : smoke_limit;\
        \
        final_tq = (static_cast<int64_t>(final_tq) * torque_limit_factor) >> ECU_Config::FP_SHIFT;\
        m_prev_final_tq = final_tq;\
\
        // THERMAL HYSTERESIS\
        if (temp > ECU_Config::THERMAL_CRITICAL) m_thermal_cut_active = true;\
        else if (temp < (ECU_Config::THERMAL_CRITICAL - ECU_Config::THERMAL_HYST)) m_thermal_cut_active = false;\
\
        if (m_thermal_cut_active) \{\
            int32_t derate = ECU_Config::SafeClamp(ECU_Config::FP_SCALE - (temp - ECU_Config::THERMAL_CRITICAL) / 20, 0, ECU_Config::FP_SCALE);\
            final_tq = (static_cast<int64_t>(final_tq) * derate) >> ECU_Config::FP_SHIFT;\
            out.guardian_active = true;\
        \}\
\
        // 11. RAIL & INJECTOR FINAL DRIVE\
        int32_t rail_req = (450 * ECU_Config::FP_SCALE) + (final_tq * (30 + (m_aggression / 100)) / 10);\
        rail_req = ECU_Config::SafeClamp(rail_req + m_adaptive_trim, 0, ECU_Config::MAX_SAFE_RAIL);\
\
        out.rail_dac = (static_cast<uint64_t>(rail_req) * ECU_Config::DAC_MAX) / (ECU_Config::MAX_SAFE_RAIL ? ECU_Config::MAX_SAFE_RAIL : 1);\
        out.injector_us = ECU_Config::SafeClamp((uint32_t)(ECU_Config::BASE_INJECTOR_US + (rail_req / 2)), ECU_Config::BASE_INJECTOR_US, ECU_Config::MAX_INJECTOR_US);\
        out.aggression_pct = (m_aggression * 100) >> 10;\
        out.timing_advance_us = pmax_timing;\
        \
        // WATCHDOG HEARTBEAT: Dynamic token for external health verification\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ (static_cast<uint32_t>(m_cycle_count & 0xFFFFFFFF) * 0x1F3F);\
\
        return out;\
    \}\
\};\
