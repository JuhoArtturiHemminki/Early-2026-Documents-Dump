\f0\fs24 \cf0 /**\
 * @file ASIL_D_Final_System_V3.cpp\
 * @brief Fully Integrated ISO 26262 ASIL-D Diesel Engine Control Unit.\
 * \
 * DESIGN PRINCIPLES:\
 * 1. Determinism: Fixed-point math (1024-based) & No dynamic loops.\
 * 2. Redundancy: 2oo2 Voting (Primary vs Diverse path).\
 * 3. Calibration: Lookup Table (LUT) based control (ASAM-compliant).\
 * 4. Safety: Stack guards, Signal Plausibility, and Windowed Watchdog.\
 */\
\
#include <cstdint>\
#include <algorithm>\
\
// --- TYPE DEFINITIONS ---\
typedef int32_t fixed_t;\
#define FP_SHIFT 10\
#define TO_FP(x) (static_cast<fixed_t>((x) * 1024))\
\
// --- CALIBRATION DATA (Lookup Tables) ---\
// In production, these are stored in a separate Read-Only Flash sector.\
struct Calibration \{\
    static constexpr uint16_t MAP_SIZE = 5;\
    \
    // Torque Request Map: Inputs are 0, 256, 512, 768, 1024 (Throttle %)\
    static const fixed_t TorqueMap[MAP_SIZE]; \
    \
    // Smoke Limiter Map: Based on Boost Pressure (bar)\
    static const fixed_t SmokeMap[MAP_SIZE];\
\
    static constexpr fixed_t MAX_SAFE_RAIL = TO_FP(2500); \
    static constexpr fixed_t MAX_THROTTLE_GRADIENT = 60; // Max change per 1ms\
    static constexpr uint32_t STACK_GUARD_VAL = 0xDEADBEEF;\
\};\
\
// Explicit initialization of maps\
const fixed_t Calibration::TorqueMap[5] = \{ 0, 180, 450, 800, 1100 \};\
const fixed_t Calibration::SmokeMap[5]  = \{ 400, 430, 460, 490, 520 \};\
\
class Diesel_ECU_Core \{\
private:\
    fixed_t last_throttle_input = 0;\
    uint32_t stack_sentinel = Calibration::STACK_GUARD_VAL;\
\
    /**\
     * @brief Linear Interpolation (Lerp)\
     * Finds the value between two points in a calibration map.\
     */\
    fixed_t interpolate(const fixed_t* table, fixed_t input, fixed_t input_max) \{\
        // Calculate index (0 to MAP_SIZE-1)\
        fixed_t raw_idx = (input * (Calibration::MAP_SIZE - 1)) / input_max;\
        uint16_t idx = static_cast<uint16_t>(raw_idx);\
\
        if (idx >= Calibration::MAP_SIZE - 1) return table[Calibration::MAP_SIZE - 1];\
\
        // Fractional part for interpolation\
        fixed_t fraction = (input * (Calibration::MAP_SIZE - 1)) % input_max;\
        fixed_t y0 = table[idx];\
        fixed_t y1 = table[idx + 1];\
\
        return y0 + ((y1 - y0) * fraction / input_max);\
    \}\
\
    /** @brief Diverse Path for 2oo2 Voting (Slightly different logic) */\
    fixed_t calculate_diverse_torque(fixed_t thr) \{\
        // Shifted logic to avoid compiler-level systematic errors\
        return (thr * 1100) / 1024;\
    \}\
\
public:\
    struct System_Status \{\
        uint32_t rail_pressure_dac;\
        uint32_t vgt_pwm;\
        bool critical_fault;\
    \};\
\
    /**\
     * @brief Core Execution Loop (Executed every 1ms)\
     */\
    System_Status execute_cycle(fixed_t throttle, fixed_t boost) \{\
        System_Status status = \{0, 500, false\};\
\
        // 1. MEMORY INTEGRITY CHECK\
        if (this->stack_sentinel != Calibration::STACK_GUARD_VAL) \{\
            status.critical_fault = true;\
            return status;\
        \}\
\
        // 2. INPUT PLAUSIBILITY (Signal Conditioning)\
        // Check for shorts, open circuits, or impossible physical jumps\
        if (throttle < 0 || throttle > 1024 || \
            std::abs(throttle - this->last_throttle_input) > Calibration::MAX_THROTTLE_GRADIENT) \{\
            status.critical_fault = true;\
            return status;\
        \}\
        this->last_throttle_input = throttle;\
\
        // 3. REDUNDANT TORQUE CALCULATION (ASIL-D 2oo2)\
        fixed_t torque_primary = interpolate(Calibration::TorqueMap, throttle, 1024);\
        fixed_t torque_diverse = calculate_diverse_torque(throttle);\
\
        // Cross-check: If paths diverge > 2%, trigger safety shutdown\
        if (std::abs(torque_primary - torque_diverse) > 25) \{\
            status.critical_fault = true;\
            return status;\
        \}\
\
        // 4. SMOKE LIMITER (Dynamic Lambda Control)\
        // Adjusts fueling based on available air (boost)\
        fixed_t smoke_coeff = interpolate(Calibration::SmokeMap, boost, TO_FP(2.5));\
        fixed_t smoke_limit = ((TO_FP(1) + boost) * smoke_coeff) >> FP_SHIFT;\
\
        // 5. ARBITRATION (Selection of the safest torque value)\
        fixed_t final_torque = std::min(torque_primary, smoke_limit);\
\
        // 6. OUTPUT MAPPING (Translating torque to rail pressure)\
        fixed_t target_rail = TO_FP(450) + (final_torque * 3);\
        if (target_rail > Calibration::MAX_SAFE_RAIL) target_rail = Calibration::MAX_SAFE_RAIL;\
\
        // Final Scaling for 12-bit DAC (0-4095)\
        status.rail_pressure_dac = static_cast<uint32_t>((target_rail * 4095) / (Calibration::MAX_SAFE_RAIL));\
        \
        // VGT (Turbo) control: Close vanes if boost is low to speed up spool\
        status.vgt_pwm = (boost < TO_FP(1.0)) ? 850 : 400;\
\
        return status;\
    \}\
\};\
\
// --- GLOBAL EXECUTION CONTEXT ---\
static Diesel_ECU_Core g_ecu_instance;\
\
/**\
 * @brief High-Priority Safety Interrupt (The Heartbeat)\
 */\
extern "C" void Safety_IRQ_Handler(void) \{\
    // A. Read Hardware Inputs (Virtualized)\
    fixed_t throttle_in = 850; // 83% throttle\
    fixed_t boost_in    = TO_FP(1.2); // 1.2 bar boost\
\
    // B. Run Logic\
    auto result = g_ecu_instance.execute_cycle(throttle_in, boost_in);\
\
    // C. Fail-Safe Gating\
    if (!result.critical_fault) \{\
        // Write to [Infineon AURIX](https://www.infineon.com)\
        // *RAIL_DAC_REG = result.rail_pressure_dac;\
        // *VGT_PWM_REG  = result.vgt_pwm;\
        \
        // Everything is green -> Service the Hardware Watchdog\
        // *WATCHDOG_SERVICE = 0xAAAA5555;\
    \} else \{\
        // EMERGENCY SHUTDOWN: Cut Fuel, Open Vanes\
        // *RAIL_DAC_REG = 0;\
        // *FUEL_PUMP_RELAY = 0;\
    \}\
\}\
}