namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    \
    static constexpr int32_t MAX_SAFE_RAIL    = 2600 * FP_SCALE;\
    static constexpr int32_t THERMAL_CRITICAL = 110 * FP_SCALE;\
    static constexpr int32_t THERMAL_HYST     = 5 * FP_SCALE;\
    static constexpr int32_t TEMP_COLD_THRESHOLD = 60 * FP_SCALE;\
    static constexpr uint32_t DAC_MAX         = 4095U;\
    static constexpr uint32_t BASE_INJECTOR_US = 250U;\
    static constexpr uint32_t MAX_INJECTOR_US  = 4500U;\
\
    static constexpr int32_t ECO_MAP[5]  = \{ 400, 420, 440, 460, 480 \};\
    static constexpr int32_t RACE_MAP[5] = \{ 480, 500, 520, 540, 560 \};\
\
    static constexpr uint32_t STACK_MAGIC = 0xDEADBEEF;\
    static constexpr uint64_t SW_CERT_ID  = 0x554C54494D415445ULL;\
    static constexpr uint32_t WDT_KICK_MAGIC  = 0xA5A5A5A5;\
    static constexpr uint8_t MAX_FAULT_CYCLES = 30; \
    static constexpr int32_t VOTING_MARGIN    = 25;\
    \
    static constexpr int32_t KALMAN_MIN_P     = 50;\
    static constexpr int32_t TRIM_GAIN        = 1;\
    static constexpr int32_t MAX_TRIM         = 100 * FP_SCALE;\
\
    static constexpr int32_t DRIVE_RESONANCE_HZ = 12;\
    static constexpr int32_t SMOOTHING_GAIN     = 150;\
