        Output out = \{0, 0, 0, 0, false, false, false, 0, 0, false\};\
        m_cycle_count++;\
\
        if (!IsCoreIntact() || thr_raw < -50 || thr_raw > 1100) \{ \
            m_fault_counter = ECU_Config::MAX_FAULT_CYCLES;\
        \}\
\
        int32_t t_f = thr_filt.update(ECU_Config::SafeClamp(thr_raw, 0, 1024));\
