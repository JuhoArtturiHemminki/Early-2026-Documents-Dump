\f1\b0 : Akselin py\'f6rimisnopeus noston hetkell\'e4.\
\ls4\ilvl0
\f0\b \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
Delta_t
\f1\b0 : Tavoiteltu jarrutusaika generaattorilla.\
\pard\pardeftab720\partightenfactor0
