pub struct PCIBus;\
impl PCIBus \{\
    unsafe fn read_config(bus: u8, slot: u8, func: u8, offset: u8) -> u32 \{\
        let address = ((bus as u32) << 16) | ((slot as u32) << 11) | ((func as u32) << 8) | (offset as u32 & 0xFC) | 0x80000000;\
        CitadelIO::outl(0xCF8, address);\
        CitadelIO::inl(0xCFC)\
    \}\
    pub unsafe fn probe_gpu() \{\
        for bus in 0..255 \{\
            for slot in 0..32 \{\
                let val = Self::read_config(bus, slot, 0, 0);\
                if val != 0xFFFFFFFF \{\
                    let class_rev = Self::read_config(bus, slot, 0, 0x08);\
                    if (class_rev >> 16) == 0x0300 \{\
                        let bar0 = Self::read_config(bus, slot, 0, 0x10);\
                        if bar0 != 0 \{\
                            GPU_BAR_ADDR.store(bar0 as usize & !0xF, Ordering::Release);\
                            DMA_READY.store(1, Ordering::Release);\
                        \}\
                    \}\
                \}\
            \}\
        \}\
    \}\
\}\
