pub struct AetherGPU;\
impl AetherGPU \{\
    pub unsafe fn fast_blit(src: *const u32, count: usize) \{\
        if DMA_READY.load(Ordering::Acquire) == 1 \{\
            let dest = GPU_BAR_ADDR.load(Ordering::Acquire) as *mut u32;\
            for i in (0..count).step_by(4) \{\
                asm!("movups xmm0, [\{src\}]", "movntps [\{dst\}], xmm0", src = in(reg) src.add(i), dst = in(reg) dest.add(i));\
            \}\
        \}\
    \}\
    pub unsafe fn clear(color: u32) \{\
        let fb = FRAMEBUFFER;\
        for i in 0..(1920 * 1080) \{ write_volatile(fb.add(i), color); \}\
    \}\
\}\
