use std::fs::OpenOptions;\
use std::io::\{Read, Write, Seek, SeekFrom\};\
\
/// EN: Uses msr-safe driver to enable RDPMC in user-space.\
/// This avoids running the entire engine as root.\
unsafe fn enable_user_pmu_via_msr_safe(cpu_id: u32) -> std::io::Result<()> \{\
    let path = format!("/dev/cpu/\{\}/msr_safe", cpu_id);\
    let mut file = OpenOptions::new()\
        .read(true)\
        .write(true)\
        .open(path)?;\
\
    // EN: IA32_PERF_FIXED_CTR_CTRL (0x38D)\
    // We write to enable Fixed Counter 1 (Instructions Retired) for Ring 3.\
    let msr_addr: u64 = 0x38D;\
    let mut value: [u8; 8] = [0; 8];\
    \
    file.seek(SeekFrom::Start(msr_addr))?;\
    file.read_exact(&mut value)?;\
    \
    let mut u_val = u64::from_le_bytes(value);\
    u_val |= 0x20; // Set bit 5 to enable Fixed Counter 1 in user-space\
    \
    file.seek(SeekFrom::Start(msr_addr))?;\
    file.write_all(&u_val.to_le_bytes())?;\
\
    Ok(())\
\}\
}