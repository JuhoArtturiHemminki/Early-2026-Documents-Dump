use std::\{mem, ptr, alloc, slice\};\
use std::sync::atomic::\{compiler_fence, Ordering, AtomicBool\};\
use rayon::prelude::*;\
use core_affinity::\{get_core_ids, set_for_current, CoreId\};\
\
#[cfg(target_arch = "x86_64")]\
use std::arch::x86_64::*;\
#[cfg(target_arch = "x86_64")]\
use dynasmrt::\{dynasm, DynasmApi, DynasmLabelApi\};\
\
#[cfg(target_arch = "aarch64")]\
use std::arch::aarch64::*;\
\
// --- AMX CONFIGURATION STRUCTURE ---\
#[repr(C, packed)]\
struct TileConfig \{\
    palette_id: u8,\
    start_row: u8,\
    reserved: [u8; 14],\
    colsb: [u16; 16],\
    rows: [u8; 16],\
\}\
\
#[cfg(target_arch = "x86_64")]\
thread_local! \{\
    static JMP_BUF: std::cell::UnsafeCell<libc::sigjmp_buf> = std::cell::UnsafeCell::new(unsafe \{ mem::zeroed() \});\
\}\
\
pub enum OperationType \{\
    LinearLogic,  // Standard XOR/AVX-512 JIT path\
    MatrixMatrix, // AMX Accelerated path\
\}\
\
pub struct AxionFabric \{\
    ptr: *mut u8,\
    size: usize,\
    layout: alloc::Layout,\
    #[cfg(target_arch = "x86_64")]\
    jit_buffer: dynasmrt::ExecutableBuffer,\
\}\
\
unsafe impl Send for AxionFabric \{\}\
unsafe impl Sync for AxionFabric \{\}\
\
impl AxionFabric \{\
    pub fn new(size: usize) -> Self \{\
        // EN: Force 64-byte alignment for AVX-512/AMX cache line efficiency.\
        let align = if cfg!(target_arch = "x86_64") \{ 2 * 1024 * 1024 \} else \{ 64 \};\
        let layout = alloc::Layout::from_size_align(size, align).expect("Invalid Layout");\
        let ptr = unsafe \{ alloc::alloc(layout) \};\
        if ptr.is_null() \{ alloc::handle_alloc_error(layout); \}\
\
        #[cfg(target_os = "linux")]\
        unsafe \{ libc::madvise(ptr as *mut _, size, libc::MADV_HUGEPAGE); \}\
\
        AxionFabric \{\
            ptr,\
            size,\
            layout,\
            #[cfg(target_arch = "x86_64")]\
            jit_buffer: Self::compile_titan_jit(),\
        \}\
    \}\
\
    #[cfg(target_arch = "x86_64")]\
    fn compile_titan_jit() -> dynasmrt::ExecutableBuffer \{\
        let mut ops = dynasmrt::x64::Assembler::new().unwrap();\
        dynasm!(ops\
            ; .arch x64\
            ; mov rcx, rsi\
            ; shr rcx, 6\
            ; jz >tail\
            ; vpxord zmm1, zmm1, zmm1\
            ; vnotpd zmm1, zmm1\
            ; align 64\
            ; loop_start:\
            ; prefetcht0 [rdi + 512]\
            ; vmovdqu64 zmm0, [rdi]\
            ; vpxorq zmm0, zmm0, zmm1\
            ; vmovntdq [rdi], zmm0 // EN: Non-temporal store to bypass cache pollution.\
            ; add rdi, 64\
            ; dec rcx\
            ; jnz <loop_start\
            ; tail:\
            ; ret\
        );\
        ops.finalize().unwrap()\
    \}\
\
    // --- NEW: XCR0 OS-CHECK FOR AMX ---\
    #[cfg(target_arch = "x86_64")]\
    unsafe fn is_amx_os_enabled() -> bool \{\
        let eax: u32;\
        let edx: u32;\
        std::arch::asm!("xgetbv", in("ecx") 0, out("eax") eax, out("edx") edx);\
        let xcr0 = ((edx as u64) << 32) | (eax as u64);\
        // EN: Check bits 17 (XTILECFG) and 18 (XTILEDATA)\
        (xcr0 & 0x60000) == 0x60000\
    \}\
\
    pub fn execute_ultimate(&mut self, op: OperationType) \{\
        let core_ids = get_core_ids().expect("CPU Topology fail");\
        let has_avx512 = is_x86_feature_detected!("avx512f");\
        let has_amx_hw = is_x86_feature_detected!("amx-tile");\
        \
        // EN: Dynamic Hardware + OS Check\
        let use_amx = has_amx_hw && matches!(op, OperationType::MatrixMatrix) && unsafe \{ Self::is_amx_os_enabled() \};\
\
        let amx_config = TileConfig \{\
            palette_id: 1, start_row: 0, reserved: [0; 14],\
            colsb: [64; 16], rows: [16; 16],\
        \};\
\
        let total_size = self.size;\
        let buf_ptr = self.ptr;\
        let l2_chunk = 256 * 1024;\
\
        #[cfg(target_arch = "x86_64")]\
        let jit_fn_ptr = self.jit_buffer.ptr(dynasmrt::AssemblyOffset(0));\
\
        (0..total_size).into_par_iter()\
            .step_by(l2_chunk)\
            .enumerate()\
            .for_each(|(idx, offset)| \{\
                let core_id = core_ids[idx % core_ids.len()];\
                set_for_current(core_id);\
                let chunk_ptr = unsafe \{ buf_ptr.add(offset) \};\
                let chunk_size = std::cmp::min(l2_chunk, total_size - offset);\
\
                unsafe \{\
                    #[cfg(target_arch = "x86_64")]\
                    \{\
                        if use_amx \{\
                            // EN: Thread-local AMX init and release to protect clock frequencies.\
                            std::arch::asm!("ldtilecfg [\{0\}]", in(reg) &amx_config);\
                            self.run_amx_accelerated_block(chunk_ptr, chunk_size);\
                            std::arch::asm!("tilerelease");\
                        \} else if has_avx512 \{\
                            self.run_x86_64_logic(chunk_ptr, chunk_size, jit_fn_ptr, core_id);\
                        \} else \{\
                            self.run_aligned_avx2(chunk_ptr, chunk_size);\
                        \}\
                    \}\
\
                    #[cfg(target_arch = "aarch64")]\
                    self.run_aarch64_logic(chunk_ptr, chunk_size);\
                \}\
            \});\
    \}\
\
    #[cfg(target_arch = "x86_64")]\
    #[target_feature(enable = "amx-tile,amx-int8")]\
    unsafe fn run_amx_accelerated_block(&self, ptr: *mut u8, len: usize) \{\
        let stride = 64;\
        let t_size = 1024;\
        if len < (t_size * 3) \{ return; \}\
        // EN: Perform Matrix Multiplication using tmm registers.\
        std::arch::asm!(\
            "tileloadd tmm0, [\{0\} + \{2\}]",\
            "tileloadd tmm1, [\{1\} + \{2\}]",\
            "tdpbusd tmm2, tmm0, tmm1",\
            "tilestored [\{3\} + \{2\}], tmm2",\
            in(reg) ptr, in(reg) ptr.add(t_size), in(reg) stride, in(reg) ptr.add(t_size * 2),\
            options(nostack)\
        );\
    \}\
\
    #[inline(always)]\
    #[target_feature(enable = "avx2")]\
    unsafe fn run_aligned_avx2(&self, ptr: *mut u8, len: usize) \{\
        let is_aligned = (ptr as usize) % 32 == 0;\
        let mut curr = ptr as *mut __m256i;\
        let mask = _mm256_set1_epi64x(-1);\
        for _ in 0..(len / 32) \{\
            if is_aligned \{\
                let data = _mm256_load_si256(curr); \
                _mm256_store_si256(curr, _mm256_xor_si256(data, mask));\
            \} else \{\
                let data = _mm256_loadu_si256(curr); \
                _mm256_storeu_si256(curr, _mm256_xor_si256(data, mask));\
            \}\
            curr = curr.add(1);\
        \}\
    \}\
\
    #[cfg(target_arch = "x86_64")]\
    unsafe fn run_x86_64_logic(&self, ptr: *mut u8, len: usize, jit_ptr: *const u8, _core: CoreId) \{\
        JMP_BUF.with(|buf| \{\
            if libc::sigsetjmp(buf.get(), 1) == 0 \{\
                let func: extern "C" fn(*mut u8, usize) = mem::transmute(jit_ptr);\
                func(ptr, len);\
            \}\
        \});\
    \}\
\
    #[cfg(target_arch = "aarch64")]\
    unsafe fn run_aarch64_logic(&self, ptr: *mut u8, len: usize) \{\
        let mut curr = ptr as *mut uint8x16_t;\
        for _ in 0..(len / 16) \{\
            vst1q_u8(curr as *mut u8, vmvnq_u8(vld1q_u8(curr as *const u8)));\
            curr = curr.add(1);\
        \}\
    \}\
\}\
