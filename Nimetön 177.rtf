\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
\
class SSOD_11_0_Efficiency_Master \{\
private:\
    const float VEHICLE_M_BASE    = 1850.0f;\
    const float TIRE_R            = 0.330f;\
    const float G_ACCEL           = 9.81f;\
    const float dt                = 0.01f;\
    const float WIND_DEADBAND_N   = 45.0f;\
    const float EFF_SWEET_SPOT_NM = 180.0f;\
\
    float estimated_mass        = 1850.0f;\
    float friction_mu           = 1.0f;\
    float brake_disk_temp       = 20.0f;\
    float brake_disk_moisture   = 0.0f;\
    float wind_load_force       = 0.0f;\
    float filtered_v            = 0.0f;\
    float error_integral        = 0.0f;\
    float last_regen_nm         = 0.0f;\
\
public:\
    struct ActuationOutput \{\
        float front_motor_nm;\
        float rear_motor_nm;\
        float brake_force_n;\
        bool abs_active;\
        bool ice_mode_active;\
        float efficiency_score;\
    \};\
\
    ActuationOutput execute_cycle(\
        float req_decel, \
        float raw_v, \
        float t_cell, \
        float current_soc, \
        float pitch_rad, \
        float wheel_slip,\
        float steering_angle_rad,\
        float yaw_rate_rads,\
        float motor_current_amps,\
        bool wiper_active,\
        bool trailer_plugged\
    ) \{\
        filtered_v = (filtered_v * 0.92f) + (raw_v * 0.08f);\
\
        if (wheel_slip > 0.03f && std::abs(last_regen_nm) > 100.0f) \{\
            friction_mu = std::clamp(friction_mu - 0.05f, 0.15f, 1.0f);\
        \} else \{\
            friction_mu = std::clamp(friction_mu + 0.001f, 0.15f, 1.0f);\
        \}\
\
        if (std::abs(motor_current_amps) > 50.0f && std::abs(filtered_v) > 2.0f) \{\
            float acceleration = (raw_v - filtered_v) / dt;\
            float force = (motor_current_amps * 400.0f * 0.95f) / TIRE_R;\
            float calc_m = force / (std::max(0.1f, std::abs(acceleration)));\
            estimated_mass = (estimated_mass * 0.999f) + (std::clamp(calc_m, 1850.0f, 4000.0f) * 0.001f);\
        \}\
        if (trailer_plugged) estimated_mass = std::max(estimated_mass, 2500.0f);\
\
        float brake_power = std::abs(last_regen_nm / TIRE_R) * filtered_v; \
        brake_disk_temp += (brake_power * 0.00001f) - (brake_disk_temp - 20.0f) * 0.001f;\
        float fade_factor = std::clamp(1.0f - (brake_disk_temp - 300.0f) / 400.0f, 0.2f, 1.0f);\
\
        float lat_g = std::abs(filtered_v * yaw_rate_rads) / G_ACCEL;\
        float stability_limit = std::sqrt(std::max(0.0f, std::pow(friction_mu, 2) - std::pow(lat_g, 2)));\
        \
        float total_ext_force = (last_regen_nm / TIRE_R) - (estimated_mass * G_ACCEL * std::sin(pitch_rad));\
        float raw_wind = ((total_ext_force / estimated_mass) - ((raw_v - filtered_v) / dt)) * estimated_mass;\
        if (std::abs(raw_wind) > WIND_DEADBAND_N) \{\
            wind_load_force = (wind_load_force * 0.98f) + (raw_wind * 0.02f);\
        \}\
\
        float target_decel = std::min(std::max(0.0f, req_decel), friction_mu * G_ACCEL * 0.8f);\
        float target_force = (target_decel * estimated_mass) - wind_load_force;\
        \
        error_integral = std::clamp(error_integral + (target_decel * dt), -2.0f, 2.0f);\
        float ideal_regen_nm = ((target_decel * 1.0f) + (error_integral * 0.2f)) * estimated_mass * TIRE_R;\
\
        if (std::abs(ideal_regen_nm - EFF_SWEET_SPOT_NM) < 15.0f && filtered_v > 8.0f) \{\
            ideal_regen_nm = EFF_SWEET_SPOT_NM; \
        \}\
\
        float cleaning_force = 0.0f;\
        if (wiper_active) \{\
            brake_disk_moisture = std::min(100.0f, brake_disk_moisture + 0.3f);\
            if (brake_disk_moisture > 40.0f && filtered_v > 15.0f) cleaning_force = 80.0f;\
        \} else \{\
            brake_disk_moisture = std::max(0.0f, brake_disk_moisture - 0.2f);\
        \}\
\
        float soc_limit = std::pow(std::clamp((100.0f - current_soc) / 10.0f, 0.0f, 1.0f), 1.5f);\
        float regen_torque = std::min(ideal_regen_nm, 4500.0f * stability_limit * soc_limit);\
        \
        float front_split = std::clamp(0.5f + (1.0f - friction_mu) * 0.2f, 0.4f, 0.7f);\
        float friction_needed = (std::max(0.0f, target_force - (regen_torque / TIRE_R)) / fade_factor) + cleaning_force;\
\
        last_regen_nm = regen_torque;\
        return \{\
            regen_torque * front_split,\
            regen_torque * (1.0f - front_split),\
            friction_needed,\
            (wheel_slip > 0.08f),\
            (friction_mu < 0.4f),\
            (regen_torque > 0) ? (1.0f - (friction_needed / (target_force + 1.0f))) : 0.0f\
        \};\
    \}\
\};\
}