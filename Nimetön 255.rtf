namespace ECU_Optimized \{\
    static inline uint32_t RotL(uint32_t x, int n) noexcept \{ return (x << n) | (x >> (32 - n)); \}\
    struct CryptoState \{ uint32_t v0, v1, v2, v3; \};\
    static inline void Permute(CryptoState& s) noexcept \{\
        s.v0 += s.v1; s.v1 = RotL(s.v1, 5); s.v1 ^= s.v0;\
        s.v0 = RotL(s.v0, 16);\
        s.v2 += s.v3; s.v3 = RotL(s.v3, 8); s.v3 ^= s.v2;\
        s.v0 += s.v3; s.v3 = RotL(s.v3, 13); s.v3 ^= s.v0;\
        s.v2 += s.v1; s.v1 = RotL(s.v1, 7); s.v1 ^= s.v2;\
        s.v2 = RotL(s.v2, 16);\
    \}\
\}\
