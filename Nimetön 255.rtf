class ECU_Core_Engine \{\
public:\
    struct Output \{\
        uint32_t rail_dac, main_inj_us, pilot_inj_us, post_inj_us;\
        bool bypass_active, launch_active, guardian_active, scr_active;\
        uint16_t dtc_code; const char *diag_msg;\
        uint32_t wdt_token;\
    \};\
    struct LogEntry \{ uint32_t cycle; int32_t rpm; uint16_t dtc; \};\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
\
private:\
    uint64_t m_cycle_count = 0;\
    int32_t m_exhaust_model = 20 * ECU_Config::FP_SCALE;\
    int32_t m_prev_rpm = 0, m_smooth_thr = 0;\
    uint8_t m_bb_idx = 0;\
    LogEntry m_blackbox[ECU_Config::BLACKBOX_SIZE];\
    bool m_bb_locked = false;\
\
    inline int32_t NVH_Filter(int32_t raw) noexcept \{\
        m_smooth_thr += (raw - m_smooth_thr) >> 3;\
        return m_smooth_thr;\
    \}\
\
public:\
    Output step(int32_t a1, int32_t a2, int32_t rpm, int32_t temp, uint32_t bat_mv) noexcept \{\
        Output out = \{0, 0, 0, 0, false, false, false, false, 0, "NOMINAL", 0\};\
        m_cycle_count++;\
\
        if (m_stack_guard != ECU_Config::STACK_MAGIC || ECU_Config::SW_CERT_ID != 0x554C54494D415445ULL) \{\
            out.bypass_active = true; out.rail_dac = 750; out.main_inj_us = 380;\
            out.dtc_code = 0x0606; out.diag_msg = "CRITICAL ECU FAILURE - BYPASS";\
            m_bb_locked = true;\
            return out;\
        \}\
\
        int32_t raw_thr = (a1 + a2) >> 1;\
        int32_t target_thr = NVH_Filter(ECU_Config::SafeClamp(raw_thr, 0, 1024));\
        m_exhaust_model += (target_thr / 12) - (m_exhaust_model / 180);\
        bool cold_engine = (temp < 60 * ECU_Config::FP_SCALE);\
        \
        if (cold_engine) target_thr = (target_thr * 700) >> 10;\
\
        uint32_t v_corr = ECU_Config::GetVoltageOffset(bat_mv);\
        out.pilot_inj_us = cold_engine ? (ECU_Config::PILOT_INJ_US + 40) : ECU_Config::PILOT_INJ_US;\
        out.main_inj_us = ((target_thr * ECU_Config::TQ_TO_RAIL_COEFF) >> 10) + v_corr;\
        out.post_inj_us = (m_exhaust_model > 700 * ECU_Config::FP_SCALE) ? ECU_Config::POST_INJ_US : 0;\
\
        int32_t rail_press = (target_thr * 2) + 450 * ECU_Config::FP_SCALE;\
        if (rpm > 4000) rail_press += 200 * ECU_Config::FP_SCALE;\
        out.rail_dac = ECU_Config::SafeClamp<uint32_t>((static_cast<uint64_t>(rail_press) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL, 0, 4095);\
\
        if (m_exhaust_model > ECU_Config::EXHAUST_LIMIT || rpm > 6500) \{\
            out.guardian_active = true; out.main_inj_us >>= 1;\
            out.dtc_code = 0x0217; out.diag_msg = "SAFETY LIMIT ACTIVE";\
            m_bb_locked = true;\
        \}\
\
        if (!m_bb_locked) \{\
            m_blackbox[m_bb_idx % ECU_Config::BLACKBOX_SIZE] = \{ (uint32_t)m_cycle_count, rpm, out.dtc_code \};\
            m_bb_idx++;\
        \}\
\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ static_cast<uint32_t>(m_cycle_count);\
        return out;\
    \}\
\};\
