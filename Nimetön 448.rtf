    fn calculate_ncd(&self, s1: &str, s2: &str) -> f32 \{\
        let b1 = s1.as_bytes();\
        let b2 = s2.as_bytes();\
        let dict_lock = self.global_zstd_dict.read().unwrap();\
        let (c1, c2, c_combined) = if let Some(ref dict_bytes) = *dict_lock \{\
            let enc = EncoderDictionary::copy(dict_bytes, 1);\
            let mut c1_buf = Vec::new();\
            zstd::stream::copy_encode_dict(b1, &mut c1_buf, 1, &enc).unwrap();\
            let mut c2_buf = Vec::new();\
            zstd::stream::copy_encode_dict(b2, &mut c2_buf, 1, &enc).unwrap();\
            let mut combined = b1.to_vec();\
            combined.extend_from_slice(b2);\
            let mut cc_buf = Vec::new();\
            zstd::stream::copy_encode_dict(&combined[..], &mut cc_buf, 1, &enc).unwrap();\
            (c1_buf.len() as f32, c2_buf.len() as f32, cc_buf.len() as f32)\
        \} else \{\
            let c1 = encode_all(b1, 1).unwrap().len() as f32;\
            let c2 = encode_all(b2, 1).unwrap().len() as f32;\
            let mut combined = b1.to_vec();\
            combined.extend_from_slice(b2);\
            let c_combined = encode_all(&combined[..], 1).unwrap().len() as f32;\
            (c1, c2, c_combined)\
        \};\
        (c_combined - c1.min(c2)) / c1.max(c2)\
    \}\
