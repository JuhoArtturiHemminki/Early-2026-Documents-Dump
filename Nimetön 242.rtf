namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    static constexpr int32_t MAX_SAFE_RAIL    = 2600 * FP_SCALE;\
    static constexpr int32_t THERMAL_CRITICAL = 110 * FP_SCALE;\
    static constexpr int32_t THERMAL_HYST     = 5 * FP_SCALE;\
