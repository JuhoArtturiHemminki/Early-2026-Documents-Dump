    template<typename T> static constexpr T SafeClamp(T val, T min_v, T max_v) \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
    template<typename T> static constexpr T SafeAbs(T v) \{ return (v < 0) ? -v : v; \}\
    static inline uint32_t RotL(uint32_t x, int n) \{ return (x << n) | (x >> (32 - n)); \}\
\}\
