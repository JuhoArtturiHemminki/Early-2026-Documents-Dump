class ECU_V16_Hybrid \{\
public:\
    struct Output \{\
        uint32_t rail_dac, injector_us;\
        int32_t timing_advance_us;\
        uint16_t aggression_pct;\
        bool guardian_active, cold_limit_active, fault, bypass_active;\
        uint32_t wdt_token;\
        int32_t service_est_km;\
        const char *fault_msg, *diag_code;\
    \};\
    volatile uint32_t m_stack_guard = ECU_Config::STACK_MAGIC;\
private:\
    KalmanFilter thr_filt\{15, 512\}, rpm_filt\{10, 204\};\
    std::atomic<int32_t> m_adaptive_trim\{0\};\
    int32_t m_last_thr = 0, m_aggression = 0, m_resonance_buffer = 0;\
    uint64_t m_cycle_count = 0;\
    bool m_thermal_cut_active = false;\
    inline void Fast_Security_Step(Output& out, int32_t tq) \{\
        uint64_t sig = ECU_Optimized::Sign_Atomic(static_cast<uint32_t>(tq), out.wdt_token, 0x1F3F2E1D);\
        out.wdt_token ^= static_cast<uint32_t>(sig >> 16);\
    \}\
public:\
    Output step(int32_t apps1, int32_t apps2, int32_t rpm, int32_t temp, int32_t boost) \{\
        Output out = \{0, 0, 0, 0, false, false, false, false, 0, 30000, "OK", "000"\};\
        m_cycle_count++;\
        if (m_stack_guard != ECU_Config::STACK_MAGIC) \{ out.fault = true; out.diag_code = "STK-ERR"; return out; \}\
        if (ECU_Config::SafeAbs(apps1 - apps2) > ECU_Config::APPS_MAX_AGING) \{ out.fault = true; out.diag_code = "APPS-ERR"; return out; \}\
        int32_t t_f = thr_filt.update(ECU_Config::SafeClamp((apps1 + apps2) >> 1, 0, 1024));\
        int32_t r_f = rpm_filt.update(rpm);\
        m_aggression = ECU_Config::SafeClamp(((m_aggression * 1000) + (ECU_Config::SafeAbs(t_f - m_last_thr) * 24)) >> 10, 0, 1024);\
        m_last_thr = t_f;\
        m_resonance_buffer += (t_f - m_resonance_buffer) * ECU_Config::SMOOTHING_GAIN / 1024;\
        int32_t final_tq = (static_cast<int64_t>(m_resonance_buffer) * 640) >> 10;\
        if (temp > ECU_Config::THERMAL_CRITICAL) m_thermal_cut_active = true;\
        else if (temp < (ECU_Config::THERMAL_CRITICAL - ECU_Config::THERMAL_HYST)) m_thermal_cut_active = false;\
        if (m_thermal_cut_active) final_tq >>= 1;\
        int32_t rail = ECU_Config::SafeClamp((450 * ECU_Config::FP_SCALE) + (final_tq * 4) + m_adaptive_trim.load(), 0, ECU_Config::MAX_SAFE_RAIL);\
        out.rail_dac = (static_cast<uint64_t>(rail) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL;\
        out.injector_us = ECU_Config::SafeClamp(static_cast<uint32_t>(ECU_Config::BASE_INJECTOR_US + (rail / 2048)), ECU_Config::BASE_INJECTOR_US, ECU_Config::MAX_INJECTOR_US);\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ (static_cast<uint32_t>(m_cycle_count) * 0x1F3F);\
        Fast_Security_Step(out, final_tq);\
        return out;\
    \}\
\};\
