namespace ECU_Config \{\
    // Fixed-point arithmetic: 10-bit fractional precision (1/1024)\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1));\
    \
    // Safety boundaries for structural integrity and high-RPM power\
    static constexpr int32_t MAX_SAFE_RAIL      = 2800 * FP_SCALE;\
    static constexpr int32_t EXHAUST_LIMIT      = 820 * FP_SCALE;\
    static constexpr int32_t THERMAL_HYSTERESIS = 50 * FP_SCALE; // Prevents thermal shock oscillation\
    static constexpr int32_t TURBO_RPM_MAX_BASE = 195000;\
    \
    // Combustion refinement parameters (Multi-stage injection)\
    static constexpr uint32_t PILOT_INJ_US      = 120U; // Pre-injection for NVH reduction\
    static constexpr uint32_t POST_INJ_US       = 80U;  // Post-injection for emission control\
    static constexpr uint32_t DAC_MAX           = 4095U;\
    static constexpr uint32_t STACK_MAGIC       = 0xDEADBEEF; // Memory stack guard magic number\
    static constexpr uint64_t SW_CERT_ID        = 0x554C54494D415445ULL; // Software authenticity ID\
    static constexpr uint32_t WDT_KICK_MAGIC    = 0xA5A5A5A5; // Watchdog reset constant\
    \
    // System limits and counts\
    static constexpr uint8_t  BLACKBOX_SIZE     = 100;\
    static constexpr uint8_t  CYLINDER_COUNT    = 4;\
    static constexpr int32_t  TQ_TO_RAIL_COEFF  = 640;\
\
    // Safety-certified clamping to prevent arithmetic overflow/underflow\
    template<typename T> static constexpr T SafeClamp(T val, T min_v, T max_v) noexcept \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
\}\
\
class ECU_Core_Engine \{\
public:\
    struct Output \{\
        uint32_t rail_dac, main_inj_us[ECU_Config::CYLINDER_COUNT];\
        uint32_t pilot_inj_us, post_inj_us;\
        bool bypass_active, guardian_active, anti_jerk_active, knock_detected;\
        uint16_t dtc_code; const char *diag_msg;\
        uint32_t wdt_token;\
    \};\
\
private:\
    uint64_t m_cycle_count = 0;\
    int32_t m_exhaust_model = 20 * ECU_Config::FP_SCALE;\
    int32_t m_smooth_thr = 0, m_prev_target_tq = 0, m_prev_rpm = 0;\
    int32_t m_zqc_offset[ECU_Config::CYLINDER_COUNT] = \{0, 2, -1, 1\}; // Zero Quantity Calibration\
    int32_t m_anti_jerk_buffer = 0;\
    bool m_thermal_lock = false;\
    \
    struct LogEntry \{ uint32_t cycle; int32_t rpm; uint16_t dtc; \} m_blackbox[ECU_Config::BLACKBOX_SIZE];\
    uint8_t m_bb_idx = 0;\
    bool m_bb_locked = false;\
\
    // Active Anti-Jerk: Eliminates drivetrain oscillations by counter-phasing torque requests\
    inline int32_t ApplyAntiJerk(int32_t current_tq, int32_t rpm_delta) noexcept \{\
        int32_t correction = (rpm_delta * 12) >> 4; \
        m_anti_jerk_buffer = (m_anti_jerk_buffer * 7 + correction) >> 3;\
        return current_tq - m_anti_jerk_buffer;\
    \}\
\
    // Dashpot: Softens fuel cut transitions to ensure luxurious drivability\
    inline int32_t ApplyDashpot(int32_t target, int32_t prev) noexcept \{\
        if (target < prev - 50) return prev - 15;\
        return target;\
    \}\
\
    // Electromagnetic Compensation: Adjusts injector opening delay based on rail pressure and voltage\
    inline uint32_t GetInjectorLatency(uint32_t rail_dac, uint32_t bat_mv) noexcept \{\
        uint32_t v_latency = (bat_mv < 12000) ? 150 : 80;\
        uint32_t p_latency = (rail_dac * 50) / 4096; \
        return v_latency + p_latency;\
    \}\
\
    // Chemical Density Compensation: Adjusts injection period for fuel temperature and viscosity\
    inline int32_t GetFuelDensityCorr(int32_t fuel_temp) noexcept \{\
        if (fuel_temp < 20 * ECU_Config::FP_SCALE) return -20;\
        if (fuel_temp > 60 * ECU_Config::FP_SCALE) return 35;\
        return 0;\
    \}\
\
public:\
    /**\
     * @brief Deterministic control loop (Hyper-Apex).\
     * Calculates precision fuel and pressure commands for safety-critical hardware.\
     */\
    Output step(int32_t a1, int32_t a2, int32_t rpm, int32_t eng_temp, int32_t fuel_temp, uint32_t bat_mv, int32_t ambient_hpa, bool knock_sensor, bool aux_load) noexcept \{\
        Output out = \{0, \{0\}, 0, 0, false, false, false, false, 0, "SYSTEM NOMINAL", 0\};\
        m_cycle_count++;\
\
        // HARDWARE BYPASS: Triggered by memory corruption or certification mismatch\
        if (*(volatile uint32_t*)&ECU_Config::STACK_MAGIC != 0xDEADBEEF || ECU_Config::SW_CERT_ID != 0x554C54494D415445ULL) \{\
            out.bypass_active = true; out.rail_dac = 750;\
            for(int i=0; i<ECU_Config::CYLINDER_COUNT; ++i) out.main_inj_us[i] = 400;\
            out.dtc_code = 0x0606; out.diag_msg = "CRITICAL DATA CORRUPTION - EMERGENCY BYPASS ACTIVE";\
            m_bb_locked = true; // Lock log for investigation\
            return out;\
        \}\
\
        // Altitude Compensation: Dynamic turbocharger RPM limiting based on ambient air pressure\
        int32_t alt_factor = ECU_Config::SafeClamp(ambient_hpa, 600, 1013);\
        int32_t dynamic_turbo_max = (ECU_Config::TURBO_RPM_MAX_BASE * alt_factor) / 1013;\
\
        // Adaptive Idle Stability: Pre-emptive torque increase for auxiliary loads (AC/Steering)\
        int32_t raw_thr = (a1 + a2) >> 1;\
        if (aux_load && rpm < 1000) raw_thr += 50; \
        \
        // NVH Smoothing Filter: Digital signal processing to eliminate pedal noise\
        m_smooth_thr += (ECU_Config::SafeClamp(raw_thr, 0, 1024) - m_smooth_thr) >> 3;\
        \
        int32_t rpm_delta = rpm - m_prev_rpm;\
        int32_t target_tq = (static_cast<int64_t>(m_smooth_thr) * ECU_Config::TQ_TO_RAIL_COEFF) >> 10;\
        \
        // Apply Luxury Drive refinements\
        target_tq = ApplyDashpot(target_tq, m_prev_target_tq);\
        target_tq = ApplyAntiJerk(target_tq, rpm_delta);\
        \
        // Thermal Modeling with Hysteresis (Prevents metal fatigue from rapid temp fluctuations)\
        m_exhaust_model += (target_tq / 40) - (m_exhaust_model / 180);\
        if (m_exhaust_model > ECU_Config::EXHAUST_LIMIT) m_thermal_lock = true;\
        if (m_thermal_lock && m_exhaust_model < (ECU_Config::EXHAUST_LIMIT - ECU_Config::THERMAL_HYSTERESIS)) m_thermal_lock = false;\
\
        // Cold engine derating: Protects lubricated components until optimal temp reached\
        if (eng_temp < 60 * ECU_Config::FP_SCALE) target_tq = (target_tq * 700) >> 10;\
\
        // Precision Rail Pressure Calculation\
        int32_t rail_press = (target_tq * 3) + 450 * ECU_Config::FP_SCALE;\
        out.rail_dac = ECU_Config::SafeClamp<uint32_t>((static_cast<uint64_t>(rail_press) * ECU_Config::DAC_MAX) / ECU_Config::MAX_SAFE_RAIL, 0, 4095);\
\
        // Sub-microsecond Injection Logic (Density and Magnetic Compensation)\
        uint32_t latency = GetInjectorLatency(out.rail_dac, bat_mv);\
        int32_t density_corr = GetFuelDensityCorr(fuel_temp);\
        out.knock_detected = knock_sensor;\
        int32_t knock_retard = out.knock_detected ? 180 : 0;\
\
        out.pilot_inj_us = (rpm < 3500) ? ECU_Config::PILOT_INJ_US : 0;\
        for(int i=0; i < ECU_Config::CYLINDER_COUNT; ++i) \{\
            // Individual Cylinder Balancing (ZQC) + Error Compensations\
            out.main_inj_us[i] = ECU_Config::SafeClamp<int32_t>(target_tq + latency + m_zqc_offset[i] + density_corr - knock_retard, 0, 4500);\
        \}\
\
        // Safe Emission Regen Logic: Only allowed when oil temp and load are stable\
        out.post_inj_us = (m_exhaust_model > 700 * ECU_Config::FP_SCALE && eng_temp > 75 * ECU_Config::FP_SCALE && rpm > 1800) ? ECU_Config::POST_INJ_US : 0;\
