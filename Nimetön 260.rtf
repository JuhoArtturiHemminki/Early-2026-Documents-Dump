        // Safety Guardian: Real-time mitigation for Thermal, Turbo RPM, or Combustion Knock\
        if (m_thermal_lock || (target_tq * 180) > dynamic_turbo_max || out.knock_detected) \{\
            out.guardian_active = true;\
            for(int i=0; i<ECU_Config::CYLINDER_COUNT; ++i) out.main_inj_us[i] >>= 1; // 50% Safe Power Cut\
            out.dtc_code = out.knock_detected ? 0x0325 : 0x0217;\
            out.diag_msg = out.knock_detected ? "DETONATION RISK - POWER LIMIT IMPOSED" : "THERMAL LIMIT EXCEEDED - COOLING REQUIRED";\
            m_bb_locked = true;\
        \}\
\
        // Forensic Black Box: Cyclical buffer logging for pre-fault investigation\
        if (!m_bb_locked) \{\
            m_blackbox[m_bb_idx % ECU_Config::BLACKBOX_SIZE] = \{ static_cast<uint32_t>(m_cycle_count), rpm, out.dtc_code \};\
            m_bb_idx++;\
        \}\
\
        // Finalize Cycle: Store states and generate cryptographic token\
        m_prev_rpm = rpm; m_prev_target_tq = target_tq;\
        out.wdt_token = ECU_Config::WDT_KICK_MAGIC ^ static_cast<uint32_t>(m_cycle_count);\
        return out;\
    \}\
\};\
