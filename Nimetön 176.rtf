\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
\
class SSOD_11_0_Efficiency_Master \{\
private:\
    const float VEHICLE_M_BASE  = 1850.0f;\
    const float TIRE_R          = 0.330f;\
    const float dt              = 0.01f;\
\
    // --- ENERGIAN OPTIMOINTI ---\
    const float WIND_DEADBAND_N = 45.0f;  // Ei korjata pient\'e4 tuulta (turha s\'e4\'e4tely sy\'f6 s\'e4hk\'f6\'e4)\
    const float EFF_SWEET_SPOT_NM = 180.0f; // Moottorin optimaalinen regen-v\'e4\'e4nt\'f6\
    \
    float wind_load_force       = 0.0f;\
    float filtered_v            = 0.0f;\
    float brake_disk_moisture   = 0.0f;\
\
public:\
    struct ActuationOutput \{\
        float motor_torque_nm;\
        float brake_force_n;\
        float efficiency_score; // Diagnostiikka: kuinka hyvin energia saadaan talteen\
    \};\
\
    ActuationOutput execute_optimized_cycle(\
        float req_decel, \
        float raw_v, \
        float pitch_rad, \
        float motor_torque_actual,\
        float imu_accel_x,\
        bool wiper_active\
    ) \{\
        filtered_v = (filtered_v * 0.92f) + (raw_v * 0.08f);\
        float velocity_kph = filtered_v * 3.6f;\
\
        // 1. \'c4LYK\'c4S TUULIKOMPENSOINTI (Deadband-optimointi)\
        float total_external_force = (motor_torque_actual / TIRE_R) - (VEHICLE_M_BASE * 9.81f * std::sin(pitch_rad));\
        float accel_diff = (total_external_force / VEHICLE_M_BASE) - imu_accel_x;\
        float raw_wind_force = accel_diff * VEHICLE_M_BASE;\
\
        // Optimointi: \'c4l\'e4 korjaa pient\'e4 tuulta, jotta invertteri ei "hytky" (pienempi kytkent\'e4h\'e4vi\'f6)\
        if (std::abs(raw_wind_force) > WIND_DEADBAND_N) \{\
            wind_load_force = (wind_load_force * 0.98f) + (raw_wind_force * 0.02f);\
        \}\
\
        // 2. REGENERAATION HY\'d6TYSUHDE-OPTIMOINTI (Wh/km s\'e4\'e4st\'f6)\
        float target_force = (req_decel * VEHICLE_M_BASE) - wind_load_force;\
        float ideal_regen_nm = target_force * TIRE_R;\
        \
        // Hienos\'e4\'e4t\'f6: Jos olemme l\'e4hell\'e4 optimaalista v\'e4\'e4nt\'f6\'e4, suositaan sit\'e4 \
        // pienell\'e4 hidastuvuuden joustolla (0.02 m/s2 virhe sallitaan energian takia)\
        if (std::abs(ideal_regen_nm - EFF_SWEET_SPOT_NM) < 15.0f && velocity_kph > 30.0f) \{\
            ideal_regen_nm = EFF_SWEET_SPOT_NM; \
        \}\
\
        // 3. BRAKE DRYING (S\'e4\'e4st\'f6tila)\
        float cleaning_force = 0.0f;\
        if (wiper_active) \{\
            brake_disk_moisture = std::min(100.0f, brake_disk_moisture + 0.3f);\
            // Vain jos nopeus on riitt\'e4v\'e4 ja vesi oikeasti haittaa\
            if (brake_disk_moisture > 40.0f && filtered_v > 15.0f) \{\
                cleaning_force = 80.0f; // Laskettu 150N -> 80N s\'e4\'e4st\'f6n takia\
            \}\
        \} else \{\
            brake_disk_moisture = std::max(0.0f, brake_disk_moisture - 0.2f);\
        \}\
\
        // 4. LOPULLINEN JAKO\
        float final_regen_nm = std::clamp(ideal_regen_nm, 0.0f, 4800.0f);\
        float friction_needed = std::max(0.0f, target_force - (final_regen_nm / TIRE_R)) + cleaning_force;\
\
        // Hy\'f6tysuhdeindeksi (0.0 - 1.0)\
        float eff_score = (final_regen_nm > 0) ? (1.0f - (friction_needed / (target_force + 1.0f))) : 0.0f;\
\
        return \{ final_regen_nm, friction_needed, eff_score \};\
    \}\
\};\
}