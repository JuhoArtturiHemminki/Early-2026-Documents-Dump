    // ISR-Safe Lock-free FIFO Manager for mission-critical CAN traffic\
    class TX_FIFO_Manager \{\
    private:\
        CAN_Frame m_buffer[ECU_Config::CAN_FIFO_SIZE];\
        std::atomic<uint8_t> m_head\{0\}, m_tail\{0\}, m_count\{0\};\
    public:\
        bool Push(const CAN_Frame& f, bool prio) noexcept \{\
            if (m_count.load() >= ECU_Config::CAN_FIFO_SIZE) \{\
                if (!prio) return false;\
                m_tail.store((m_tail.load() + 1) % ECU_Config::CAN_FIFO_SIZE);\
                m_count.fetch_sub(1);\
            \}\
            m_buffer[m_head.load() % ECU_Config::CAN_FIFO_SIZE] = f;\
            m_head.store((m_head.load() + 1) % ECU_Config::CAN_FIFO_SIZE, std::memory_order_release);\
            m_count.fetch_add(1, std::memory_order_acq_rel);\
            return true;\
        \}\
        bool Pop(CAN_Frame& f) noexcept \{\
            if (m_count.load(std::memory_order_acquire) == 0) return false;\
            f = m_buffer[m_tail.load() % ECU_Config::CAN_FIFO_SIZE];\
            m_tail.store((m_tail.load() + 1) % ECU_Config::CAN_FIFO_SIZE, std::memory_order_release);\
            m_count.fetch_sub(1, std::memory_order_acq_rel);\
            return true;\
        \}\
    \};\
