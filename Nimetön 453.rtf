            let mut out = content;\
            if *self.pure_immersion.read().unwrap() \{\
                out = out.replace("muisti", "ajatukset").replace("tieto", "viisaus");\
            \}\
            format!("\{\} (Tarkkuus: \{:.4\}) [\{:?\}]", out, conf, start.elapsed())\
