    pub fn resonance_ncd(&self, s1: &str, s2: &str) -> f32 \{\
        let b1 = s1.as_bytes();\
        let b2 = s2.as_bytes();\
        let drift = (s1.len() as f32 % PHI) / 10.0;\
        let anchor = R_UNIV * (1.0 - (L_FI_BASE + drift));\
        \
        let c1 = encode_all(b1, 1).unwrap().len() as f32;\
        let c2 = encode_all(b2, 1).unwrap().len() as f32;\
        let mut comb = b1.to_vec(); comb.extend_from_slice(b2);\
        let cc = encode_all(&comb[..], 1).unwrap().len() as f32;\
        \
        ((cc - c1.min(c2)) / c1.max(c2)) * (1.0 + (anchor * 0.1))\
    \}\
