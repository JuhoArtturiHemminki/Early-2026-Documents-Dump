    fn safe_inference(&self, key: &str, depth: u8, mut seen: HashSet<String>, conf: f32) -> Option<(String, f32)> \{\
        if depth == 0 || conf < 0.05 \{ return None; \}\
        seen.insert(key.to_string());\
\
        let fact = self.get_fact(key)?;\
        let mut out = fact.content.clone();\
        \
        if let Some(links) = self.semantic_graph.read().unwrap().get(key) \{\
            let mut targets = links.clone();\
            targets.sort_by(|a, b| a.len().cmp(&b.len()));\
            for n in targets.iter().take(3) \{\
                if !seen.contains(n) \{\
                    if let Some((nc, _)) = self.safe_inference(n, depth - 1, seen.clone(), conf * 0.95) \{\
                        out = format!("\{\} \'95 \{\}", out, nc);\
                    \}\
                \}\
            \}\
        \}\
        Some((out, conf))\
    \}\
\
    fn get_fact(&self, key: &str) -> Option<Fact> \{\
        if let Some(c) = self.lru_cache.write().unwrap().get(key) \{ return Some(c.clone()); \}\
        let db = self.db_conn.read().unwrap();\
        db.query_row("SELECT data FROM vault WHERE id = ?1", params![key], |r| \{\
            let b: Vec<u8> = r.get(0)?;\
            Ok(serde_json::from_slice(&decode_all(&b[..]).unwrap()).unwrap())\
        \}).ok()\
    \}\
\
    pub fn learn(&self, id: &str, info: &str, parent: Option<String>) \{\
        let f = Fact \{\
            content: info.into(), confidence: 1.0,\
            timestamp: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs(),\
            parent: parent.clone(),\
        \};\
        let key = id.to_lowercase();\
        if let Some(p) = parent \{\
            let mut g = self.semantic_graph.write().unwrap();\
            g.entry(p.to_lowercase()).or_default().push(key.clone());\
            g.entry(key.clone()).or_default().push(p.to_lowercase());\
        \}\
        let _ = self.tx_buffer.send((key, f));\
    \}\
\}\
