\f0\fs24 \cf0 use strsim::normalized_levenshtein; // Lis\'e4\'e4: cargo add strsim\
\
fn reflect(&self, input: &str) -> String \{\
    let input_low = input.to_lowercase();\
    \
    // 1. Yritet\'e4\'e4n ensin tarkkaa osumaa\
    let mut stmt = self.conn.prepare("SELECT response FROM brain WHERE keyword = ?").unwrap();\
    let mut rows = stmt.query(params![input_low]).unwrap();\
\
    if let Some(row) = rows.next().unwrap() \{\
        return row.get(0).unwrap();\
    \}\
\
    // 2. Jos ei l\'f6ydy, haetaan kaikki avainsanat ja lasketaan l\'e4hin veikkaus\
    let mut stmt = self.conn.prepare("SELECT keyword, response FROM brain").unwrap();\
    let brain_map = stmt.query_map([], |row| \{\
        Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?))\
    \}).unwrap();\
\
    let mut best_match: Option<(String, String)> = None;\
    let mut highest_similarity = 0.0;\
\
    for entry in brain_map \{\
        let (kw, res) = entry.unwrap();\
        let similarity = normalized_levenshtein(&input_low, &kw);\
        \
        if similarity > highest_similarity && similarity > 0.4 \{ // 40% t\'e4sm\'e4\'e4vyys riitt\'e4\'e4 veikkaukseen\
            highest_similarity = similarity;\
            best_match = Some((kw, res));\
        \}\
    \}\
\
    if let Some((kw, res)) = best_match \{\
        format!("\\x1b[33m(Veikkaus: '\{\}' \{:.0\}%)\\x1b[0m -> \{\}", kw, highest_similarity * 100.0, res)\
    \} else \{\
        format!("Tietoa '\{\}' ei l\'f6ydy. K\'e4yt\'e4 'opeta: \{\} = vastaus'.", input, input)\
    \}\
\}\
}