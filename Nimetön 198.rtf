/**\
 * @brief Lightweight Fixed-Point Kalman Filter\
 */\
class KalmanFilter \{\
private:\
    int32_t x, p, q, r;\
public:\
    KalmanFilter(int32_t initial_q, int32_t initial_r) \
        : x(0), p(ECU_Config::FP_SCALE), q(initial_q), r(initial_r) \{\}\
\
    int32_t update(int32_t measurement) \{\
        p = p + q;\
        int32_t k = (static_cast<int64_t>(p) * ECU_Config::FP_SCALE) / (p + r);\
        x = x + ((static_cast<int64_t>(k) * (measurement - x)) >> ECU_Config::FP_SHIFT);\
        p = ((static_cast<int64_t>(ECU_Config::FP_SCALE - k) * p) >> ECU_Config::FP_SHIFT);\
        return x;\
    \}\
\};\
\
/**\
 * @brief Durability & Performance Logic (SSOD)\
 */\
class DurabilityModule \{\
public:\
    struct EfficiencyVector \{\
        int32_t fuel_mult;\
        int32_t rail_offset;\
        int32_t timing_advance_us;\
        int32_t torque_limit_factor;\
        bool cold_limit_active;\
    \};\
\
    static EfficiencyVector GetOptimization(int32_t throttle_f, int32_t rpm_f, int32_t temp) \{\
        EfficiencyVector ev = \{ ECU_Config::FP_SCALE, 0, 0, ECU_Config::FP_SCALE, false \};\
\
        if (temp < ECU_Config::TEMP_COLD_THRESHOLD) \{\
            ev.cold_limit_active = true;\
            ev.fuel_mult = ECU_Config::ToFixed(0.90);\
            ev.torque_limit_factor = ECU_Config::ToFixed(0.70);\
            ev.rail_offset = -100 * ECU_Config::FP_SCALE;\
        \} \
        else \{\
            if (rpm_f < 1500) \{ ev.torque_limit_factor = ECU_Config::ToFixed(0.90); \}\
            if (throttle_f > 400) \{\
                ev.rail_offset = 120 * ECU_Config::FP_SCALE; \
                ev.timing_advance_us = 45; \
                ev.fuel_mult = ECU_Config::ToFixed(1.18); \
            \}\
        \}\
        return ev;\
    \}\
\};\
\
class DieselECU \{\
private:\
    KalmanFilter throttle_filter\{ECU_Config::ToFixed(0.015), ECU_Config::ToFixed(0.5)\};\
    KalmanFilter rpm_filter\{ECU_Config::ToFixed(0.01), ECU_Config::ToFixed(0.2)\};\
\
    struct CalibrationData \{\
        int32_t fuel_map[4][4];\
        uint32_t checksum;\
    \} m_cal;\
\
    // --- ANTI-TAMPER VALIDATION ---\
    bool ValidateCertification() const noexcept \{\
        // In real ECU, this checks the entire flash memory hash against MASTER_CHECKSUM\
        return (ECU_Config::SW_CERT_ID == 0x554C54494D415445ULL);\
    \}\
\
    int32_t interpolate_fuel(int32_t rpm, int32_t throttle) const noexcept \{\
        return ECU_Config::ToFixed(48.0) + (rpm / 120);\
    \}\
\
public:\
    DieselECU() \{\
        for(int i=0; i<4; ++i) for(int j=0; j<4; ++j) \
            m_cal.fuel_map[i][j] = ECU_Config::ToFixed(45.0 + i*5);\
        m_cal.checksum = ECU_Config::MASTER_CHECKSUM;\
    \}\
\
    struct Output \{\
        uint32_t rail_dac;\
        uint32_t injector_us;\
        int32_t timing_advance;\
        bool protection_active;\
        bool cold_limit_active;\
        bool tamper_detected;\
    \};\
\
    Output run_iteration(int32_t throttle_raw, int32_t rpm_raw, int32_t coolant_temp) \{\
        Output out = \{0, 0, 0, false, false, false\};\
\
        // 1. INTEGRITY CHECK (Anti-Tamper)\
        if (!ValidateCertification()) \{\
            out.tamper_detected = true;\
            return out; // ECU LOCKDOWN\
        \}\
\
        // 2. SIGNAL PROCESSING (Kalman)\
        int32_t throttle_f = throttle_filter.update(throttle_raw);\
        int32_t rpm_f = rpm_filter.update(rpm_raw);\
\
        // 3. OPTIMIZATION & COLD START\
        auto opt = DurabilityModule::GetOptimization(throttle_f, rpm_f, coolant_temp);\
        out.cold_limit_active = opt.cold_limit_active;\
\
        int32_t base_req = interpolate_fuel(rpm_f, throttle_f);\
\
        // 4. POWER CALCULATION\
        int64_t req_calc = (static_cast<int64_t>(base_req) * opt.fuel_mult) >> ECU_Config::FP_SHIFT;\
        req_calc = (req_calc * opt.torque_limit_factor) >> ECU_Config::FP_SHIFT;\
        int32_t final_req = static_cast<int32_t>(std::clamp<int64_t>(req_calc + opt.rail_offset, 0, ECU_Config::MAX_RAIL_PRESSURE));\
\
        // 5. THERMAL PROTECTION\
        if (coolant_temp > ECU_Config::TEMP_OPTIMAL_START) \{\
            int32_t heat_stress = (coolant_temp - ECU_Config::TEMP_OPTIMAL_START) / 2;\
            int32_t safety_factor = std::max(0, ECU_Config::FP_SCALE - heat_stress);\
            final_req = (static_cast<int64_t>(final_req) * safety_factor) >> ECU_Config::FP_SHIFT;\
            out.protection_active = (safety_factor < ECU_Config::FP_SCALE);\
        \}\
\
        // 6. OUTPUTS\
        out.rail_dac = (static_cast<uint64_t>(final_req) * ECU_Config::DAC_RESOLUTION) / ECU_Config::MAX_RAIL_PRESSURE;\
        out.injector_us = ECU_Config::MIN_INJECTOR_US + (final_req / ECU_Config::INJECTOR_SCALE_DIV);\
        out.timing_advance = opt.timing_advance_us;\
\
        return out;\
    \}\
\};\
\
int main() \{\
