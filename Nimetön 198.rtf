namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    \
    // Safety & Physical Limits\
    static constexpr int32_t MAX_RAIL_PRESSURE = 2400 * FP_SCALE;\
    static constexpr int32_t TEMP_OPTIMAL_START = 85 * FP_SCALE;\
    static constexpr int32_t TEMP_CRITICAL = 102 * FP_SCALE;\
    static constexpr int32_t TEMP_COLD_THRESHOLD = 60 * FP_SCALE;\
    \
    // Hardware Constants\
    static constexpr uint32_t DAC_RESOLUTION = 4095U;\
    static constexpr uint32_t MIN_INJECTOR_US = 250U;\
    static constexpr uint32_t INJECTOR_SCALE_DIV = 2U;\
    static constexpr uint32_t CAN_CRC_POLY = 0x04C11DB7U;\
\
    // --- CERTIFICATION BLOCK ---\
    // Unique Hardware-Software Lock ID\
    static constexpr uint64_t SW_CERT_ID = 0x554C54494D415445ULL; // "ULTIMATE"\
    static constexpr uint32_t MASTER_CHECKSUM = 0xAF42B109U;     // Validated V15.1 Hash\
    // ----------------------------\
\
    constexpr int32_t ToFixed(double x) \{ return static_cast<int32_t>(x * static_cast<double>(FP_SCALE)); \}\
\}\
