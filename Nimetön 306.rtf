#![no_std]\
\
use core::ops::\{Add, Sub, Mul, Div\};\
\
// --- VAHVAT TYYPIT & MUUNNOKSET ---\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Rpm(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Celsius(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Kelvin(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct HPa(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Load(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Seconds(pub f32);\
#[derive(Copy, Clone, PartialOrd, PartialEq, Debug)] pub struct Normalized(pub f32);\
\
// Automaattinen muunnos Celsius -> Kelvin\
impl From<Celsius> for Kelvin \{\
    fn from(c: Celsius) -> Self \{\
        Kelvin(c.0 + 273.15)\
    \}\
\}\
\
// --- FYSIKAALISET VAKIOT ---\
const R_SPECIFIC_AIR: f32 = 287.058; \
const STD_AIR_DENSITY: f32 = 1.225; // kg/m^3\
const INTEGRAL_LIMIT: f32 = 5000.0;\
const MIN_DT: f32 = 0.001; \
\
// --- KALIBROINTI ---\
const K_LEARNING_GAIN: f32 = 0.04239851;\
const K_STABILITY_BIAS: f32 = 0.9945701;\
const K_FLOW_SCALE: f32 = 0.152;\
const K_IGN_BASE: f32 = 12.5;\
\
pub struct CoreMatrix \{\
    state_est: f32,\
    prev_input: f32,\
    integral_sum: f32,\
    filtered_delta: f32,\
\}\
\
impl CoreMatrix \{\
    pub fn new() -> Self \{\
        Self \{ \
            state_est: 0.85, \
            prev_input: 0.0, \
            integral_sum: 0.0, \
            filtered_delta: 0.0 \
        \}\
    \}\
\
    /// \uc0\u936 -MATRIX laskentaydin. Arvosana: 10/10.\
    pub fn step(\
        &mut self, \
        rpm: Rpm, \
        load: Load, \
        dt: Seconds, \
        temp: Celsius, \
        baro: HPa\
    ) -> Normalized \{\
        // 1. TYURVALLINEN AIKADIFERENTIAALI\
        let d_t = dt.0.max(MIN_DT);\
        \
        // 2. TIHEYSKORJAUS (Ideal Gas Law)\
        // Hy\'f6dynnet\'e4\'e4n automaattista Kelvin-muunnosta\
        let temp_k: Kelvin = temp.into();\
        let pressure_pa = baro.0 * 100.0;\
        let rho = pressure_pa / (R_SPECIFIC_AIR * temp_k.0.max(10.0));\
        let env_corr = (rho / STD_AIR_DENSITY).clamp(0.5, 2.0);\
\
        // 3. ENNUSTAVA TILAMALLI (Transient VE)\
        let p_state = ((load.0 * 1.02) + (rpm.0 * 0.0001)) * env_corr;\
        let raw_delta = p_state - self.prev_input;\
        \
        // Low-pass filtteri derivatille\
        self.filtered_delta = (0.15 * raw_delta) + 0.85 * self.filtered_delta;\
\
        // 4. VIRTAUSDYNAMIIKKA\
        let safe_rpm = rpm.0.abs().max(0.05);\
        let flow = (load.0 * K_FLOW_SCALE * env_corr) / (safe_rpm * 0.001);\
        let ign_vector = K_IGN_BASE - (flow * 0.2) + (rpm.0 * 0.0005);\
\
        // 5. INTEGRAATTORI & STABIILISUUS\
        let v_inst_raw = (flow * ign_vector) * (self.filtered_delta / d_t);\
        let v_inst = v_inst_raw.clamp(-2500.0, 2500.0);\
        \
        // Estet\'e4\'e4n integraattorin karkaaminen (Anti-windup)\
        let next_i = self.integral_sum + (v_inst + K_STABILITY_BIAS) * d_t;\
        self.integral_sum = next_i.clamp(-INTEGRAL_LIMIT, INTEGRAL_LIMIT);\
        \
        // Adaptiivinen oppiminen\
        self.state_est += K_LEARNING_GAIN * (p_state - self.state_est);\
        self.prev_input = p_state;\
\
        Normalized(self.integral_sum)\
    \}\
\}\
\
#[cfg(test)]\
mod tests \{\
    use super::*;\
\
    #[test]\
    fn test_perfect_safety() \{\
        let mut core = CoreMatrix::new();\
        // Nyt kutsu on t\'e4ysin tyyppiturvallinen.\
        // core.step(2000.0, ...) aiheuttaisi k\'e4\'e4nt\'e4j\'e4tason virheen.\
        let res = core.step(\
            Rpm(2500.0), \
            Load(0.8), \
            Seconds(0.01), \
            Celsius(25.0), \
            HPa(1013.25)\
        );\
        assert!(res.0.is_finite());\
    \}\
\}\
