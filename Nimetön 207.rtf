\f0\fs24 \cf0 /**\
 * @file ECU_Industrial_Ultimate_V15_6_MASTER.cpp\
 * @version 15.6 (THE MASTER RELEASE - ALL FEATURES INTEGRATED)\
 * @brief Combines ASIL-D Filters, Rounding Precision, and ASIL-B Dynamic Harmony.\
 */\
\
#include <cstdint>\
\
namespace ECU_Config \{\
    static constexpr int32_t FP_SHIFT = 10;\
    static constexpr int32_t FP_SCALE = (1 << FP_SHIFT);\
    static constexpr int32_t FP_ROUND = (1 << (FP_SHIFT - 1)); // Corrects bit-shift drift\
    \
    static constexpr int32_t ABSOLUTE_MAX_RAIL = 2500 * FP_SCALE;\
    static constexpr int32_t CRITICAL_TEMP = 105 * FP_SCALE;\
    static constexpr uint32_t DAC_MAX = 4095U;\
    static constexpr uint32_t BASE_INJECTOR_US = 250U;\
\
    static constexpr uint64_t SW_CERT_ID = 0x554C54494D415445ULL;\
    static constexpr uint32_t MASTER_HASH = 0xAF42B109U;\
\
    template<typename T>\
    static constexpr T SafeClamp(T val, T min_v, T max_v) \{\
        return (val < min_v) ? min_v : ((val > max_v) ? max_v : val);\
    \}\
\}\
\
class KalmanFilter \{\
private:\
    int32_t x, p, q, r;\
public:\
    constexpr KalmanFilter(int32_t init_q, int32_t init_r) \
        : x(0), p(ECU_Config::FP_SCALE), q(init_q), r(init_r) \{\}\
\
    int32_t update(int32_t measurement) \{\
        p = p + q;\
        int32_t k = (static_cast<int64_t>(p) << ECU_Config::FP_SHIFT) / (p + r);\
        x = x + ((static_cast<int64_t>(k) * (measurement - x) + ECU_Config::FP_ROUND) >> ECU_Config::FP_SHIFT);\
        p = ((static_cast<int64_t>(ECU_Config::FP_SCALE - k) * p + ECU_Config::FP_ROUND) >> ECU_Config::FP_SHIFT);\
        return x;\
    \}\
\};\
\
class DieselECU \{\
public:\
    struct Output \{\
        uint32_t rail_dac;\
        uint32_t injector_us;\
        bool guardian_active;\
        bool integrity_fail;\
    \};\
\
private:\
    KalmanFilter throttle_filt\{15, 512\};\
    KalmanFilter rpm_filt\{10, 204\};\
    int32_t adaptive_trim = 0;\
\
    bool IsCoreIntact() const \{\
        return (ECU_Config::SW_CERT_ID == 0x554C54494D415445ULL) && \
               (ECU_Config::MASTER_HASH == 0xAF42B109U);\
    \}\
\
public:\
    Output process(int32_t thr_raw, int32_t rpm_raw, int32_t temp) \{\
        Output out = \{0, 0, false, false\};\
\
        if (!IsCoreIntact()) \{\
            out.integrity_fail = true;\
            return out;\
        \}\
\
        // Apply ASIL-D Noise Filtering (Back in the master version)\
        int32_t t_f = throttle_filt.update(thr_raw);\
        int32_t r_f = rpm_filt.update(rpm_raw);\
\
        // ASIL-B Dynamic Computation\
        int32_t dynamic_req = (t_f * 2) + (r_f / 120) + adaptive_trim;\
\
        if (temp > 80 * ECU_Config::FP_SCALE && temp < 95 * ECU_Config::FP_SCALE) \{\
            if (t_f > 600 && adaptive_trim < 50) adaptive_trim++;\
        \}\
\
        // ASIL-D Guardian Monitoring\
        int32_t final_req = dynamic_req;\
        if (temp > ECU_Config::CRITICAL_TEMP) \{\
            final_req = (dynamic_req * 32) >> 7; \
            out.guardian_active = true;\
        \}\
\
        final_req = ECU_Config::SafeClamp(final_req, 0, ECU_Config::ABSOLUTE_MAX_RAIL);\
        \
        out.rail_dac = (static_cast<uint64_t>(final_req) * ECU_Config::DAC_MAX) / ECU_Config::ABSOLUTE_MAX_RAIL;\
        out.injector_us = ECU_Config::BASE_INJECTOR_US + (final_req / 2);\
\
        return out;\
    \}\
\};\
\
