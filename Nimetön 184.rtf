\f0\fs24 \cf0 #include <algorithm>\
#include <cmath>\
#include <atomic>\
#include <cstdint>\
\
class SSOD_11_4_HW4 \{\
private:\
    std::atomic<float> VEHICLE_M\{1850.0f\};\
    std::atomic<float> dynamic_Cd\{0.23f\};\
    \
    const float TIRE_R          = 0.330f;\
    const float SLEW_RATE_MAX   = 4500.0f;\
    const float Kp              = 0.85f; \
    const float Ki              = 0.15f; \
    const float EFF_SWEET_SPOT  = 180.0f;\
    const float WIND_DEADBAND   = 45.0f;\
    \
    float error_integral        = 0.0f;\
    float last_regen_nm         = 0.0f;\
    float wind_load_force       = 0.0f;\
    float brake_disk_moisture   = 0.0f;\
    const float dt              = 0.01f;\
\
    const float MAX_ACCEL_PLAUSIBLE = 12.0f;\
    const float MAX_V_DELTA         = 5.0f;\
    const float GEAR_RATIO          = 9.03f; \
    float last_verified_v           = 0.0f;\
\
    float learning_rate         = 0.0001f; \
    const float MIN_M           = 1500.0f; \
    const float MAX_M           = 2800.0f; \
\
public:\
    enum HW4_Fault_Mask : uint32_t \{\
        NONE = 0,\
        RPM_INCONSISTENT = 1 << 0,\
        SENSOR_SATURATION = 1 << 1,\
        MODEL_DEGRADED = 1 << 2,\
        ADAPTIVE_LIMIT_REACHED = 1 << 3\
    \};\
\
    struct ActuationOutput \{\
        float motor_torque_nm;\
        float friction_brake_n;\
        bool abs_active;\
        float efficiency_index; \
        uint32_t fault_code; \
        float learned_mass;  \
        float learned_cd;    \
    \};\
\
    void learn_vehicle_parameters(float actual_accel, float v, float torque_nm, float pitch_rad) \{\
        if (v < 5.0f || std::abs(actual_accel) < 0.1f) return; \
\
        double current_f_motor = (double)torque_nm / TIRE_R;\
        double current_m = (double)VEHICLE_M.load();\
        double gravity_f = current_m * 9.81 * std::sin((double)pitch_rad);\
        double aero_f = 0.5 * 1.225 * std::pow((double)v, 2) * ((double)dynamic_Cd.load() * 2.22);\
        \
        double predicted_accel = (current_f_motor - gravity_f - aero_f) / current_m;\
        double accel_error = (double)actual_accel - predicted_accel;\
\
        if (std::abs(torque_nm) > 100.0f) \{ \
            float new_m = VEHICLE_M.load() + (float)(accel_error * learning_rate * 50.0);\
            VEHICLE_M.store(std::clamp(new_m, MIN_M, MAX_M));\
        \}\
\
        if (v > 22.0f) \{ \
            float new_cd = dynamic_Cd.load() - (float)(accel_error * learning_rate * 0.1);\
            dynamic_Cd.store(std::clamp(new_cd, 0.20f, 0.45f));\
        \}\
    \}\
\
    ActuationOutput execute_shielded_cycle(\
        float req_decel, float raw_v, float t_cell, \
        float pitch_rad, float imu_accel_x, float wheel_slip,\
        bool wiper_active, float motor_rpm\
    ) \{\
        uint32_t current_faults = HW4_Fault_Mask::NONE;\
        learn_vehicle_parameters(imu_accel_x, raw_v, last_regen_nm, pitch_rad);\
\
        float v_from_rpm = (motor_rpm / 60.0f) * (2.0f * M_PI * TIRE_R) / GEAR_RATIO;\
        \
        if (std::abs(raw_v - v_from_rpm) > (std::abs(raw_v) * 0.10f + 1.0f)) \{\
            current_faults |= HW4_Fault_Mask::RPM_INCONSISTENT;\
            raw_v = v_from_rpm; \
        \}\
\
        if (std::isnan(raw_v) || std::abs(raw_v - last_verified_v) > MAX_V_DELTA) \{\
            current_faults |= HW4_Fault_Mask::MODEL_DEGRADED;\
            imu_accel_x = 0.0f;\
        \}\
\
        if (std::abs(imu_accel_x) > MAX_ACCEL_PLAUSIBLE) \{\
            current_faults |= HW4_Fault_Mask::SENSOR_SATURATION;\
            imu_accel_x = 0.0f;\
        \}\
        \
        last_verified_v = raw_v;\
\
        float air_temp_k = std::clamp(t_cell + 273.15f, 233.15f, 323.15f);\
        float rho = 1.225f * (288.15f / air_temp_k); \
        float gravity_force = VEHICLE_M.load() * 9.81f * std::sin(pitch_rad);\
        float aero_force_est = 0.5f * rho * std::pow(std::max(0.0f, raw_v), 2) * (dynamic_Cd.load() * 2.22f);\
\
        float current_f_motor = last_regen_nm / TIRE_R;\
        float accel_diff = (current_f_motor / VEHICLE_M.load()) - imu_accel_x;\
        float real_wind_force = (accel_diff * VEHICLE_M.load()) - gravity_force - aero_force_est;\
\
        if (!(current_faults & MODEL_DEGRADED) && std::abs(real_wind_force) > WIND_DEADBAND) \{\
            wind_load_force = (wind_load_force * 0.95f) + (real_wind_force * 0.05f);\
        \}\
\
        float target_net_decel = std::max(0.0f, req_decel - ((aero_force_est + wind_load_force + gravity_force) / VEHICLE_M.load()));\
        \
        if (raw_v > 0.1f) \{\
            error_integral = std::clamp(error_integral + (target_net_decel * dt), -2.0f, 2.0f);\
        \}\
\
        float smooth_target_f = (target_net_decel * Kp) + (error_integral * Ki);\
        float ideal_regen_nm = smooth_target_f * VEHICLE_M.load() * TIRE_R;\
\
        if (std::abs(ideal_regen_nm - EFF_SWEET_SPOT) < 12.0f && raw_v > 8.0f) \{\
            ideal_regen_nm = EFF_SWEET_SPOT;\
        \}\
\
        float safety_scalar = 1.0f;\
        bool abs_active = false;\
        if (wheel_slip > 0.12f) \{\
            abs_active = true;\
            safety_scalar = std::max(0.0f, 1.0f - (wheel_slip - 0.12f) * 10.0f);\
        \}\
\
        float limited_regen = std::clamp(ideal_regen_nm * safety_scalar, \
                                         last_regen_nm - (SLEW_RATE_MAX * dt), \
                                         last_regen_nm + (SLEW_RATE_MAX * dt));\
        \
        if (wiper_active) brake_disk_moisture = std::min(100.0f, brake_disk_moisture + 0.2f);\
        else brake_disk_moisture = std::max(0.0f, brake_disk_moisture - 0.1f);\
        \
        float friction_n = std::max(0.0f, (target_net_decel * VEHICLE_M.load()) - (limited_regen / TIRE_R));\
        if (brake_disk_moisture > 50.0f) friction_n += 75.0f;\
\
        last_regen_nm = limited_regen;\
\
        return \{ \
            limited_regen, \
            friction_n, \
            abs_active, \
            (limited_regen / (ideal_regen_nm + 0.001f)),\
            current_faults,\
            VEHICLE_M.load(),\
            dynamic_Cd.load()\
        \};\
    \}\
\};\
}