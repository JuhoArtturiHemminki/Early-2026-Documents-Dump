\
const R_UNIV: f32 = 0.46692016; \
const L_FI_BASE: f32 = 0.12531415;\
const PHI: f32 = 1.6180339;\
const RAM_RATIO: f64 = 0.10; \
const NCD_BASE_THRESHOLD: f32 = 0.35; \
const GC_INTERVAL_SECS: u64 = 300;\
\
#[derive(Clone, Debug, Serialize, Deserialize)]\
pub struct Fact \{\
    pub content: String,\
    pub confidence: f32,\
    pub timestamp: u64,\
    pub parent: Option<String>,\
\}\
\
pub struct OmniCorePulse \{\
    pub lru_cache: Arc<RwLock<LruCache<String, Fact>>>,\
    pub db_conn: Arc<RwLock<Connection>>,\
    pub tx_buffer: SyncSender<(String, Fact)>,\
    pub semantic_graph: Arc<RwLock<HashMap<String, Vec<String>>>>,\
    pub ram_limit: u64,\
    pub last_responses: Arc<RwLock<Vec<String>>>,\
\}\
\
impl OmniCorePulse \{\
    pub fn new(path: &str) -> Result<Self> \{\
        let mut sys = System::new_all();\
        sys.refresh_memory();\
        let ram_kb = (sys.total_memory() as f64 * RAM_RATIO) as u64;\
        let conn = Connection::open(path)?;\
        conn.pragma_update(None, "journal_mode", "WAL")?;\
        conn.execute("CREATE TABLE IF NOT EXISTS vault (id TEXT PRIMARY KEY, data BLOB, ts INTEGER, conf REAL)", [])?;\
        \
        let (tx, rx) = sync_channel::<(String, Fact)>(5000);\
        let p_copy = path.to_string();\
        \
        thread::spawn(move || \{\
            let db = Connection::open(p_copy).unwrap();\
            let mut last_gc = Instant::now();\
            while let Ok((id, f)) = rx.recv() \{\
                let bin = encode_all(&serde_json::to_vec(&f).unwrap()[..], 3).unwrap();\
                let _ = db.execute("INSERT OR REPLACE INTO vault (id, data, ts, conf) VALUES (?1, ?2, ?3, ?4)", params![id, bin, f.timestamp, f.confidence]);\
                \
                if last_gc.elapsed().as_secs() > GC_INTERVAL_SECS \{\
                    let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs();\
                    let _ = db.execute("DELETE FROM vault WHERE conf < 0.2 AND ts < ?1", params![now - GC_INTERVAL_SECS]);\
                    last_gc = Instant::now();\
                \}\
            \}\
        \});\
\
        Ok(Self \{\
            lru_cache: Arc::new(RwLock::new(LruCache::new(NonZeroUsize::new(5000).unwrap()))),\
            db_conn: Arc::new(RwLock::new(conn)),\
            tx_buffer: tx,\
            semantic_graph: Arc::new(RwLock::new(HashMap::new())),\
            ram_limit: ram_kb,\
            last_responses: Arc::new(RwLock::new(Vec::new())),\
        \})\
    \}\
\
    pub fn resonance_ncd(&self, s1: &str, s2: &str) -> f32 \{\
        if s1 == s2 \{ return 0.0; \}\
        let b1 = s1.as_bytes(); let b2 = s2.as_bytes();\
        let drift = (s1.len() as f32 % PHI) / 10.0;\
        let anchor = R_UNIV * (1.0 - (L_FI_BASE + drift));\
        let c1 = encode_all(b1, 1).unwrap().len() as f32;\
        let c2 = encode_all(b2, 1).unwrap().len() as f32;\
        let mut comb = b1.to_vec(); comb.extend_from_slice(b2);\
        let cc = encode_all(&comb[..], 1).unwrap().len() as f32;\
        ((cc - c1.min(c2)) / c1.max(c2)) * (1.0 + (anchor * 0.1))\
    \}\
\
    fn generate_ngrams(&self, words: &[&str]) -> Vec<String> \{\
        let mut ngrams = Vec::new();\
        for i in 0..words.len() \{\
            ngrams.push(words[i].to_string());\
            if i + 1 < words.len() \{ ngrams.push(format!("\{\} \{\}", words[i], words[i+1])); \}\
            if i + 2 < words.len() \{ ngrams.push(format!("\{\} \{\} \{\}", words[i], words[i+1], words[i+2])); \}\
        \}\
        ngrams\
    \}\
\
    pub fn process(&self, input: &str) -> String \{\
        let start = Instant::now();\
        let is_query = input.contains('?');\
        let clean: String = input.chars().filter(|c| c.is_alphanumeric() || c.is_whitespace()).collect();\
        let low = clean.to_lowercase();\
        let trimmed = low.trim();\
        if trimmed.len() < 2 \{ return "Resonanssi liian matala.".into(); \}\
        \
        let stop_words = ["on", "ja", "se", "oli", "mutta", "vai", "et", "jo", "nyt", "onko", "t\'e4ll\'e4", "kyll\'e4", "niin"];\
        let words: Vec<&str> = trimmed.split_whitespace().filter(|s| !stop_words.contains(s)).collect();\
        let ngrams = self.generate_ngrams(&words);\
        \
        let mut vastaukset = Vec::new();\
        let mut found_keys = Vec::new();\
        \
        \{\
            let graph = self.semantic_graph.read().unwrap();\
            let last = self.last_responses.read().unwrap();\
            let dynamic_threshold = NCD_BASE_THRESHOLD + (graph.len() as f32 / 15000.0).min(0.2);\
\
            for unit in ngrams \{\
                if graph.contains_key(&unit) \{\
                    found_keys.push(unit);\
                    continue;\
                \}\
                let mut best_key = None;\
                let mut best_score = dynamic_threshold;\
                for avain in graph.keys() \{\
                    let score = self.resonance_ncd(&unit, avain);\
                    let penalty = if last.iter().any(|r| r.contains(avain)) \{ 0.7 \} else \{ 0.0 \};\
                    if score + penalty < best_score \{\
                        best_score = score + penalty;\
                        best_key = Some(avain.clone());\
                    \}\
                \}\
                if let Some(k) = best_key \{ found_keys.push(k); \}\
            \}\
        \}\
\
        for k in found_keys \{\
            if let Some(f) = self.get_fact(&k) \{ vastaukset.push(f.content); \}\
        \}\
\
        if vastaukset.is_empty() \{\
            if is_query \{ return format!("Tiedon haku ep\'e4onnistui. [\{:?\}]", start.elapsed()); \}\
            self.learn(trimmed, &format!("Havaittu konsepti: \{\}", trimmed), Some("alku".into()), 0.1);\
            return format!("Analysoitu ja tallennettu havainto. [\{:?\}]", start.elapsed());\
        \}\
\
        vastaukset.dedup();\
        let mut res = vastaukset.join(" ");\
        if is_query \{ res = format!("Vastaus: \{\}", res); \}\
        \{\
            let mut last = self.last_responses.write().unwrap();\
            if last.len() > 10 \{ last.remove(0); \}\
            last.push(res.clone());\
        \}\
        format!("\{\} [\{:?\}]", res, start.elapsed())\
    \}\
\
    fn get_fact(&self, key: &str) -> Option<Fact> \{\
        if let Some(c) = self.lru_cache.write().unwrap().get(key) \{ return Some(c.clone()); \}\
        let db = self.db_conn.read().unwrap();\
        db.query_row("SELECT data FROM vault WHERE id = ?1", params![key], |r| \{\
            let b: Vec<u8> = r.get(0)?;\
            Ok(serde_json::from_slice::<Fact>(&decode_all(&b[..]).unwrap()).unwrap())\
        \}).ok()\
    \}\
\
    pub fn learn(&self, id: &str, info: &str, parent: Option<String>, conf: f32) \{\
        let f = Fact \{ content: info.into(), confidence: conf, timestamp: SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs(), parent: parent.clone() \};\
        let key = id.to_lowercase();\
        \{\
            let mut g = self.semantic_graph.write().unwrap();\
            if let Some(p) = &parent \{\
                let pk = p.to_lowercase();\
                g.entry(pk.clone()).or_default().push(key.clone());\
                g.entry(key.clone()).or_default().push(pk);\
            \} else \{\
                g.entry(key.clone()).or_default();\
            \}\
        \}\
        self.lru_cache.write().unwrap().put(key.clone(), f.clone());\
        let _ = self.tx_buffer.send((key, f));\
    \}\
\}\
