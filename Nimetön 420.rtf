3. main.rs\
T\'e4m\'e4 koodi sis\'e4lt\'e4\'e4 
\f2\b Call Counterin
\f0\b0  ja vaihtaa lennosta "kylm\'e4n" tulkin "kuumaan" optimoituun koodiin:\
\
rust\
\pard\pardeftab720\partightenfactor0

\f1\fs26 \cf0 use cranelift::prelude::*;\
use cranelift_jit::\{JITBuilder, JITModule\};\
use cranelift_module::\{Linkage, Module\};\
use std::mem;\
\
struct JITEngine \{\
    module: JITModule,\
\}\
\
impl JITEngine \{\
    fn new(opt_level: settings::OptLevel) -> Self \{\
        let mut flag_builder = settings::builder();\
        flag_builder.set("opt_level", opt_level.to_string().as_str()).unwrap();\
        let isa = cranelift_native::builder().unwrap().finish(settings::Flags::new(flag_builder)).unwrap();\
        let builder = JITBuilder::with_isa(isa, cranelift_module::default_libcall_names());\
        Self \{ module: JITModule::new(builder) \}\
    \}\
\
    fn compile(&mut self, speed_mode: bool) -> *const u8 \{\
        let mut ctx = self.module.make_context();\
        let mut func_ctx = FunctionBuilderContext::new();\
        let mut sig = self.module.make_signature();\
        sig.returns.push(AbiParam::new(types::I64));\
        \
        let name = if speed_mode \{ "hot_func" \} else \{ "cold_func" \};\
        let func_id = self.module.declare_function(name, Linkage::Export, &sig).unwrap();\
        ctx.func.signature = sig;\
\
        let mut b = FunctionBuilder::new(&mut ctx.func, &mut func_ctx);\
        let block = b.create_block();\
        b.switch_to_block(block);\
        b.seal_block(block);\
\
        // Demo-logiikka: mov rax, 100\
        let val = b.ins().iconst(types::I64, 100);\
        b.ins().return_(&[val]);\
        \
        b.finalize();\
        self.module.define_function(func_id, &mut ctx).unwrap();\
        self.module.finalize_definitions().unwrap();\
        self.module.get_finalized_function(func_id)\
    \}\
\}\
\
fn main() \{\
    let mut call_count = 0;\
    let threshold = 5;\
    \
    // 1. Aloitetaan "Cold" -moodilla (Nopea k\'e4\'e4nt\'e4\'e4, hidas ajaa)\
    let mut engine = JITEngine::new(settings::OptLevel::None);\
    let mut func_ptr = engine.compile(false);\
    \
    println!("--- OmniEngine Ultra: Tiered JIT ---");\
    \
    loop \{\
        let f: fn() -> i64 = unsafe \{ mem::transmute(func_ptr) \};\
        let res = f();\
        call_count += 1;\
        \
        println!("Execution #\{\} | Result: \{\} | Mode: \{\}", \
                 call_count, res, if call_count > threshold \{ "HOT (Optimized)" \} else \{ "COLD" \});\
\
        // 2. Adaptive Optimization: Kun kynnys ylittyy, vaihdetaan "Hot" -moodiin\
        if call_count == threshold \{\
            println!("[PROFILER] Threshold reached! Re-compiling with Speed optimizations...");\
            // Luodaan uusi moottori muistivuotojen v\'e4ltt\'e4miseksi (vanha vapautuu kun 'engine' kuluu)\
            engine = JITEngine::new(settings::OptLevel::Speed);\
            func_ptr = engine.compile(true);\
        \}\
\
        if call_count >= 10 \{ break; \}\
        std::thread::sleep(std::time::Duration::from_millis(500));\
    \}\
\}\
