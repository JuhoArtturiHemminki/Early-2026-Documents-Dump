 * V-AXION-512: THE ASCENDED TITAN (v. 27.0.0 - AMX DYNAMIC)\
 * --------------------------------------------------------\
 * NEW: AMX_AUTO_SENSE - Dynaaminen aktivointi ja automaattinen tilerelease.\
 * NO DELETIONS: Kaikki alkuper\'e4inen logiikka s\'e4ilytetty.\
 */\
\
// ... (Pidet\'e4\'e4n kaikki aiemmat importit: mem, ptr, alloc, slice, jne.)\
\
pub struct AxionFabric \{\
    ptr: *mut u8,\
    size: usize,\
    layout: alloc::Layout,\
    #[cfg(target_arch = "x86_64")]\
    jit_buffer: dynasmrt::ExecutableBuffer,\
    // NEW: Tila-indikaattori AMX-yksik\'f6lle\
    amx_active: std::sync::atomic::AtomicBool, \
\}\
\
impl AxionFabric \{\
    // ... (Pidet\'e4\'e4n new() ja compile_titan_jit() ennallaan)\
\
    pub fn execute_ultimate(&mut self, operation_type: OperationType) \{\
        let core_ids = get_core_ids().expect("CPU Topology fail");\
        let has_avx512 = is_x86_feature_detected!("avx512f");\
        let has_amx = is_x86_feature_detected!("amx-tile");\
        let total_size = self.size;\
        let buf_ptr = self.ptr;\
\
        // --- DYNAMIC AMX SENSING ---\
        // Aktivoi AMX vain, jos operaatio on MATRIISI ja rauta tukee sit\'e4.\
        let should_use_amx = has_amx && matches!(operation_type, OperationType::MatrixMatrix);\
\
        if should_use_amx \{\
            unsafe \{ self.init_amx_tiles(); \}\
            self.amx_active.store(true, Ordering::SeqCst);\
        \}\
\
        let l2_chunk = 256 * 1024;\
\
        (0..total_size).into_par_iter()\
            .step_by(l2_chunk)\
            .enumerate()\
            .for_each(|(idx, offset)| \{\
                // ... (Core affinity logiikka s\'e4ilyy ennallaan)\
\
                unsafe \{\
                    #[cfg(target_arch = "x86_64")]\
                    \{\
                        if should_use_amx \{\
                            // NEW: AMX-pohjainen kiihdytys (Matrix-Matrix)\
                            self.run_amx_accelerated_block(chunk_ptr, chunk_size);\
                        \} else if has_avx512 \{\
                            // ALKUPER\'c4INEN: AVX-512 JIT (XOR/Logic)\
                            self.run_x86_64_logic(chunk_ptr, chunk_size, jit_fn_ptr, core_id);\
                        \} else \{\
                            self.run_aligned_avx2(chunk_ptr, chunk_size);\
                        \}\
                    \}\
                    // ... (AArch64 ja Fallback s\'e4ilyv\'e4t ennallaan)\
                \}\
            \});\
\
        // --- AUTOMATIC FREQUENCY PROTECTION ---\
        // Vapautetaan AMX heti, jotta CPU-kellot eiv\'e4t laske pysyv\'e4sti.\
        if self.amx_active.load(Ordering::SeqCst) \{\
            unsafe \{ self.release_amx_tiles(); \}\
            self.amx_active.store(false, Ordering::SeqCst);\
        \}\
    \}\
\
    #[cfg(target_arch = "x86_64")]\
    #[target_feature(enable = "amx-tile,amx-int8")]\
    unsafe fn run_amx_accelerated_block(&self, ptr: *mut u8, len: usize) \{\
        // T\'e4ss\'e4 toteutetaan dynaaminen AMX-laattojen lataus.\
        // Esimerkkin\'e4 int8-matriisinkerto (Tile Multiplication).\
        // K\'e4ytet\'e4\'e4n ldtilecfg-konfiguraatiota, joka ladattiin init_amx_tiles-vaiheessa.\
        \
        std::arch::asm!(\
            "tileloadd tmm0, [\{0\} + \{1\}]",\
            "tileloadd tmm1, [\{0\} + \{1\} + 1024]",\
            "tdpbusd tmm2, tmm0, tmm1", // Varsinainen AMX-laskenta\
            "tilestored [\{0\} + \{1\}], tmm2",\
            in(reg) ptr,\
            in(reg) 0, // Offset\
            options(nostack)\
        );\
    \}\
\}\
\
// Uusi tyyppim\'e4\'e4ritys dynaamista valintaa varten\
pub enum OperationType \{\
    LinearLogic,  // Alkuper\'e4inen XOR/AVX-512\
    MatrixMatrix, // Uusi AMX-kiihdytetty\
\}\
}